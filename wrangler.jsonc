{
  "name": "themiracleregister",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": true
  },
  "previews": {
    "kv_namespaces": [
      {
        "binding": "SESSION",
        "id": "ed2296f2a9394f188b026c51a5a97f45"
      }
    ],
    "images": {
      "binding": "IMAGES"
    },
    "ratelimits": [
      {
        "name": "API_RATE_LIMITER",
        "namespace_id": "16001",
        "simple": { "limit": 60, "period": 60 }
      },
      {
        "name": "SEARCH_RATE_LIMITER",
        "namespace_id": "16002",
        "simple": { "limit": 30, "period": 60 }
      },
      {
        "name": "PAGE_RATE_LIMITER",
        "namespace_id": "16003",
        "simple": { "limit": 120, "period": 60 }
      }
    ]
  },
  // Limits are per Cloudflare location and eventually consistent. Period must be 10 or 60.
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "16001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "16002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "PAGE_RATE_LIMITER",
      "namespace_id": "16003",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
