---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Admin — The Miracle Register</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        font-family: system-ui, sans-serif;
        max-width: 1400px;
        margin: 0 auto;
        padding: 1rem 1.5rem 3rem;
        color: #1a1a1a;
        line-height: 1.5;
        font-size: 0.95rem;
      }
      nav {
        border-bottom: 1px solid #ddd;
        padding-bottom: 0.75rem;
        margin-bottom: 2rem;
        display: flex;
        gap: 1.5rem;
        align-items: baseline;
      }
      nav .site-title { font-weight: bold; margin-right: auto; font-size: 0.95rem; }
      nav .admin-badge { background: #dc2626; color: white; font-size: 0.65rem; padding: 0.15rem 0.4rem; border-radius: 3px; text-transform: uppercase; letter-spacing: 0.05em; vertical-align: middle; }
      nav a { text-decoration: none; color: #555; font-size: 0.9rem; }
      nav a:hover { color: #000; }
      h1 { font-size: 1.5rem; margin-bottom: 0.5rem; }
      h2 { font-size: 1.1rem; margin-top: 2rem; margin-bottom: 0.75rem; }
      a { color: #2a5db0; }
      table { border-collapse: collapse; width: 100%; font-size: 0.875rem; }
      th { text-align: left; border-bottom: 2px solid #ddd; padding: 0.4rem 0.75rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #666; }
      td { border-bottom: 1px solid #eee; padding: 0.5rem 0.75rem; vertical-align: middle; }
      tr:last-child td { border-bottom: none; }
      .badge { display: inline-block; font-size: 0.7rem; padding: 0.15rem 0.4rem; border-radius: 3px; background: #e8f0fe; color: #2a5db0; }
      .badge-green { background: #dcfce7; color: #166534; }
      .badge-red { background: #fee2e2; color: #991b1b; }
      form { max-width: 100%; }
      fieldset { border: 1px solid #ddd; border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; min-width: 0; width: 100%; }
      legend { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #666; padding: 0 0.4rem; }
      .field { margin-bottom: 1rem; }
      .field:last-child { margin-bottom: 0; }
      label { display: block; font-size: 0.8rem; font-weight: 600; color: #444; margin-bottom: 0.3rem; }
      input[type="text"], input[type="date"], input[type="number"], input[type="url"],
      select, textarea {
        width: 100%;
        padding: 0.4rem 0.6rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 0.9rem;
        font-family: inherit;
        background: white;
      }
      input[type="text"]:focus, input[type="date"]:focus, input[type="number"]:focus,
      input[type="url"]:focus, select:focus, textarea:focus {
        outline: 2px solid #2a5db0;
        outline-offset: 1px;
        border-color: #2a5db0;
      }
      textarea { resize: vertical; min-height: 100px; font-size: 1rem; line-height: 1.6; }
      .hint { font-size: 0.75rem; color: #888; margin-top: 0.2rem; }
      .checkbox-group { display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .checkbox-group label { display: inline-flex; align-items: center; gap: 0.3rem; font-weight: normal; font-size: 0.8rem; color: #333; background: #f5f5f5; border: 1px solid #ddd; border-radius: 3px; padding: 0.2rem 0.5rem; cursor: pointer; }
      .checkbox-group label:has(input:checked) { background: #e8f0fe; border-color: #2a5db0; color: #2a5db0; }
      .checkbox-group input[type="checkbox"] { width: auto; }
      .form-actions { display: flex; gap: 1rem; align-items: center; margin-top: 1.5rem; position: sticky; bottom: 0; background: white; padding: 0.75rem 0; border-top: 1px solid #ddd; z-index: 10; }
      .btn { display: inline-block; padding: 0.5rem 1.25rem; border-radius: 4px; font-size: 0.9rem; font-family: inherit; cursor: pointer; border: none; text-decoration: none; }
      .btn-primary { background: #2a5db0; color: white; }
      .btn-primary:hover { background: #1e4a8a; }
      .btn-secondary { background: #f5f5f5; color: #333; border: 1px solid #ccc; }
      .btn-secondary:hover { background: #eee; }
      .error { background: #fee2e2; border: 1px solid #fca5a5; border-radius: 4px; padding: 0.75rem 1rem; margin-bottom: 1.5rem; font-size: 0.875rem; color: #991b1b; }
      .success { background: #dcfce7; border: 1px solid #86efac; border-radius: 4px; padding: 0.75rem 1rem; margin-bottom: 1.5rem; font-size: 0.875rem; color: #166534; }
      .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    </style>
  </head>
  <body>
    <nav>
      <span class="site-title">The Miracle Register <span class="admin-badge">Admin</span></span>
      <a href="/admin">Dashboard</a>
      <a href="/admin/saints">Saints</a>
      <a href="/admin/miracles">Miracles</a>
      <a href="/" target="_blank">View Site</a>
      <form method="post" action="/admin/logout" style="margin:0">
        <button type="submit" style="background:none;border:none;cursor:pointer;color:#555;font-size:0.9rem;padding:0">Logout</button>
      </form>
    </nav>
    <slot />
  </body>
</html>
