---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const fullTitle = title === "Home"
  ? "The Miracles Register"
  : `${title} — The Miracles Register`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">

    <header class="site-header sticky top-0 z-10">
      <div class="max-w-6xl mx-auto px-8 h-20 flex items-center justify-between">
        <a href="/" class="site-logo">The Miracles Register</a>
        <nav class="flex items-center gap-10">
          <a href="/saints" class="nav-link">Saints</a>
          <a href="/miracles" class="nav-link">Miracles</a>
          <button id="theme-toggle" aria-label="Toggle dark mode" class="theme-toggle">
            <span class="theme-icon-light">☀</span>
            <span class="theme-icon-dark">☽</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="site-footer mt-24">
      <div class="max-w-6xl mx-auto px-8 py-12 flex flex-col sm:flex-row items-center justify-between gap-6">
        <span class="site-logo">The Miracles Register</span>
        <div class="flex flex-col sm:flex-row items-center gap-6">
          <a href="/saints" class="nav-link">Saints</a>
          <a href="/miracles" class="nav-link">Miracles</a>
          <a href="/contact" class="nav-link">Contact</a>
          <span class="rule-dot">·</span>
          <p style="font-family:var(--font-sans);font-size:0.72rem;letter-spacing:0.04em;color:var(--text-4)">
            A structured database of Vatican-recognised miracles
          </p>
        </div>
      </div>
    </footer>

  </body>
<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const isDark = html.getAttribute('data-theme') === 'dark';
    if (isDark) {
      html.removeAttribute('data-theme');
      localStorage.setItem('theme', 'light');
    } else {
      html.setAttribute('data-theme', 'dark');
      localStorage.setItem('theme', 'dark');
    }
  });
</script>
</html>

<style is:global>
  a { color: var(--color-accent); }
  a:hover { color: var(--color-accent-hover); }

  .site-header {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--rule);
  }

  .site-footer {
    background: var(--bg-surface);
    border-top: 1px solid var(--rule);
  }

  .site-logo {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--text-1);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .site-logo:hover { opacity: 0.65; color: var(--text-1); }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-link:hover { color: var(--text-1); }

  .rule-dot { color: var(--rule-mid); }

  .font-sans    { font-family: var(--font-sans); }
  .font-serif   { font-family: var(--font-serif); }
  .font-display { font-family: var(--font-display); }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-4);
  }

  .tag {
    font-family: var(--font-sans);
    font-size: 0.63rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    background-color: var(--bg-elevated);
    color: var(--text-3);
    border-radius: 0;
    padding: 0.18rem 0.5rem;
    display: inline-block;
    white-space: nowrap;
    text-decoration: none;
  }

  .stage-badge {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 0;
    padding: 0.2rem 0.55rem;
    display: inline-block;
    white-space: nowrap;
  }
  .stage-badge.saint {
    background-color: var(--color-accent-light);
    color: var(--color-accent);
  }
  .stage-badge.blessed {
    background-color: var(--bg-elevated);
    color: var(--color-gold);
  }
  .stage-badge.venerable,
  .stage-badge.servant_of_god {
    background-color: var(--bg-elevated);
    color: var(--text-3);
  }

  .used-badge {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background-color: var(--bg-elevated);
    color: var(--text-4);
    border-radius: 0;
    padding: 0.2rem 0.5rem;
    display: inline-block;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem 1.5rem;
  }
  .meta-grid dt {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-4);
    padding-top: 0.2rem;
    white-space: nowrap;
  }
  .meta-grid dd {
    margin: 0;
    color: var(--text-2);
    font-size: 0.85rem;
    font-family: var(--font-sans);
  }

  .theme-toggle {
    background: none;
    border: 1px solid var(--rule-mid);
    color: var(--text-3);
    cursor: pointer;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    transition: border-color 0.2s, color 0.2s;
    flex-shrink: 0;
  }
  .theme-toggle:hover { border-color: var(--text-3); color: var(--text-1); }

  .theme-icon-light { display: inline; }
  .theme-icon-dark  { display: none; }

  [data-theme="dark"] .theme-icon-light { display: none; }
  [data-theme="dark"] .theme-icon-dark  { display: inline; }

  .saint-placeholder {
    background: var(--bg-elevated);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-4);
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 300;
  }

  .card {
    background: var(--bg-surface);
    border: 1px solid var(--rule);
    transition: box-shadow 0.3s;
  }
  .card:hover { box-shadow: var(--shadow-card); }

  .page-header {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--rule);
  }

  .section-rule {
    border-bottom: 1px solid var(--rule);
  }
</style>
