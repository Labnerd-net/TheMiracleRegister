---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}
const { title, description, ogImage, ogType } = Astro.props;
const fullTitle = title === "Home"
  ? "The Miracle Register"
  : `${title} — The Miracle Register`;
const canonicalUrl = Astro.url.origin + Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script defer src="https://umami.labnerd.net/script.js" data-website-id="c0613999-ec84-4770-83ec-3c33c0e52a7b"></script>
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content={ogType ?? "website"} />
    <meta property="og:url" content={canonicalUrl} />
    {description && <meta property="og:description" content={description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">

    <header class="site-header sticky top-0 z-10">
      <div class="max-w-6xl mx-auto px-4 sm:px-8 h-16 sm:h-20 flex items-center justify-between">
        <a href="/" class="site-logo">The Miracle Register</a>
        <nav class="flex items-center gap-5 sm:gap-8">
          <!-- Desktop nav links -->
          <a href="/saints" class="nav-link hidden lg:inline">Saints</a>
          <a href="/miracles" class="nav-link hidden lg:inline">Miracles</a>
          <a href="/map" class="nav-link hidden lg:inline">Map</a>
          <a href="/miracles/timeline" class="nav-link hidden lg:inline">Timeline</a>

          <!-- Desktop search input -->
          <form action="/search" method="get" class="search-form hidden md:flex" role="search">
            <input type="search" name="q" placeholder="Search…" aria-label="Search saints and miracles" class="search-nav-input" />
          </form>

          <!-- Mobile search icon -->
          <a href="/search" aria-label="Search" class="search-icon-link md:hidden">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <circle cx="6.5" cy="6.5" r="4.5"/>
              <line x1="10.5" y1="10.5" x2="14" y2="14"/>
            </svg>
          </a>

          <button id="theme-toggle" aria-label="Toggle dark mode" class="theme-toggle">
            <span class="theme-icon-light">☀</span>
            <span class="theme-icon-dark">☽</span>
          </button>

          <!-- Mobile hamburger -->
          <button id="mobile-menu-toggle" aria-label="Open menu" aria-expanded="false" class="mobile-menu-btn flex lg:hidden">
            <svg id="icon-menu" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <line x1="2" y1="5" x2="16" y2="5"/>
              <line x1="2" y1="9" x2="16" y2="9"/>
              <line x1="2" y1="13" x2="16" y2="13"/>
            </svg>
            <svg id="icon-close" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="display:none">
              <line x1="3" y1="3" x2="15" y2="15"/>
              <line x1="15" y1="3" x2="3" y2="15"/>
            </svg>
          </button>
        </nav>
      </div>

      <!-- Mobile dropdown menu -->
      <div id="mobile-menu" class="mobile-menu" hidden>
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-4">
          <a href="/saints" class="nav-link">Saints</a>
          <a href="/miracles" class="nav-link">Miracles</a>
          <a href="/map" class="nav-link">Map</a>
          <a href="/miracles/timeline" class="nav-link">Timeline</a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="site-footer mt-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-8 py-8 sm:py-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <span class="site-logo">The Miracle Register</span>
        <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 w-full sm:w-auto">
          <div class="footer-nav-links">
            <a href="/saints" class="nav-link">Saints</a>
            <a href="/miracles" class="nav-link">Miracles</a>
            <a href="/map" class="nav-link">Map</a>
            <a href="/miracles/timeline" class="nav-link">Timeline</a>
            <a href="/contact" class="nav-link">Contact</a>
            <a href="/api/v1/doc" class="nav-link">API</a>
          </div>
          <p style="font-family:var(--font-sans);font-size:0.72rem;letter-spacing:0.04em;color:var(--text-4)">
            A structured database of miracles and venerated traditions of the saints
          </p>
        </div>
      </div>
    </footer>

  </body>
<script>
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  mobileToggle?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.hidden;
    if (mobileMenu) mobileMenu.hidden = isOpen;
    if (mobileToggle) mobileToggle.setAttribute('aria-expanded', String(!isOpen));
    if (iconMenu) iconMenu.style.display = isOpen ? 'block' : 'none';
    if (iconClose) iconClose.style.display = isOpen ? 'none' : 'block';
  });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const isDark = html.getAttribute('data-theme') === 'dark';
    if (isDark) {
      html.removeAttribute('data-theme');
      localStorage.setItem('theme', 'light');
    } else {
      html.setAttribute('data-theme', 'dark');
      localStorage.setItem('theme', 'dark');
    }
  });
</script>
</html>

<style is:global>
  a { color: var(--color-accent); }
  a:hover { color: var(--color-accent-hover); }

  .site-header {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--rule);
  }

  .site-footer {
    background: var(--bg-surface);
    border-top: 1px solid var(--rule);
  }

  .site-logo {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--text-1);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  @media (min-width: 640px) {
    .site-logo { font-size: 1.35rem; }
  }
  .site-logo:hover { opacity: 0.65; color: var(--text-1); }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-link:hover { color: var(--text-1); }

  .search-form { align-items: center; }

  .search-nav-input {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--text-2);
    background: var(--bg-elevated);
    border: 1px solid var(--rule-mid);
    border-radius: 4px;
    padding: 0.3rem 0.65rem;
    width: 10rem;
    transition: width 0.2s, border-color 0.2s;
    outline: none;
  }
  .search-nav-input::placeholder { color: var(--text-4); }
  .search-nav-input:focus {
    width: 14rem;
    border-color: var(--color-accent);
  }

  .search-icon-link {
    color: var(--text-3);
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }
  .search-icon-link:hover { color: var(--text-1); }

  .rule-dot { color: var(--rule-mid); }

  .font-sans    { font-family: var(--font-sans); }
  .font-serif   { font-family: var(--font-serif); }
  .font-display { font-family: var(--font-display); }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-4);
  }

  .tag {
    font-family: var(--font-sans);
    font-size: 0.63rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    background-color: var(--bg-elevated);
    color: var(--text-3);
    border-radius: 0;
    padding: 0.18rem 0.5rem;
    display: inline-block;
    white-space: nowrap;
    text-decoration: none;
  }

  .stage-badge {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 0;
    padding: 0.2rem 0.55rem;
    display: inline-block;
    white-space: nowrap;
  }
  .stage-badge.saint {
    background-color: var(--color-accent-light);
    color: var(--color-accent);
  }
  .stage-badge.blessed {
    background-color: var(--bg-elevated);
    color: var(--color-gold);
  }
  .stage-badge.venerable,
  .stage-badge.servant_of_god {
    background-color: var(--bg-elevated);
    color: var(--text-3);
  }

  .used-badge {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background-color: var(--bg-elevated);
    color: var(--text-4);
    border-radius: 0;
    padding: 0.2rem 0.5rem;
    display: inline-block;
  }

  .approval-badge {
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 0;
    padding: 0.2rem 0.5rem;
    display: inline-block;
    white-space: nowrap;
  }
  .approval-badge.vatican {
    background-color: var(--color-accent-light);
    color: var(--color-accent);
  }
  .approval-badge.lourdes {
    background-color: var(--bg-elevated);
    color: var(--color-gold);
  }
  .approval-badge.bishop {
    background-color: var(--bg-elevated);
    color: var(--text-2);
  }
  .approval-badge.nihil {
    background-color: var(--bg-elevated);
    color: var(--text-3);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem 1.5rem;
  }
  .meta-grid dt {
    font-family: var(--font-sans);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-4);
    padding-top: 0.2rem;
    white-space: nowrap;
  }
  .meta-grid dd {
    margin: 0;
    color: var(--text-2);
    font-size: 0.85rem;
    font-family: var(--font-sans);
  }

  .theme-toggle {
    background: none;
    border: 1px solid var(--rule-mid);
    color: var(--text-3);
    cursor: pointer;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    transition: border-color 0.2s, color 0.2s;
    flex-shrink: 0;
  }
  .theme-toggle:hover { border-color: var(--text-3); color: var(--text-1); }

  .theme-icon-light { display: inline; }
  .theme-icon-dark  { display: none; }

  [data-theme="dark"] .theme-icon-light { display: none; }
  [data-theme="dark"] .theme-icon-dark  { display: inline; }

  .saint-placeholder {
    background: var(--bg-elevated);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-4);
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 300;
  }

  .card {
    background: var(--bg-surface);
    border: 1px solid var(--rule);
    transition: box-shadow 0.3s;
  }
  .card:hover { box-shadow: var(--shadow-card); }

  .page-header {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--rule);
  }

  .section-rule {
    border-bottom: 1px solid var(--rule);
  }

  .mobile-menu-btn {
    background: none;
    border: 1px solid var(--rule-mid);
    color: var(--text-3);
    cursor: pointer;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s, color 0.2s;
    flex-shrink: 0;
  }
  .mobile-menu-btn:hover { border-color: var(--text-3); color: var(--text-1); }

  .mobile-menu {
    background: var(--bg-surface);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .footer-nav-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 2rem;
  }
  @media (min-width: 640px) {
    .footer-nav-links {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
    }
  }
</style>
