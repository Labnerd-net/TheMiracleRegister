---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — The Miracles Register</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        font-family: Georgia, serif;
        max-width: 900px;
        margin: 0 auto;
        padding: 1rem 1.5rem 3rem;
        color: #1a1a1a;
        line-height: 1.6;
      }
      nav {
        border-bottom: 1px solid #ddd;
        padding-bottom: 0.75rem;
        margin-bottom: 2rem;
        display: flex;
        gap: 1.5rem;
        align-items: baseline;
      }
      nav a { text-decoration: none; color: #555; font-family: system-ui, sans-serif; font-size: 0.9rem; }
      nav a:hover { color: #000; }
      nav .site-title { font-size: 1rem; font-weight: bold; color: #000; margin-right: auto; }
      h1 { font-size: 1.8rem; margin-bottom: 0.25rem; }
      h2 { font-size: 1.3rem; margin-top: 2rem; }
      a { color: #2a5db0; }
      table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
      th { text-align: left; border-bottom: 2px solid #ddd; padding: 0.4rem 0.75rem; font-family: system-ui, sans-serif; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: #666; }
      td { border-bottom: 1px solid #eee; padding: 0.5rem 0.75rem; vertical-align: top; }
      tr:last-child td { border-bottom: none; }
      .tag { display: inline-block; background: #f0f0f0; border-radius: 3px; padding: 0.1rem 0.4rem; font-size: 0.75rem; font-family: system-ui, sans-serif; margin: 0.1rem; color: #444; }
      .meta { font-family: system-ui, sans-serif; font-size: 0.85rem; color: #666; }
      .badge { display: inline-block; font-size: 0.7rem; font-family: system-ui, sans-serif; padding: 0.15rem 0.4rem; border-radius: 3px; background: #e8f0fe; color: #2a5db0; }
      dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1.5rem; font-size: 0.9rem; }
      dt { font-family: system-ui, sans-serif; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: #888; align-self: start; padding-top: 0.1rem; }
      dd { margin: 0; }
      .back { font-family: system-ui, sans-serif; font-size: 0.85rem; margin-bottom: 1.5rem; display: block; }
    </style>
  </head>
  <body>
    <nav>
      <a href="/" class="site-title">The Miracles Register</a>
      <a href="/saints">Saints</a>
      <a href="/miracles">Miracles</a>
    </nav>
    <slot />
  </body>
</html>
