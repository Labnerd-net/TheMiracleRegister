---
import { thumbUrl } from "../lib/image";

interface Props {
  saint: {
    slug: string;
    name: string;
    image_url: string | null;
    canonization_stage: string;
    nationality: string | null;
    feast_day?: string | null;
  };
  /** "grid" is the browse-page tile; "carousel" is the compact homepage variant. */
  variant?: "grid" | "carousel";
  /** Load the image eagerly (above-the-fold tiles); lazy otherwise. Grid only. */
  eager?: boolean;
}

const { saint: s, variant = "grid", eager = false } = Astro.props;
const carousel = variant === "carousel";
const Heading = carousel ? "p" : "h2";
---

<a href={`/saints/${s.slug}`} class:list={["saint-card-link", { "carousel-card": carousel }, "group", "no-underline"]}>
  <div class="aspect-[3/4] overflow-hidden mb-4" style="background:var(--bg-elevated)">
    {s.image_url ? (
      <img
        src={thumbUrl(s.image_url, 500)!}
        alt={s.name}
        loading={carousel ? undefined : eager ? "eager" : "lazy"}
        decoding="async"
        width="300"
        height="400"
        class="w-full h-full object-cover object-top saint-img"
      />
    ) : (
      <div class="saint-placeholder w-full h-full">{carousel ? null : s.name.charAt(0)}</div>
    )}
  </div>
  {carousel ? (
    <>
      <Heading style="font-family:var(--font-display);font-size:1.25rem;font-weight:400;color:var(--text-1);line-height:1.25;margin-bottom:0.35rem;transition:color 0.2s" class="group-hover:text-[--color-accent]">{s.name}</Heading>
      <div class="flex items-center gap-2">
        <span class={`stage-badge ${s.canonization_stage}`}>{s.canonization_stage}</span>
        {s.nationality && <span style="font-family:var(--font-sans);font-size:0.68rem;color:var(--text-4)">{s.nationality}</span>}
      </div>
    </>
  ) : (
    <div>
      <Heading style="font-family:var(--font-display);font-size:1.2rem;font-weight:400;color:var(--text-1);line-height:1.25;margin-bottom:0.35rem;transition:color 0.2s" class="group-hover:text-[--color-accent]">{s.name}</Heading>
      <div class="flex items-center gap-2 flex-wrap mb-1.5">
        <span class={`stage-badge ${s.canonization_stage}`}>{s.canonization_stage}</span>
      </div>
      <div style="font-family:var(--font-sans);font-size:0.7rem;color:var(--text-4);line-height:1.6">
        {s.feast_day && <span class="block">{s.feast_day}</span>}
        {s.nationality && <span class="block">{s.nationality}</span>}
      </div>
    </div>
  )}
</a>
