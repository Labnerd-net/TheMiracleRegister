---
interface Props {
  images: { url: string; caption: string | null; source_attribution: string | null }[];
  title: string;
}
const { images, title } = Astro.props;
---

<dialog id="lb" aria-label="Image viewer">
  <button id="lb-close" aria-label="Close">✕</button>
  <img id="lb-img" src="" alt="" />
  <div id="lb-meta">
    <p id="lb-caption"></p>
    <p id="lb-attr"></p>
  </div>
  <div id="lb-nav">
    <button id="lb-prev" aria-label="Previous image">&#8592;</button>
    <span id="lb-counter" aria-hidden="true"></span>
    <button id="lb-next" aria-label="Next image">&#8594;</button>
  </div>
  <p id="lb-status" class="sr-only" role="status"></p>
</dialog>

<script is:inline define:vars={{ lbImages: images, miracleTitle: title }}>
  const lb = document.getElementById('lb');
  const lbImg = document.getElementById('lb-img');
  const lbCaption = document.getElementById('lb-caption');
  const lbAttr = document.getElementById('lb-attr');
  const lbCounter = document.getElementById('lb-counter');
  const lbNav = document.getElementById('lb-nav');
  const lbStatus = document.getElementById('lb-status');

  let currentIndex = 0;
  let opener = null;

  function showImage(index, announce) {
    const img = lbImages[index];
    const position = lbImages.length > 1 ? `Image ${index + 1} of ${lbImages.length}` : 'Image';
    lbImg.src = img.url;
    lbImg.alt = img.caption || miracleTitle;
    lbCaption.textContent = img.caption || '';
    lbAttr.textContent = img.source_attribution || '';
    lbCounter.textContent = `${index + 1} / ${lbImages.length}`;
    // The dialog name is read on open; prev/next write one polite status instead.
    lb.setAttribute('aria-label', `Image viewer, ${position.toLowerCase()}`);
    if (announce) lbStatus.textContent = img.caption ? `${position}. ${img.caption}` : position;
    currentIndex = index;
  }

  function step(delta) {
    if (lbImages.length < 2) return;
    showImage((currentIndex + delta + lbImages.length) % lbImages.length, true);
  }

  lbImg.addEventListener('error', () => {
    lbCaption.textContent = 'This image could not be loaded.';
    lbStatus.textContent = 'This image could not be loaded.';
  });

  function openLightbox(index) {
    lbStatus.textContent = '';
    showImage(index, false);
    lbNav.style.display = lbImages.length > 1 ? 'flex' : 'none';
    const scrollY = window.scrollY;
    lb.showModal();
    window.scrollTo(0, scrollY);
  }

  document.querySelectorAll('.lb-trigger').forEach((btn, i) => {
    btn.addEventListener('click', () => { opener = btn; openLightbox(i); });
  });

  document.getElementById('lb-close').addEventListener('click', () => lb.close());
  document.getElementById('lb-prev').addEventListener('click', () => step(-1));
  document.getElementById('lb-next').addEventListener('click', () => step(1));

  lb.addEventListener('close', () => { if (opener) opener.focus(); });

  lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });

  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'ArrowLeft') step(-1);
  });
</script>

<style>
  :global(.lb-trigger) {
    display: block;
    width: 100%;
    cursor: zoom-in;
    border: none;
    background: none;
    padding: 0;
    text-align: left;
  }
  #lb {
    border: none;
    background: transparent;
    padding: 1.5rem;
    max-width: min(90vw, 1100px);
    max-height: 90vh;
    margin: auto;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  #lb[open] {
    display: flex;
  }
  #lb::backdrop {
    background: rgba(0, 0, 0, 0.88);
  }
  #lb-img {
    max-width: 100%;
    max-height: calc(90vh - 6rem);
    object-fit: contain;
    display: block;
  }
  #lb-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: none;
    border-radius: 50%;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    font-size: 1rem;
    line-height: 2rem;
  }
  #lb :focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  #lb-meta {
    text-align: center;
    color: #ccc;
    font-size: 0.8rem;
    font-family: var(--font-sans);
  }
  #lb-meta p { margin: 0; }
  #lb-attr { font-style: italic; opacity: 0.7; }
  #lb-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.25rem;
  }
  #lb-nav button {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    border: none;
    border-radius: 50%;
    width: 2.25rem;
    height: 2.25rem;
    cursor: pointer;
    font-size: 1.1rem;
    line-height: 2.25rem;
  }
  #lb-nav button:hover { background: rgba(255, 255, 255, 0.3); }
  #lb-counter {
    color: #ccc;
    font-size: 0.8rem;
    font-family: var(--font-sans);
    min-width: 3rem;
    text-align: center;
  }
</style>
