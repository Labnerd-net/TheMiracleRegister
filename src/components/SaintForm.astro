---
import { SAINT_THEMES } from "../db/topics";
import { canonizationType, canonizationStage } from "../db/schema/enums";
import type { saints } from "../db/schema";

type Saint = typeof saints.$inferSelect;

interface Props {
  saint?: Saint;
}

const { saint } = Astro.props;
const v = saint;
const join = (arr: string[] | null | undefined) => arr?.join(", ") ?? "";
---

<form method="post">
<script>
  function wordCount(el: HTMLTextAreaElement): number {
    return el.value.trim() ? el.value.trim().split(/\s+/).length : 0;
  }
  const bio = document.getElementById('biography_short') as HTMLTextAreaElement;
  const bioCount = document.getElementById('biography-count');
  if (bio && bioCount) {
    const update = () => { bioCount.textContent = `${wordCount(bio)} words — target ~300`; };
    bio.addEventListener('input', update);
    update();
  }
</script>
  <fieldset>
    <legend>Identity</legend>
    <div class="two-col">
      <div class="field">
        <label for="name">Name *</label>
        <input type="text" id="name" name="name" value={v?.name ?? ""} required />
      </div>
      {!v && (
        <div class="field">
          <label for="slug">Slug</label>
          <input type="text" id="slug" name="slug" placeholder="auto-generated from name" />
        </div>
      )}
    </div>
    <div class="field">
      <label for="birth_name">Birth Name</label>
      <input type="text" id="birth_name" name="birth_name" value={v?.birth_name ?? ""} />
    </div>
  </fieldset>

  <fieldset>
    <legend>Life</legend>
    <div class="two-col">
      <div class="field">
        <label for="birth_date">Birth Date</label>
        <input type="date" id="birth_date" name="birth_date" value={v?.birth_date ?? ""} />
      </div>
      <div class="field">
        <label for="death_date">Death Date</label>
        <input type="date" id="death_date" name="death_date" value={v?.death_date ?? ""} />
      </div>
      <div class="field">
        <label for="nationality">Nationality</label>
        <input type="text" id="nationality" name="nationality" value={v?.nationality ?? ""} />
      </div>
      <div class="field">
        <label for="religious_order">Religious Order</label>
        <input type="text" id="religious_order" name="religious_order" value={v?.religious_order ?? ""} />
      </div>
      <div class="field">
        <label for="feast_day">Feast Day</label>
        <input type="text" id="feast_day" name="feast_day" value={v?.feast_day ?? ""} placeholder="e.g. October 22" />
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Canonization</legend>
    <div class="two-col">
      <div class="field">
        <label for="beatification_date">Beatification Date</label>
        <input type="date" id="beatification_date" name="beatification_date" value={v?.beatification_date ?? ""} />
      </div>
      <div class="field">
        <label for="beatified_by">Beatified By</label>
        <input type="text" id="beatified_by" name="beatified_by" value={v?.beatified_by ?? ""} />
      </div>
      <div class="field">
        <label for="canonization_date">Canonization Date</label>
        <input type="date" id="canonization_date" name="canonization_date" value={v?.canonization_date ?? ""} />
      </div>
      <div class="field">
        <label for="canonized_by">Canonized By</label>
        <input type="text" id="canonized_by" name="canonized_by" value={v?.canonized_by ?? ""} />
      </div>
      <div class="field">
        <label for="canonization_type">Type</label>
        <select id="canonization_type" name="canonization_type">
          <option value="">— select —</option>
          {canonizationType.enumValues.map((t) => (
            <option value={t} selected={v?.canonization_type === t}>{t}</option>
          ))}
        </select>
      </div>
      <div class="field">
        <label for="canonization_stage">Stage *</label>
        <select id="canonization_stage" name="canonization_stage" required>
          {canonizationStage.enumValues.map((t) => (
            <option value={t} selected={v ? v.canonization_stage === t : t === "saint"}>{t}</option>
          ))}
        </select>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Taxonomy</legend>
    <div class="field">
      <label for="patronage">Patronage</label>
      <input type="text" id="patronage" name="patronage" value={join(v?.patronage)} placeholder="comma-separated" />
    </div>
    <div class="field">
      <label>Themes</label>
      <div class="checkbox-group">
        {SAINT_THEMES.map((t) => (
          <label>
            <input type="checkbox" name="themes" value={t} checked={v?.themes?.includes(t)} />
            {t}
          </label>
        ))}
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Content</legend>
    <div class="field">
      <label for="biography_short">Biography</label>
      <div class="md-cheatsheet">
        <strong>Markdown supported —</strong>
        <code>*italic*</code> &nbsp;
        <code>**bold**</code> &nbsp;
        <code>[link text](https://...)</code> &nbsp;
        blank line = new paragraph
      </div>
      <textarea id="biography_short" name="biography_short" rows={v ? 14 : 10}>{v?.biography_short ?? ""}</textarea>
      <p class="hint" id="biography-count">~300 words</p>
    </div>
    <div class="field">
      <label for="image_url">Image URL</label>
      <input type="url" id="image_url" name="image_url" value={v?.image_url ?? ""} />
    </div>
    <div class="field">
      <label for="wikipedia_url">Wikipedia URL</label>
      <input type="url" id="wikipedia_url" name="wikipedia_url" value={v?.wikipedia_url ?? ""} />
    </div>
    <div class="field">
      <label>
        <input type="hidden" name="published" value="false" />
        <input type="checkbox" name="published" value="true" checked={v?.published} />
        Published (visible on public site)
      </label>
    </div>
  </fieldset>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">{v ? "Save Changes" : "Create Saint"}</button>
    <a href="/admin/saints" class="btn btn-secondary">Cancel</a>
  </div>
</form>
