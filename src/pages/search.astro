---
import Base from "../layouts/Base.astro";
import { createDb } from "../db";
import { miracles, saints } from "../db/schema";
import { and, eq, ilike, or, sql } from "drizzle-orm";
import { env } from "cloudflare:workers";

const q = Astro.url.searchParams.get("q")?.trim() ?? "";

type SaintResult = { slug: string; name: string; excerpt: string | null };
type MiracleResult = { slug: string; title: string; excerpt: string | null };

let saintResults: SaintResult[] = [];
let miracleResults: MiracleResult[] = [];

if (q.length >= 2) {
  const db = createDb(env.DATABASE_URL);
  const pattern = `%${q}%`;

  [saintResults, miracleResults] = await Promise.all([
    db
      .select({
        slug: saints.slug,
        name: saints.name,
        excerpt: sql<string | null>`LEFT(${saints.biography_short}, 220)`,
      })
      .from(saints)
      .where(and(
        eq(saints.published, true),
        or(ilike(saints.name, pattern), ilike(saints.biography_short, pattern))
      )),
    db
      .select({
        slug: miracles.slug,
        title: miracles.title,
        excerpt: sql<string | null>`LEFT(${miracles.synopsis}, 220)`,
      })
      .from(miracles)
      .where(and(
        eq(miracles.published, true),
        or(
          ilike(miracles.title, pattern),
          ilike(miracles.synopsis, pattern),
          ilike(miracles.medical_diagnosis, pattern),
          ilike(miracles.cure_details, pattern),
        )
      )),
  ]);
}

const total = saintResults.length + miracleResults.length;
const hasQuery = q.length >= 2;
const hasResults = total > 0;
---

<Base title="Search">

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-8 py-10 sm:py-16">
      <p class="eyebrow mb-4">The Register</p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,5vw,4rem);font-weight:300;color:var(--text-1);line-height:1.05;letter-spacing:-0.01em">Search</h1>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-8 sm:py-12">

    <form action="/search" method="get" role="search" class="search-form">
      <div class="search-input-row">
        <input
          type="search"
          name="q"
          value={q}
          placeholder="Search saints, miracles, diagnoses…"
          aria-label="Search"
          autofocus={!hasQuery}
          class="search-input"
        />
        <button type="submit" class="search-btn">Search</button>
      </div>
      {q.length === 1 && (
        <p class="search-hint">Enter at least 2 characters.</p>
      )}
    </form>

    {hasQuery && (
      <div class="results-header">
        {hasResults
          ? <p class="results-count">{total} result{total !== 1 ? "s" : ""} for <em>"{q}"</em></p>
          : <p class="results-count">No results for <em>"{q}"</em></p>
        }
      </div>
    )}

    {hasQuery && hasResults && (
      <div class="results">

        {saintResults.length > 0 && (
          <section class="result-group">
            <h2 class="result-group-label">Saints <span class="result-group-count">{saintResults.length}</span></h2>
            <div class="space-y-2">
              {saintResults.map(s => (
                <a href={`/saints/${s.slug}`} class="result-card block no-underline group">
                  <div class="card px-6 py-4">
                    <div class="result-type-tag">Saint</div>
                    <h3 class="result-title group-hover:text-[--color-accent]">{s.name}</h3>
                    {s.excerpt && (
                      <p class="result-excerpt">{s.excerpt.length === 220 ? s.excerpt + "…" : s.excerpt}</p>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        {miracleResults.length > 0 && (
          <section class="result-group">
            <h2 class="result-group-label">Miracles <span class="result-group-count">{miracleResults.length}</span></h2>
            <div class="space-y-2">
              {miracleResults.map(m => (
                <a href={`/miracles/${m.slug}`} class="result-card block no-underline group">
                  <div class="card px-6 py-4">
                    <div class="result-type-tag">Miracle</div>
                    <h3 class="result-title group-hover:text-[--color-accent]">{m.title}</h3>
                    {m.excerpt && (
                      <p class="result-excerpt">{m.excerpt.length === 220 ? m.excerpt + "…" : m.excerpt}</p>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

      </div>
    )}

    {hasQuery && !hasResults && (
      <div class="no-results">
        <p>Try a different term — saint names, medical conditions, countries, or keywords from miracle accounts.</p>
      </div>
    )}

  </div>

</Base>

<style>
  .search-form {
    max-width: 40rem;
  }

  .search-input-row {
    display: flex;
    gap: 0.5rem;
  }

  .search-input {
    flex: 1;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--text-1);
    background: var(--bg-elevated);
    border: 1px solid var(--rule-mid);
    border-radius: 4px;
    padding: 0.55rem 0.85rem;
    outline: none;
    transition: border-color 0.2s;
  }
  .search-input::placeholder { color: var(--text-4); }
  .search-input:focus { border-color: var(--color-accent); }

  .search-btn {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--bg-base);
    background: var(--color-accent);
    border: none;
    border-radius: 4px;
    padding: 0.55rem 1.1rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .search-btn:hover { opacity: 0.85; }

  .search-hint {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--text-4);
    margin-top: 0.4rem;
  }

  .results-header {
    margin-top: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule-light);
  }

  .results-count {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-3);
  }
  .results-count em {
    font-style: normal;
    color: var(--text-1);
  }

  .results {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .result-group-label {
    font-family: var(--font-sans);
    font-size: 0.63rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-4);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .result-group-count {
    font-weight: 400;
    color: var(--text-4);
  }

  .result-type-tag {
    font-family: var(--font-sans);
    font-size: 0.63rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.3rem;
  }

  .result-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--text-1);
    line-height: 1.3;
    margin-bottom: 0.35rem;
    transition: color 0.2s;
  }

  .result-excerpt {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--text-3);
    line-height: 1.65;
  }

  .no-results {
    margin-top: 2rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--text-4);
  }
</style>
