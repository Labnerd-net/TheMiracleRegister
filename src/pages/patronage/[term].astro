---
import Base from "../../layouts/Base.astro";
import { createDb } from "../../db";
import { saints } from "../../db/schema";
import { inArray } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { CACHE_CONTENT } from "../../lib/cache";
import { getPatronageTerms, hasPatronagePage } from "../../lib/patronage";
import { thumbUrl } from "../../lib/image";
import { collectionJsonLd, breadcrumbJsonLd } from "../../lib/jsonld";

const { term: termSlug } = Astro.params;

const db = createDb(env.DATABASE_URL);
const term = (await getPatronageTerms(db)).find((t) => t.slug === termSlug);
if (!term) return Astro.redirect("/404");
// A term that dropped to one saint no longer has a page; send the old URL to that saint.
if (!hasPatronagePage(term)) return Astro.redirect(`/saints/${term.saints[0].slug}`);

Astro.response.headers.set("Cache-Control", CACHE_CONTENT);

const termSaints = await db
  .select({
    slug: saints.slug,
    name: saints.name,
    feast_day: saints.feast_day,
    nationality: saints.nationality,
    canonization_stage: saints.canonization_stage,
    image_url: saints.image_url,
  })
  .from(saints)
  .where(inArray(saints.id, term.saints.map((s) => s.id)))
  .orderBy(saints.name);

const label = term.label;
const total = termSaints.length;
const path = `/patronage/${term.slug}`;
const description = `${total} saints invoked as patrons of ${label.toLowerCase()}, with biographies and documented miracles.`;
const jsonLd = [
  collectionJsonLd({ name: `Patron saints: ${label}`, description, path }),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Patronage", path: "/patronage" },
    { name: label, path },
  ]),
];
---

<Base title={`Patron Saints: ${label}`} description={description} jsonLd={jsonLd}>

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
      <p class="eyebrow mb-4"><a href="/patronage" style="color:inherit;text-decoration:none">Patronage</a></p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,5vw,4rem);font-weight:300;color:var(--text-1);line-height:1.05;letter-spacing:-0.01em">{label}</h1>
      <p style="font-family:var(--font-sans);font-size:0.8rem;color:var(--text-4);margin-top:0.6rem;letter-spacing:0.02em">{total} saints recorded</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10">
      {termSaints.map((s, i) => (
        <a href={`/saints/${s.slug}`} class="saint-card-link group no-underline">
          <div class="aspect-[3/4] overflow-hidden mb-4" style="background:var(--bg-elevated)">
            {s.image_url ? (
              <img src={thumbUrl(s.image_url, 500)!} alt={s.name} loading={i < 4 ? "eager" : "lazy"} decoding="async" width="300" height="400" class="w-full h-full object-cover object-top saint-img" />
            ) : (
              <div class="saint-placeholder w-full h-full">{s.name.charAt(0)}</div>
            )}
          </div>
          <div>
            <h2 style="font-family:var(--font-display);font-size:1.2rem;font-weight:400;color:var(--text-1);line-height:1.25;margin-bottom:0.35rem;transition:color 0.2s" class="group-hover:text-[--color-accent]">{s.name}</h2>
            <div class="flex items-center gap-2 flex-wrap mb-1.5">
              <span class={`stage-badge ${s.canonization_stage}`}>{s.canonization_stage}</span>
            </div>
            <div style="font-family:var(--font-sans);font-size:0.7rem;color:var(--text-4);line-height:1.6">
              {s.feast_day && <span class="block">{s.feast_day}</span>}
              {s.nationality && <span class="block">{s.nationality}</span>}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>

</Base>
