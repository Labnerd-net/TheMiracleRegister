---
import Base from "../../layouts/Base.astro";
import { createDb } from "../../db";
import { env } from "cloudflare:workers";
import { CACHE_CONTENT } from "../../lib/cache";
import { getPatronageTerms, hasPatronagePage } from "../../lib/patronage";
import { collectionJsonLd, breadcrumbJsonLd } from "../../lib/jsonld";

Astro.response.headers.set("Cache-Control", CACHE_CONTENT);

const db = createDb(env.DATABASE_URL);
const terms = await getPatronageTerms(db);

const description = "Browse saints by patronage: the causes, professions, groups and places each saint is invoked for.";
const jsonLd = [
  collectionJsonLd({ name: "Saints by patronage", description, path: "/patronage" }),
  breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Patronage", path: "/patronage" }]),
];
---

<Base title="Saints by Patronage" description={description} jsonLd={jsonLd}>

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
      <p class="eyebrow mb-4">Browse</p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,5vw,4rem);font-weight:300;color:var(--text-1);line-height:1.05;letter-spacing:-0.01em">Saints by Patronage</h1>
      <p style="font-family:var(--font-sans);font-size:0.8rem;color:var(--text-4);margin-top:0.6rem;letter-spacing:0.02em">{description}</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    {terms.length === 0 ? (
      <p class="empty-state">No patronages recorded yet.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {terms.map((t) => (
          <a href={hasPatronagePage(t) ? `/patronage/${t.slug}` : `/saints/${t.saints[0].slug}`} class="block no-underline group">
            <div class="card px-6 py-5">
              <h2 style="font-family:var(--font-display);font-size:1.25rem;font-weight:400;color:var(--text-1);line-height:1.3;margin-bottom:0.35rem" class="group-hover:text-[--color-accent]">{t.label}</h2>
              <p style="font-family:var(--font-sans);font-size:0.75rem;color:var(--text-4)">
                {hasPatronagePage(t) ? `${t.saints.length} saints` : t.saints[0].name}
              </p>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>

</Base>
