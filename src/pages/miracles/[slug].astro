---
import Base from "../../layouts/Base.astro";
import { createDb } from "../../db";
import { miracles, saints, miracleSaints, miracleSources, miracleImages } from "../../db/schema";
import { and, asc, eq, inArray, ne, sql } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { renderMarkdown } from "../../lib/markdown";
import { humanizeSnakeCase, ogDescription, approvalBadge, formatFeastDay, sortSources } from "../../lib/format";
import { thumbUrl } from "../../lib/image";
import { redactRecipient } from "../../lib/privacy";
import { isValidPreviewToken } from "../../lib/preview";
import { findSlugRedirect, CACHE_REDIRECT } from "../../lib/slugRedirect";
import { CACHE_CONTENT } from "../../lib/cache";
import { safeHttpUrl } from "../../lib/url";
import { miracleJsonLd, breadcrumbJsonLd } from "../../lib/jsonld";
import { fetchSaintsByMiracle } from "../../lib/queries/miracles";

const { slug } = Astro.params;
const db = createDb(env.DATABASE_URL);
const isPreview = isValidPreviewToken(Astro.url.searchParams.get("preview"), env.PREVIEW_TOKEN);

const [miracle] = await db.select({
  id: miracles.id,
  title: miracles.title,
  miracle_category: miracles.miracle_category,
  type: miracles.type,
  date_of_event: miracles.date_of_event,
  date_precision: miracles.date_precision,
  location_name: miracles.location_name,
  location_lat: miracles.location_lat,
  location_lng: miracles.location_lng,
  location_2_name: miracles.location_2_name,
  location_2_lat: miracles.location_2_lat,
  location_2_lng: miracles.location_2_lng,
  country: miracles.country,
  recipient_privacy: miracles.recipient_privacy,
  recipient_name: miracles.recipient_name,
  recipient_age_at_event: miracles.recipient_age_at_event,
  recipient_country: miracles.recipient_country,
  used_for_beatification: miracles.used_for_beatification,
  used_for_canonization: miracles.used_for_canonization,
  topics: miracles.topics,
  vatican_medical_board_verdict: miracles.vatican_medical_board_verdict,
  medical_diagnosis: miracles.medical_diagnosis,
  cure_details: miracles.cure_details,
  synopsis: miracles.synopsis,
  timing_relative_to_saint_death: miracles.timing_relative_to_saint_death,
  cure_characteristics: miracles.cure_characteristics,
  intercessory_medium: miracles.intercessory_medium,
  was_medically_verified: miracles.was_medically_verified,
  medical_verification_date: miracles.medical_verification_date,
  approval_authority: miracles.approval_authority,
  vatican_decree_date: miracles.vatican_decree_date,
  witness_count: miracles.witness_count,
  feast_month: miracles.feast_month,
  feast_day_of_month: miracles.feast_day_of_month,
}).from(miracles).where(
  isPreview
    ? eq(miracles.slug, slug!)
    : and(eq(miracles.slug, slug!), eq(miracles.published, true))
);
if (!miracle) {
  const renamedTo = isPreview ? null : await findSlugRedirect(db, "miracle", slug!);
  if (!renamedTo) return Astro.rewrite("/404");
  return new Response(null, {
    status: 301,
    headers: { Location: `/miracles/${renamedTo}`, "Cache-Control": CACHE_REDIRECT },
  });
}

Astro.response.headers.set(
  "Cache-Control",
  isPreview ? "no-store" : CACHE_CONTENT
);

const hasTopics = miracle.topics && miracle.topics.length > 0;

const relatedMiracleFields = {
  id: miracles.id,
  slug: miracles.slug,
  title: miracles.title,
  type: miracles.type,
  topics: miracles.topics,
};

const [miracleSaintRows, sources, images, saintLinked, topicLinked] = await Promise.all([
  db.select({ slug: saints.slug, name: saints.name, canonization_stage: saints.canonization_stage, image_url: saints.image_url })
    .from(miracleSaints)
    .innerJoin(saints, eq(miracleSaints.saint_id, saints.id))
    .where(isPreview
      ? eq(miracleSaints.miracle_id, miracle.id)
      : and(eq(miracleSaints.miracle_id, miracle.id), eq(saints.published, true))),
  db.select({
    url: miracleSources.url,
    title: miracleSources.title,
    source_type: miracleSources.source_type,
    accessed_date: miracleSources.accessed_date,
  }).from(miracleSources).where(eq(miracleSources.miracle_id, miracle.id))
    .then(sortSources),
  db.select({
    id: miracleImages.id,
    url: miracleImages.url,
    caption: miracleImages.caption,
    source_attribution: miracleImages.source_attribution,
  }).from(miracleImages).where(eq(miracleImages.miracle_id, miracle.id))
    .orderBy(asc(miracleImages.display_order)),
  db.selectDistinct(relatedMiracleFields)
    .from(miracles)
    .innerJoin(miracleSaints, eq(miracleSaints.miracle_id, miracles.id))
    .where(and(
      eq(miracles.published, true),
      ne(miracles.id, miracle.id),
      inArray(miracleSaints.saint_id, db.select({ saint_id: miracleSaints.saint_id }).from(miracleSaints).where(eq(miracleSaints.miracle_id, miracle.id))),
    )),
  hasTopics
    ? db.select(relatedMiracleFields)
        .from(miracles).where(
          and(
            eq(miracles.published, true),
            ne(miracles.id, miracle.id),
            sql`${miracles.topics} && ARRAY[${sql.join(miracle.topics!.map(t => sql`${t}`), sql`, `)}]::text[]`,
          )
        ).limit(10)
    : Promise.resolve([]),
]);

// Saint-linked miracles first, then topic-linked; deduplicate; cap at 5
const seen = new Set<number>([miracle.id]);
const relatedMiracles: typeof saintLinked = [];
for (const m of [...saintLinked, ...topicLinked]) {
  if (!seen.has(m.id) && relatedMiracles.length < 5) {
    seen.add(m.id);
    relatedMiracles.push(m);
  }
}

const relatedSaintsMap = new Map<number, string[]>(
  [...await fetchSaintsByMiracle(db, relatedMiracles.map((r) => r.id), { includeUnpublished: isPreview })]
    .map(([id, list]) => [id, list.map((s) => s.name)])
);

const fmt = humanizeSnakeCase;


const feastDay = formatFeastDay(miracle.feast_month, miracle.feast_day_of_month);

const ogDesc = ogDescription(miracle.synopsis) || undefined;
const jsonLd = [
  miracleJsonLd({
    slug: slug!,
    title: miracle.title,
    description: ogDesc,
    image: thumbUrl(images[0]?.url, 1280) ?? undefined,
    saints: miracleSaintRows,
  }),
  breadcrumbJsonLd([
    { name: "Miracles", path: "/miracles" },
    { name: miracle.title, path: `/miracles/${slug}` },
  ]),
];
---

<Base title={miracle.title} description={ogDesc} ogImage={thumbUrl(images[0]?.url, 1280) ?? undefined} ogType="article" jsonLd={jsonLd}>
  {miracle.location_lat && miracle.location_lng && (
    <link slot="head" rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  )}

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4">
      <a href="/miracles" style="font-family:var(--font-sans);font-size:0.68rem;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-4);text-decoration:none">← Miracles</a>
    </div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-10 sm:pb-14 pt-6 lg:grid lg:grid-cols-[1fr_220px] lg:gap-16 lg:items-start">
      <div>
        <div class="flex flex-wrap items-center gap-3 mb-5">
          <span style="font-family:var(--font-sans);font-size:0.65rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4)">{fmt(miracle.miracle_category)} miracle</span>
          <span style="color:var(--rule-mid)">·</span>
          <a href={`/miracles?type=${miracle.type}`} style="font-family:var(--font-sans);font-size:0.65rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);text-decoration:none;border-bottom:1px solid var(--rule)">{fmt(miracle.type)}</a>
          {(() => { const b = approvalBadge(miracle.approval_authority); return b ? <a href={`/miracles?approval_authority=${miracle.approval_authority}`} class={`approval-badge ${b.cls}`} style="text-decoration:none">{b.label}</a> : null; })()}
        </div>
        <h1 style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.5rem);font-weight:300;color:var(--text-1);line-height:1.1;margin-bottom:1.5rem;letter-spacing:-0.01em">{miracle.title}</h1>

        {miracleSaintRows.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {miracleSaintRows.map((saint) => (
              <a href={`/saints/${saint.slug}`} class="inline-flex items-center gap-2.5 no-underline group">
                {saint.image_url && (
                  <div class="w-8 h-8 rounded-full overflow-hidden shrink-0" style="background:var(--bg-elevated)">
                    <img src={thumbUrl(saint.image_url, 330)!} alt={saint.name} class="w-full h-full object-cover object-top" />
                  </div>
                )}
                <span style="font-family:var(--font-sans);font-size:0.82rem;font-weight:500;color:var(--color-accent)" class="group-hover:underline">{saint.name}</span>
                <span class={`stage-badge ${saint.canonization_stage}`}>{saint.canonization_stage}</span>
              </a>
            ))}
          </div>
        )}

        <div class="flex flex-wrap gap-x-8 gap-y-3 mt-7 pt-7" style="border-top:1px solid var(--rule)">
          {miracle.date_of_event && (
            <div>
              <p style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);margin-bottom:0.3rem">Date</p>
              <p style="font-family:var(--font-sans);font-size:0.82rem;color:var(--text-2)">{miracle.date_of_event} <span style="color:var(--text-4);font-size:0.72rem">({fmt(miracle.date_precision)})</span></p>
            </div>
          )}
          {miracle.country && (
            <div>
              <p style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);margin-bottom:0.3rem">Location</p>
              <p style="font-family:var(--font-sans);font-size:0.82rem;color:var(--text-2)">{miracle.location_name ?? miracle.country}</p>
            </div>
          )}
          {miracle.recipient_privacy !== "not_applicable" && (
            <div>
              <p style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);margin-bottom:0.3rem">Recipient</p>
              {miracle.recipient_privacy === "confidential" ? (
                <p style="font-family:var(--font-sans);font-size:0.82rem;color:var(--text-4);font-style:italic">Name withheld</p>
              ) : (
                <p style="font-family:var(--font-sans);font-size:0.82rem;color:var(--text-2)">{redactRecipient(miracle.recipient_name, miracle.recipient_privacy)}{miracle.recipient_age_at_event != null ? ` (age ${miracle.recipient_age_at_event})` : ""}</p>
              )}
              {miracle.recipient_country && miracle.recipient_country !== miracle.country && (
                <p style="font-family:var(--font-sans);font-size:0.72rem;color:var(--text-4);margin-top:0.2rem">from {miracle.recipient_country}</p>
              )}
            </div>
          )}
          {(miracle.used_for_beatification || miracle.used_for_canonization) && (
            <div>
              <p style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);margin-bottom:0.3rem">Used For</p>
              <div class="flex gap-1.5">
                {miracle.used_for_beatification && <span class="used-badge">Beatification</span>}
                {miracle.used_for_canonization && <span class="used-badge">Canonization</span>}
              </div>
            </div>
          )}
        </div>
      </div>

      <div class="mt-8 lg:mt-0">
        {miracle.topics && miracle.topics.length > 0 && (
          <>
            <h2 class="eyebrow mb-4">Topics</h2>
            <div class="flex flex-wrap gap-1.5">
              {miracle.topics.map((t) => <a href={`/topics/${encodeURIComponent(t)}`} class="tag" style="text-decoration:none">{t}</a>)}
            </div>
          </>
        )}
      </div>
    </div>
  </div>

  {images[0] && (
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-8">
      <div class="rounded overflow-hidden" style="background:var(--bg-elevated)">
        <img src={thumbUrl(images[0].url, 960)!} alt={images[0].caption ?? miracle.title} class="w-full object-contain" style="aspect-ratio:4/3;max-height:480px" />
        {(images[0].caption || images[0].source_attribution) && (
          <div style="padding:0.5rem 0.75rem;font-size:0.75rem;color:var(--text-3)">
            {images[0].caption && <span>{images[0].caption}</span>}
            {images[0].caption && images[0].source_attribution && <span> · </span>}
            {images[0].source_attribution && <span style="font-style:italic">{images[0].source_attribution}</span>}
          </div>
        )}
      </div>
    </div>
  )}

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14 lg:grid lg:grid-cols-[1fr_240px] lg:gap-12">

    <aside class="mb-8 lg:mb-0 lg:col-start-2 lg:row-start-1">
      <div class="card p-5 lg:sticky lg:top-24">
        <h2 class="eyebrow mb-5">Full Record</h2>
        <dl class="meta-grid">
          <dt>Category</dt><dd>{fmt(miracle.miracle_category)}</dd>
          <dt>Type</dt><dd>{fmt(miracle.type)}</dd>
          {feastDay && (
            <><dt>Feast Day</dt><dd>{feastDay}</dd></>
          )}
          {miracle.timing_relative_to_saint_death !== "not_applicable" && (
            <><dt>Timing</dt><dd>{fmt(miracle.timing_relative_to_saint_death)}</dd></>
          )}
          {miracle.cure_characteristics !== "not_applicable" && (
            <><dt>Cure</dt><dd>{fmt(miracle.cure_characteristics)}</dd></>
          )}
          {miracle.intercessory_medium !== "not_applicable" && (
            <><dt>Medium</dt><dd>{fmt(miracle.intercessory_medium)}</dd></>
          )}
          <dt>Verified</dt><dd>{miracle.was_medically_verified ? "Yes" : "No"}</dd>
          {miracle.medical_verification_date && (
            <><dt>Verified On</dt><dd>{miracle.medical_verification_date}</dd></>
          )}
          {miracle.approval_authority !== "none" && (
            <><dt>Approved by</dt><dd>{fmt(miracle.approval_authority)}</dd></>
          )}
          {miracle.witness_count && (
            <><dt>Witnesses</dt><dd>{miracle.witness_count.toLocaleString()}</dd></>
          )}
          {miracle.vatican_decree_date && (
            <><dt>Decree</dt><dd>{miracle.vatican_decree_date}</dd></>
          )}
        </dl>
      </div>
    </aside>

    <div class="lg:col-start-1 lg:row-start-1">
      {miracle.vatican_medical_board_verdict && (
        <blockquote class="pl-6 mb-11" style="border-left:2px solid var(--color-gold)">
          <p style="font-family:var(--font-display);font-size:1.35rem;font-weight:300;font-style:italic;color:var(--text-2);line-height:1.55;margin-bottom:0.6rem">{miracle.vatican_medical_board_verdict}</p>
          <footer style="font-family:var(--font-sans);font-size:0.65rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4)">Vatican Medical Board</footer>
        </blockquote>
      )}

      {miracle.medical_diagnosis && (
        <section class="mb-9 pb-9 section-rule">
          <h2 class="eyebrow mb-4">Medical Diagnosis</h2>
          <p style="font-family:var(--font-sans);font-size:0.875rem;color:var(--text-3);line-height:1.8">{miracle.medical_diagnosis}</p>
        </section>
      )}

      {miracle.cure_details && (
        <section class="mb-9 pb-9 section-rule">
          <h2 class="eyebrow mb-4">Cure Details</h2>
          <div class="prose" set:html={renderMarkdown(miracle.cure_details)} />
        </section>
      )}

      {miracle.synopsis && (
        <section class="mb-9 pb-9 section-rule">
          <h2 class="eyebrow mb-5">Synopsis</h2>
          <div class="prose" set:html={renderMarkdown(miracle.synopsis)} />
        </section>
      )}

      {images.length > 0 && (
        <section class="mb-9 pb-9 section-rule">
          <h2 class="eyebrow mb-5">Images</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {images.map((img) => (
              <button type="button" class="lb-trigger" aria-haspopup="dialog" aria-label={`View larger: ${img.caption ?? miracle.title}`} data-lightbox-url={img.url} data-lightbox-caption={img.caption ?? ""} data-lightbox-attr={img.source_attribution ?? ""}>
                <div class="rounded overflow-hidden" style="background:var(--bg-elevated)">
                  <img src={thumbUrl(img.url, 500)!} alt={img.caption ?? miracle.title} loading="lazy" decoding="async" class="w-full object-contain" style="height:220px" />
                  {(img.caption || img.source_attribution) && (
                    <div style="padding:0.5rem 0.75rem;font-size:0.75rem;color:var(--text-3)">
                      {img.caption && <span>{img.caption}</span>}
                      {img.caption && img.source_attribution && <span> · </span>}
                      {img.source_attribution && <span style="font-style:italic">{img.source_attribution}</span>}
                    </div>
                  )}
                </div>
              </button>
            ))}
          </div>
        </section>
      )}

      {miracle.location_lat && miracle.location_lng && (
        <section class="mb-9 pb-9 section-rule">
          <h2 class="eyebrow mb-4">{miracle.location_2_lat && miracle.location_2_lng ? "Locations" : "Location"}</h2>
          <div id="miracle-map" role="region" aria-label={`Map of ${[miracle.location_name, miracle.location_2_name].filter(Boolean).join(" and ") || "the miracle location"}`} style="height:320px;width:100%;background:var(--bg-elevated)"></div>
          <ul style="margin-top:0.6rem;list-style:none;padding:0;font-family:var(--font-sans);font-size:0.78rem;color:var(--text-3)">
            <li>{[miracle.location_name, miracle.country].filter(Boolean).join(", ")}</li>
            {miracle.location_2_name && <li>{miracle.location_2_name}</li>}
          </ul>
        </section>
      )}

      {relatedMiracles.length > 0 && (
        <section class="mb-9 pb-9 section-rule">
          <h2 class="eyebrow mb-5">Related Miracles</h2>
          <ul class="space-y-2">
            {relatedMiracles.map((r) => (
              <li>
                <a href={`/miracles/${r.slug}`} style="font-family:var(--font-sans);font-size:0.875rem;color:var(--color-accent)">{r.title}</a>
                <span style="font-family:var(--font-sans);font-size:0.7rem;color:var(--text-4);margin-left:0.6rem">{fmt(r.type)}</span>
                {relatedSaintsMap.get(r.id)?.length && (
                  <span style="font-family:var(--font-sans);font-size:0.7rem;color:var(--text-4);margin-left:0.4rem">· {relatedSaintsMap.get(r.id)!.join(", ")}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}

      {sources.length > 0 && (
        <section>
          <h2 class="eyebrow mb-5">Sources</h2>
          <ul class="space-y-3" style="margin-bottom:1.5rem">
            {sources.map((s) => (
              <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
                {s.source_type === 'vatican_decree' ? (
                  <span class="approval-badge vatican" style="font-size:0.58rem">{fmt(s.source_type)}</span>
                ) : (
                  <span style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;white-space:nowrap;color:var(--text-4)">{fmt(s.source_type)}</span>
                )}
                {safeHttpUrl(s.url) ? (
                  <a href={s.url} target="_blank" rel="noopener" style="font-family:var(--font-sans);font-size:0.85rem">{s.title ?? s.url} ↗</a>
                ) : (
                  <span style="font-family:var(--font-sans);font-size:0.85rem;color:var(--text-3)">{s.title}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    </div>

  {miracle.location_lat && miracle.location_lng && (
    <>
      <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
      <script is:inline define:vars={{
        lat: miracle.location_lat,
        lng: miracle.location_lng,
        locationName: miracle.location_name,
        lat2: miracle.location_2_lat,
        lng2: miracle.location_2_lng,
        locationName2: miracle.location_2_name,
        country: miracle.country,
        maptilerKey: env.MAPTILER_API_KEY,
      }}>
        function escHtml(s) {
          return String(s ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
        }
        const map = L.map('miracle-map').setView([Number(lat), Number(lng)], 7);
        L.tileLayer(`https://api.maptiler.com/maps/basic-v2/{z}/{x}/{y}.png?key=${maptilerKey}`, {
          attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors © <a href="https://www.maptiler.com/copyright/">MapTiler</a>',
          maxZoom: 19,
        }).addTo(map);
        const label = [locationName, country].filter(Boolean).map(escHtml).join(', ');
        const marker = L.marker([Number(lat), Number(lng)]).addTo(map);
        if (label) marker.bindPopup(label);
        if (lat2 != null && lng2 != null) {
          const label2 = (locationName2 ? escHtml(locationName2) : null);
          const marker2 = L.marker([Number(lat2), Number(lng2)]).addTo(map);
          if (label2) marker2.bindPopup(label2);
          L.polyline([[Number(lat), Number(lng)], [Number(lat2), Number(lng2)]], {
            color: "#8b4513",
            weight: 2,
            dashArray: "6,6",
            opacity: 0.7,
          }).addTo(map);
          map.fitBounds([[Number(lat), Number(lng)], [Number(lat2), Number(lng2)]], { padding: [40, 40] });
        } else if (label) {
          marker.openPopup();
        }
      </script>
    </>
  )}

  <dialog id="lb" aria-label="Image viewer">
    <button id="lb-close" aria-label="Close">✕</button>
    <img id="lb-img" src="" alt="" />
    <div id="lb-meta">
      <p id="lb-caption"></p>
      <p id="lb-attr"></p>
    </div>
    <div id="lb-nav">
      <button id="lb-prev" aria-label="Previous image">&#8592;</button>
      <span id="lb-counter" aria-hidden="true"></span>
      <button id="lb-next" aria-label="Next image">&#8594;</button>
    </div>
    <p id="lb-status" class="sr-only" role="status"></p>
  </dialog>

  <script is:inline define:vars={{ lbImages: images, miracleTitle: miracle.title }}>
    const lb = document.getElementById('lb');
    const lbImg = document.getElementById('lb-img');
    const lbCaption = document.getElementById('lb-caption');
    const lbAttr = document.getElementById('lb-attr');
    const lbCounter = document.getElementById('lb-counter');
    const lbNav = document.getElementById('lb-nav');
    const lbStatus = document.getElementById('lb-status');

    let currentIndex = 0;
    let opener = null;

    function showImage(index, announce) {
      const img = lbImages[index];
      const position = lbImages.length > 1 ? `Image ${index + 1} of ${lbImages.length}` : 'Image';
      lbImg.src = img.url;
      lbImg.alt = img.caption || miracleTitle;
      lbCaption.textContent = img.caption || '';
      lbAttr.textContent = img.source_attribution || '';
      lbCounter.textContent = `${index + 1} / ${lbImages.length}`;
      // The dialog name is read on open; prev/next write one polite status instead.
      lb.setAttribute('aria-label', `Image viewer, ${position.toLowerCase()}`);
      if (announce) lbStatus.textContent = img.caption ? `${position}. ${img.caption}` : position;
      currentIndex = index;
    }

    function step(delta) {
      if (lbImages.length < 2) return;
      showImage((currentIndex + delta + lbImages.length) % lbImages.length, true);
    }

    lbImg.addEventListener('error', () => {
      lbCaption.textContent = 'This image could not be loaded.';
      lbStatus.textContent = 'This image could not be loaded.';
    });

    function openLightbox(index) {
      lbStatus.textContent = '';
      showImage(index, false);
      lbNav.style.display = lbImages.length > 1 ? 'flex' : 'none';
      const scrollY = window.scrollY;
      lb.showModal();
      window.scrollTo(0, scrollY);
    }

    document.querySelectorAll('.lb-trigger').forEach((btn, i) => {
      btn.addEventListener('click', () => { opener = btn; openLightbox(i); });
    });

    document.getElementById('lb-close').addEventListener('click', () => lb.close());
    document.getElementById('lb-prev').addEventListener('click', () => step(-1));
    document.getElementById('lb-next').addEventListener('click', () => step(1));

    lb.addEventListener('close', () => { if (opener) opener.focus(); });

    lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });

    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') step(1);
      if (e.key === 'ArrowLeft') step(-1);
    });
  </script>

  <style>
    .lb-trigger {
      display: block;
      width: 100%;
      cursor: zoom-in;
      border: none;
      background: none;
      padding: 0;
      text-align: left;
    }
    #lb {
      border: none;
      background: transparent;
      padding: 1.5rem;
      max-width: min(90vw, 1100px);
      max-height: 90vh;
      margin: auto;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }
    #lb[open] {
      display: flex;
    }
    #lb::backdrop {
      background: rgba(0, 0, 0, 0.88);
    }
    #lb-img {
      max-width: 100%;
      max-height: calc(90vh - 6rem);
      object-fit: contain;
      display: block;
    }
    #lb-close {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      background: rgba(0, 0, 0, 0.6);
      color: #fff;
      border: none;
      border-radius: 50%;
      width: 2rem;
      height: 2rem;
      cursor: pointer;
      font-size: 1rem;
      line-height: 2rem;
    }
    #lb :focus-visible {
      outline: 2px solid #fff;
      outline-offset: 2px;
    }
    #lb-meta {
      text-align: center;
      color: #ccc;
      font-size: 0.8rem;
      font-family: var(--font-sans);
    }
    #lb-meta p { margin: 0; }
    #lb-attr { font-style: italic; opacity: 0.7; }
    #lb-nav {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin-top: 0.25rem;
    }
    #lb-nav button {
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      border: none;
      border-radius: 50%;
      width: 2.25rem;
      height: 2.25rem;
      cursor: pointer;
      font-size: 1.1rem;
      line-height: 2.25rem;
    }
    #lb-nav button:hover { background: rgba(255, 255, 255, 0.3); }
    #lb-counter {
      color: #ccc;
      font-size: 0.8rem;
      font-family: var(--font-sans);
      min-width: 3rem;
      text-align: center;
    }
  </style>

</Base>
