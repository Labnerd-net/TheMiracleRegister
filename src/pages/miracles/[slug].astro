---
import Base from "../../layouts/Base.astro";
import { createDb } from "../../db";
import { miracles, saints, miracleSaints, miracleSources } from "../../db/schema";
import { and, eq, inArray, ne, sql } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { renderMarkdown } from "../../lib/markdown";

const { slug } = Astro.params;
const db = createDb(env.DATABASE_URL);

const [miracle] = await db.select({
  id: miracles.id,
  title: miracles.title,
  miracle_category: miracles.miracle_category,
  type: miracles.type,
  date_of_event: miracles.date_of_event,
  date_precision: miracles.date_precision,
  location_name: miracles.location_name,
  location_lat: miracles.location_lat,
  location_lng: miracles.location_lng,
  country: miracles.country,
  recipient_privacy: miracles.recipient_privacy,
  recipient_name: miracles.recipient_name,
  recipient_age_at_event: miracles.recipient_age_at_event,
  recipient_country: miracles.recipient_country,
  used_for_beatification: miracles.used_for_beatification,
  used_for_canonization: miracles.used_for_canonization,
  topics: miracles.topics,
  vatican_medical_board_verdict: miracles.vatican_medical_board_verdict,
  medical_diagnosis: miracles.medical_diagnosis,
  cure_details: miracles.cure_details,
  synopsis: miracles.synopsis,
  timing_relative_to_saint_death: miracles.timing_relative_to_saint_death,
  cure_characteristics: miracles.cure_characteristics,
  intercessory_medium: miracles.intercessory_medium,
  was_medically_verified: miracles.was_medically_verified,
  medical_verification_date: miracles.medical_verification_date,
  approval_authority: miracles.approval_authority,
  vatican_decree_date: miracles.vatican_decree_date,
  witness_count: miracles.witness_count,
  image_url: miracles.image_url,
}).from(miracles).where(and(eq(miracles.slug, slug!), eq(miracles.published, true)));
if (!miracle) return Astro.redirect("/404");

const hasTopics = miracle.topics && miracle.topics.length > 0;

const relatedMiracleFields = {
  id: miracles.id,
  slug: miracles.slug,
  title: miracles.title,
  type: miracles.type,
  topics: miracles.topics,
};

const [miracleSaintRows, sources, saintLinked, topicLinked] = await Promise.all([
  db.select({ slug: saints.slug, name: saints.name, canonization_stage: saints.canonization_stage, image_url: saints.image_url })
    .from(miracleSaints)
    .innerJoin(saints, eq(miracleSaints.saint_id, saints.id))
    .where(eq(miracleSaints.miracle_id, miracle.id)),
  db.select({
    url: miracleSources.url,
    title: miracleSources.title,
    source_type: miracleSources.source_type,
    accessed_date: miracleSources.accessed_date,
  }).from(miracleSources).where(eq(miracleSources.miracle_id, miracle.id))
    .then(rows => [...rows].sort((a, b) => (a.source_type === "vatican_decree" ? -1 : b.source_type === "vatican_decree" ? 1 : 0))),
  db.selectDistinct(relatedMiracleFields)
    .from(miracles)
    .innerJoin(miracleSaints, eq(miracleSaints.miracle_id, miracles.id))
    .where(and(
      eq(miracles.published, true),
      ne(miracles.id, miracle.id),
      inArray(miracleSaints.saint_id, db.select({ saint_id: miracleSaints.saint_id }).from(miracleSaints).where(eq(miracleSaints.miracle_id, miracle.id))),
    )),
  hasTopics
    ? db.select(relatedMiracleFields)
        .from(miracles).where(
          and(
            eq(miracles.published, true),
            ne(miracles.id, miracle.id),
            sql`${miracles.topics} && ARRAY[${sql.join(miracle.topics!.map(t => sql`${t}`), sql`, `)}]::text[]`,
          )
        ).limit(10)
    : Promise.resolve([]),
]);

// Saint-linked miracles first, then topic-linked; deduplicate; cap at 5
const seen = new Set<number>([miracle.id]);
const relatedMiracles: typeof saintLinked = [];
for (const m of [...saintLinked, ...topicLinked]) {
  if (!seen.has(m.id) && relatedMiracles.length < 5) {
    seen.add(m.id);
    relatedMiracles.push(m);
  }
}

const fmt = (s: string) => s.replace(/_/g, " ");

function approvalBadge(authority: string | null): { cls: string; label: string } | null {
  if (authority === "vatican_dicastery") return { cls: "vatican", label: "Vatican Approved" };
  if (authority === "lourdes_bureau")    return { cls: "lourdes", label: "Lourdes Bureau" };
  if (authority === "local_bishop")      return { cls: "bishop",  label: "Bishop Approved" };
  if (authority === "nihil_obstat")      return { cls: "nihil",   label: "Nihil Obstat" };
  return null;
}
---

<Base title={miracle.title}>
  {miracle.location_lat && miracle.location_lng && (
    <link slot="head" rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  )}

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-8 py-4">
      <a href="/miracles" style="font-family:var(--font-sans);font-size:0.68rem;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-4);text-decoration:none">← Miracles</a>
    </div>
    <div class="max-w-6xl mx-auto px-4 sm:px-8 pb-10 sm:pb-14 pt-6 lg:grid lg:grid-cols-[1fr_220px] lg:gap-16 lg:items-start">
      <div>
        <div class="flex flex-wrap items-center gap-3 mb-5">
          <span style="font-family:var(--font-sans);font-size:0.65rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4)">{fmt(miracle.miracle_category)} miracle</span>
          <span style="color:var(--rule-mid)">·</span>
          <a href={`/miracles?type=${miracle.type}`} style="font-family:var(--font-sans);font-size:0.65rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);text-decoration:none;border-bottom:1px solid var(--rule)">{fmt(miracle.type)}</a>
          {(() => { const b = approvalBadge(miracle.approval_authority); return b ? <a href={`/miracles?approval_authority=${miracle.approval_authority}`} class={`approval-badge ${b.cls}`} style="text-decoration:none">{b.label}</a> : null; })()}
        </div>
        <h1 style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.5rem);font-weight:300;color:var(--text-1);line-height:1.1;margin-bottom:1.5rem;letter-spacing:-0.01em">{miracle.title}</h1>

        {miracleSaintRows.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {miracleSaintRows.map((saint) => (
              <a href={`/saints/${saint.slug}`} class="inline-flex items-center gap-2.5 no-underline group">
                {saint.image_url && (
                  <div class="w-8 h-8 rounded-full overflow-hidden shrink-0" style="background:var(--bg-elevated)">
                    <img src={saint.image_url} alt={saint.name} class="w-full h-full object-cover object-top" />
                  </div>
                )}
                <span style="font-family:var(--font-sans);font-size:0.82rem;font-weight:500;color:var(--color-accent)" class="group-hover:underline">{saint.name}</span>
                <span class={`stage-badge ${saint.canonization_stage}`}>{saint.canonization_stage}</span>
              </a>
            ))}
          </div>
        )}

        <div class="flex flex-wrap gap-x-8 gap-y-3 mt-7 pt-7" style="border-top:1px solid var(--rule)">
          {miracle.date_of_event && (
            <div>
              <p style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);margin-bottom:0.3rem">Date</p>
              <p style="font-family:var(--font-sans);font-size:0.82rem;color:var(--text-2)">{miracle.date_of_event} <span style="color:var(--text-4);font-size:0.72rem">({fmt(miracle.date_precision)})</span></p>
            </div>
          )}
          {miracle.country && (
            <div>
              <p style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);margin-bottom:0.3rem">Location</p>
              <p style="font-family:var(--font-sans);font-size:0.82rem;color:var(--text-2)">{miracle.location_name ?? miracle.country}</p>
            </div>
          )}
          {miracle.recipient_privacy !== "not_applicable" && (
            <div>
              <p style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);margin-bottom:0.3rem">Recipient</p>
              {miracle.recipient_privacy === "confidential" ? (
                <p style="font-family:var(--font-sans);font-size:0.82rem;color:var(--text-4);font-style:italic">Name withheld</p>
              ) : (
                <p style="font-family:var(--font-sans);font-size:0.82rem;color:var(--text-2)">{miracle.recipient_name}{miracle.recipient_age_at_event != null ? ` (age ${miracle.recipient_age_at_event})` : ""}</p>
              )}
              {miracle.recipient_country && miracle.recipient_country !== miracle.country && (
                <p style="font-family:var(--font-sans);font-size:0.72rem;color:var(--text-4);margin-top:0.2rem">from {miracle.recipient_country}</p>
              )}
            </div>
          )}
          {(miracle.used_for_beatification || miracle.used_for_canonization) && (
            <div>
              <p style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);margin-bottom:0.3rem">Used For</p>
              <div class="flex gap-1.5">
                {miracle.used_for_beatification && <span class="used-badge">Beatification</span>}
                {miracle.used_for_canonization && <span class="used-badge">Canonization</span>}
              </div>
            </div>
          )}
        </div>
      </div>

      <div class="mt-8 lg:mt-0">
        {miracle.image_url && (
          <div class="mb-6 rounded overflow-hidden" style="background:var(--bg-elevated)">
            <img src={miracle.image_url} alt={miracle.title} class="w-full object-cover" style="max-height:220px;object-position:center top" />
          </div>
        )}
        {miracle.topics && miracle.topics.length > 0 && (
          <>
            <p class="eyebrow mb-4">Topics</p>
            <div class="flex flex-wrap gap-1.5">
              {miracle.topics.map((t) => <a href={`/search?q=${encodeURIComponent(t)}`} class="tag" style="text-decoration:none">{t}</a>)}
            </div>
          </>
        )}
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-10 sm:py-14 lg:grid lg:grid-cols-[1fr_240px] lg:gap-12">

    <aside class="mb-8 lg:mb-0 lg:col-start-2 lg:row-start-1">
      <div class="card p-5 lg:sticky lg:top-24">
        <p class="eyebrow mb-5">Full Record</p>
        <dl class="meta-grid">
          <dt>Category</dt><dd>{fmt(miracle.miracle_category)}</dd>
          <dt>Type</dt><dd>{fmt(miracle.type)}</dd>
          {miracle.timing_relative_to_saint_death !== "not_applicable" && (
            <><dt>Timing</dt><dd>{fmt(miracle.timing_relative_to_saint_death)}</dd></>
          )}
          {miracle.cure_characteristics !== "not_applicable" && (
            <><dt>Cure</dt><dd>{fmt(miracle.cure_characteristics)}</dd></>
          )}
          {miracle.intercessory_medium !== "not_applicable" && (
            <><dt>Medium</dt><dd>{fmt(miracle.intercessory_medium)}</dd></>
          )}
          <dt>Verified</dt><dd>{miracle.was_medically_verified ? "Yes" : "No"}</dd>
          {miracle.medical_verification_date && (
            <><dt>Verified On</dt><dd>{miracle.medical_verification_date}</dd></>
          )}
          {miracle.approval_authority !== "none" && (
            <><dt>Approved by</dt><dd>{fmt(miracle.approval_authority)}</dd></>
          )}
          {miracle.witness_count && (
            <><dt>Witnesses</dt><dd>{miracle.witness_count.toLocaleString()}</dd></>
          )}
          {miracle.vatican_decree_date && (
            <><dt>Decree</dt><dd>{miracle.vatican_decree_date}</dd></>
          )}
        </dl>
      </div>
    </aside>

    <div class="lg:col-start-1 lg:row-start-1">
      {miracle.vatican_medical_board_verdict && (
        <blockquote class="pl-6 mb-11" style="border-left:2px solid var(--color-gold)">
          <p style="font-family:var(--font-display);font-size:1.35rem;font-weight:300;font-style:italic;color:var(--text-2);line-height:1.55;margin-bottom:0.6rem">{miracle.vatican_medical_board_verdict}</p>
          <footer style="font-family:var(--font-sans);font-size:0.65rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4)">Vatican Medical Board</footer>
        </blockquote>
      )}

      {miracle.medical_diagnosis && (
        <section class="mb-9 pb-9 section-rule">
          <p class="eyebrow mb-4">Medical Diagnosis</p>
          <p style="font-family:var(--font-sans);font-size:0.875rem;color:var(--text-3);line-height:1.8">{miracle.medical_diagnosis}</p>
        </section>
      )}

      {miracle.cure_details && (
        <section class="mb-9 pb-9 section-rule">
          <p class="eyebrow mb-4">Cure Details</p>
          <div class="prose" set:html={renderMarkdown(miracle.cure_details)} />
        </section>
      )}

      {miracle.synopsis && (
        <section class="mb-9 pb-9 section-rule">
          <p class="eyebrow mb-5">Synopsis</p>
          <div class="prose" set:html={renderMarkdown(miracle.synopsis)} />
        </section>
      )}

      {miracle.location_lat && miracle.location_lng && (
        <section class="mb-9 pb-9 section-rule">
          <p class="eyebrow mb-4">Location</p>
          <div id="miracle-map" style="height:320px;width:100%;background:var(--bg-elevated)"></div>
        </section>
      )}

      {relatedMiracles.length > 0 && (
        <section class="mb-9 pb-9 section-rule">
          <p class="eyebrow mb-5">Related Miracles</p>
          <ul class="space-y-2">
            {relatedMiracles.map((r) => (
              <li>
                <a href={`/miracles/${r.slug}`} style="font-family:var(--font-sans);font-size:0.875rem;color:var(--color-accent)">{r.title}</a>
                <span style="font-family:var(--font-sans);font-size:0.7rem;color:var(--text-4);margin-left:0.6rem">{fmt(r.type)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {sources.length > 0 && (
        <section>
          <p class="eyebrow mb-5">Sources</p>
          <ul class="space-y-3" style="margin-bottom:1.5rem">
            {sources.map((s) => (
              <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
                {s.source_type === 'vatican_decree' ? (
                  <span class="approval-badge vatican" style="font-size:0.58rem">{fmt(s.source_type)}</span>
                ) : (
                  <span style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;white-space:nowrap;color:var(--text-4)">{fmt(s.source_type)}</span>
                )}
                {s.url ? (
                  <a href={s.url} target="_blank" rel="noopener" style="font-family:var(--font-sans);font-size:0.85rem">{s.title ?? s.url} ↗</a>
                ) : (
                  <span style="font-family:var(--font-sans);font-size:0.85rem;color:var(--text-3)">{s.title}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    </div>

  </div>

  {miracle.location_lat && miracle.location_lng && (
    <>
      <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
      <script is:inline define:vars={{
        lat: miracle.location_lat,
        lng: miracle.location_lng,
        locationName: miracle.location_name,
        country: miracle.country,
      }}>
        const map = L.map('miracle-map').setView([Number(lat), Number(lng)], 7);
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
          maxZoom: 19,
        }).addTo(map);
        const label = [locationName, country].filter(Boolean).join(', ');
        const marker = L.marker([Number(lat), Number(lng)]).addTo(map);
        if (label) marker.bindPopup(label).openPopup();
      </script>
    </>
  )}

</Base>
