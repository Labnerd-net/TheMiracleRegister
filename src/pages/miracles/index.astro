---
import Base from "../../layouts/Base.astro";
import FilterBar from "../../components/FilterBar.astro";
import FilterSelect from "../../components/FilterSelect.astro";
import MiracleCard from "../../components/MiracleCard.astro";
import { PAGE_DESCRIPTIONS } from "../../lib/seo";
import { humanizeSnakeCase } from "../../lib/format";
import { paginationHtml } from "../../lib/cards";
import { fetchSaintsByMiracle, miracleFilterConditions } from "../../lib/queries/miracles";
import { createDb } from "../../db";
import { miracles, saints } from "../../db/schema";
import { miracleType, miracleCategory, approvalAuthority } from "../../db/schema/enums";
import { MIRACLE_TOPICS } from "../../db/topics";
import { and, asc, count, eq, isNotNull, sql } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { CACHE_CONTENT } from "../../lib/cache";

const PAGE_SIZE = 20;

// Filter params
const sp = Astro.url.searchParams;
const rawPage = parseInt(sp.get("page") ?? "1");
const page = Math.max(1, isNaN(rawPage) ? 1 : rawPage);
const offset = (page - 1) * PAGE_SIZE;

const filterSaintId   = parseInt(sp.get("saint_id") ?? "") || undefined;
const rawType = sp.get("type") ?? "";
const filterType = (miracleType.enumValues as string[]).includes(rawType) ? rawType as typeof miracleType.enumValues[number] : undefined;
const filterCountry   = sp.get("country") || undefined;
const filterYearFrom  = parseInt(sp.get("year_from") ?? "") || undefined;
const filterYearTo    = parseInt(sp.get("year_to") ?? "") || undefined;
const filterBeat      = sp.get("beatification") === "1";
const filterCanon     = sp.get("canonization") === "1";
const rawApproval = sp.get("approval_authority") ?? "";
const filterApproval = (approvalAuthority.enumValues as string[]).includes(rawApproval) ? rawApproval as typeof approvalAuthority.enumValues[number] : undefined;
const rawTopic = sp.get("topic") ?? "";
const filterTopic = (MIRACLE_TOPICS as readonly string[]).includes(rawTopic) ? rawTopic : undefined;
const rawCategory = sp.get("category") ?? "";
const filterCategory = (miracleCategory.enumValues as string[]).includes(rawCategory) ? rawCategory as typeof miracleCategory.enumValues[number] : undefined;
const hasActiveFilters = !!(filterSaintId || filterType || filterTopic || filterCategory || filterCountry || filterYearFrom || filterYearTo || filterBeat || filterCanon || filterApproval);

Astro.response.headers.set("Cache-Control", CACHE_CONTENT);

const db = createDb(env.DATABASE_URL);

const conditions = miracleFilterConditions(db, {
  saint_id: filterSaintId,
  type: filterType,
  topic: filterTopic,
  category: filterCategory,
  country: filterCountry,
  year_from: filterYearFrom,
  year_to: filterYearTo,
  used_for_beatification: filterBeat,
  used_for_canonization: filterCanon,
  approval_authority: filterApproval,
});
const where = and(...conditions);

const [[{ total }], pageMiracles, allSaints, countryRows] = await Promise.all([
  db.select({ total: count() }).from(miracles).where(where),
  db
    .select({
      id: miracles.id,
      slug: miracles.slug,
      title: miracles.title,
      type: miracles.type,
      topics: miracles.topics,
      date_of_event: miracles.date_of_event,
      country: miracles.country,
      cure_details: miracles.cure_details,
      used_for_beatification: miracles.used_for_beatification,
      used_for_canonization: miracles.used_for_canonization,
      approval_authority: miracles.approval_authority,
    })
    .from(miracles)
    .where(where)
    .orderBy(sql`${miracles.date_of_event} asc nulls last`)
    .limit(PAGE_SIZE)
    .offset(offset),
  db.select({ id: saints.id, name: saints.name }).from(saints).where(eq(saints.published, true)).orderBy(asc(saints.name)),
  db.selectDistinct({ country: miracles.country }).from(miracles).where(and(eq(miracles.published, true), isNotNull(miracles.country))).orderBy(asc(miracles.country)),
]);

const countries = countryRows.map(r => r.country).filter(Boolean) as string[];

const saintsByMiracle = await fetchSaintsByMiracle(db, pageMiracles.map((m) => m.id));
const saintNamesByMiracle = new Map<number, string[]>(
  [...saintsByMiracle].map(([id, list]) => [id, list.map((s) => s.name)])
);

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
if (page > totalPages) return Astro.redirect(buildUrl(totalPages));

function buildUrl(p: number) {
  const params = new URLSearchParams();
  if (filterSaintId) params.set("saint_id", String(filterSaintId));
  if (filterType) params.set("type", filterType);
  if (filterTopic) params.set("topic", filterTopic);
  if (filterCategory) params.set("category", filterCategory);
  if (filterCountry) params.set("country", filterCountry);
  if (filterYearFrom) params.set("year_from", String(filterYearFrom));
  if (filterYearTo) params.set("year_to", String(filterYearTo));
  if (filterBeat) params.set("beatification", "1");
  if (filterCanon) params.set("canonization", "1");
  if (filterApproval) params.set("approval_authority", filterApproval);
  params.set("page", String(p));
  return `/miracles?${params.toString()}`;
}

---

<Base title="Miracles" description={PAGE_DESCRIPTIONS.miracles}>

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
      <p class="eyebrow mb-4">The Register</p>
      <h1 id="page-title" tabindex="-1" style="font-family:var(--font-display);font-size:clamp(2.5rem,5vw,4rem);font-weight:300;color:var(--text-1);line-height:1.05;letter-spacing:-0.01em">Miracles</h1>
      <p data-browse-count style="font-family:var(--font-sans);font-size:0.8rem;color:var(--text-4);margin-top:0.6rem;letter-spacing:0.02em">{total} miracles recorded</p>
      <p data-browse-status class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

    <FilterBar action="/miracles" hasActiveFilters={hasActiveFilters}>
      <FilterSelect id="f-saint" name="saint_id" label="Saint" allLabel="All Saints" options={allSaints.map((s) => ({ value: s.id, label: s.name }))} selected={filterSaintId} />
      <FilterSelect id="f-type" name="type" label="Type" allLabel="All Types" options={miracleType.enumValues.map((t) => ({ value: t, label: humanizeSnakeCase(t) }))} selected={filterType} />
      <FilterSelect id="f-topic" name="topic" label="Topic" allLabel="All Topics" options={MIRACLE_TOPICS.map((t) => ({ value: t, label: humanizeSnakeCase(t) }))} selected={filterTopic} />
      <FilterSelect id="f-category" name="category" label="Category" allLabel="All Categories" options={miracleCategory.enumValues.map((c) => ({ value: c, label: humanizeSnakeCase(c) }))} selected={filterCategory} />
      <FilterSelect id="f-country" name="country" label="Country" allLabel="All Countries" options={countries.map((c) => ({ value: c, label: c }))} selected={filterCountry} />

      <div class="filter-group filter-group--year">
        <span class="filter-label" id="f-year-label">Year</span>
        <div class="year-range" role="group" aria-labelledby="f-year-label">
          <input type="number" name="year_from" value={filterYearFrom ?? ""} placeholder="From" aria-label="Year from" min="1000" max="2100" class="filter-input filter-input--year" />
          <span class="year-sep">–</span>
          <input type="number" name="year_to" value={filterYearTo ?? ""} placeholder="To" aria-label="Year to" min="1000" max="2100" class="filter-input filter-input--year" />
        </div>
      </div>

      <FilterSelect
        id="f-approval"
        name="approval_authority"
        label="Approval"
        allLabel="All Approvals"
        options={[
          { value: "vatican_dicastery", label: "Vatican Approved" },
          { value: "lourdes_bureau", label: "Lourdes Bureau" },
          { value: "local_bishop", label: "Bishop Approved" },
          { value: "nihil_obstat", label: "Nihil Obstat" },
        ]}
        selected={filterApproval}
      />

      <div class="filter-group filter-group--checks">
        <span class="filter-label" id="f-used-label">Used for</span>
        <div class="check-row" role="group" aria-labelledby="f-used-label">
          <label class="check-label">
            <input type="checkbox" name="beatification" value="1" checked={filterBeat} class="filter-check" />
            Beatification
          </label>
          <label class="check-label">
            <input type="checkbox" name="canonization" value="1" checked={filterCanon} class="filter-check" />
            Canonization
          </label>
        </div>
      </div>
    </FilterBar>

    <div data-browse-results class="space-y-2 mt-6">
      {pageMiracles.length === 0 ? (
        <p class="empty-state">No miracles match the selected filters.</p>
      ) : pageMiracles.map((m) => (
        <MiracleCard miracle={m} saintNames={saintNamesByMiracle.get(m.id) ?? []} />
      ))}
    </div>

    <nav data-browse-pagination class="pagination" aria-label="Page navigation" hidden={totalPages <= 1} set:html={paginationHtml(page, totalPages, buildUrl)} />
  </div>

</Base>

<script>
import { initBrowse } from "../../scripts/browse";
import { miracleCardHtml } from "../../lib/cards";
import type { MiracleListItem } from "../../api/schemas";

initBrowse<MiracleListItem>({
  fields: [
    { form: "saint_id" },
    { form: "type" },
    { form: "topic" },
    { form: "category" },
    { form: "country" },
    { form: "year_from" },
    { form: "year_to" },
    { form: "beatification", api: "used_for_beatification" },
    { form: "canonization", api: "used_for_canonization" },
    { form: "approval_authority" },
  ],
  apiPath: "/api/v1/miracles",
  pagePath: "/miracles",
  pageSize: 20,
  noun: { singular: "miracle", plural: "miracles", suffix: "recorded" },
  emptyHtml: `<p class="empty-state">No miracles match the selected filters.</p>`,
  renderItems: (items) => items.map((m) => miracleCardHtml(m, m.saints.map((s) => s.name))).join(""),
  debounceNumbers: true,
});
</script>

