---
import Base from "../../layouts/Base.astro";
import { createDb } from "../../db";
import { miracles, miracleSaints, saints } from "../../db/schema";
import { asc, count, eq, inArray } from "drizzle-orm";
import { env } from "cloudflare:workers";

const PAGE_SIZE = 20;
const rawPage = parseInt(Astro.url.searchParams.get("page") ?? "1");
const page = Math.max(1, isNaN(rawPage) ? 1 : rawPage);
const offset = (page - 1) * PAGE_SIZE;

const db = createDb(env.DATABASE_URL);

const [[{ total }], pageMiracles] = await Promise.all([
  db.select({ total: count() }).from(miracles).where(eq(miracles.published, true)),
  db
    .select({
      id: miracles.id,
      slug: miracles.slug,
      title: miracles.title,
      type: miracles.type,
      miracle_category: miracles.miracle_category,
      topics: miracles.topics,
      date_of_event: miracles.date_of_event,
      country: miracles.country,
      was_medically_verified: miracles.was_medically_verified,
      vatican_recognized: miracles.vatican_recognized,
      used_for_beatification: miracles.used_for_beatification,
      used_for_canonization: miracles.used_for_canonization,
      cure_details: miracles.cure_details,
    })
    .from(miracles)
    .where(eq(miracles.published, true))
    .orderBy(asc(miracles.title))
    .limit(PAGE_SIZE)
    .offset(offset),
]);

const miracleIds = pageMiracles.map((m) => m.id);
const saintLinks =
  miracleIds.length > 0
    ? await db
        .select({
          miracle_id: miracleSaints.miracle_id,
          saint_name: saints.name,
        })
        .from(miracleSaints)
        .innerJoin(saints, eq(miracleSaints.saint_id, saints.id))
        .where(inArray(miracleSaints.miracle_id, miracleIds))
    : [];

const saintNamesByMiracle = new Map<number, string[]>();
for (const link of saintLinks) {
  if (!saintNamesByMiracle.has(link.miracle_id)) saintNamesByMiracle.set(link.miracle_id, []);
  saintNamesByMiracle.get(link.miracle_id)!.push(link.saint_name);
}

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
if (page > totalPages) return Astro.redirect(`/miracles?page=${totalPages}`);

const hasPrev = page > 1;
const hasNext = page < totalPages;
---

<Base title="Miracles">

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-8 py-10 sm:py-16">
      <p class="eyebrow mb-4">The Register</p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,5vw,4rem);font-weight:300;color:var(--text-1);line-height:1.05;letter-spacing:-0.01em">Miracles</h1>
      <p style="font-family:var(--font-sans);font-size:0.8rem;color:var(--text-4);margin-top:0.6rem;letter-spacing:0.02em">{total} miracles recorded</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-8 sm:py-12">
    <div class="space-y-2">
      {pageMiracles.map((m) => (
        <a href={`/miracles/${m.slug}`} class="block no-underline group">
          <div class="card px-6 py-5">
            <div class="flex items-start justify-between gap-6">
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2">
                  <span style="font-family:var(--font-sans);font-size:0.68rem;font-weight:600;color:var(--color-accent)">{(saintNamesByMiracle.get(m.id) ?? []).join(", ")}</span>
                  <span style="color:var(--rule-mid)">·</span>
                  <span style="font-family:var(--font-sans);font-size:0.68rem;color:var(--text-4)">{m.type}</span>
                  {m.date_of_event && <><span style="color:var(--rule-mid)">·</span><span style="font-family:var(--font-sans);font-size:0.68rem;color:var(--text-4)">{m.date_of_event}</span></>}
                  {m.country && <><span style="color:var(--rule-mid)">·</span><span style="font-family:var(--font-sans);font-size:0.68rem;color:var(--text-4)">{m.country}</span></>}
                </div>

                <h2 style="font-family:var(--font-display);font-size:1.25rem;font-weight:400;color:var(--text-1);line-height:1.3;margin-bottom:0.5rem;transition:color 0.2s" class="group-hover:text-[--color-accent]">
                  {m.title}
                </h2>

                {m.cure_details && (
                  <p style="font-family:var(--font-sans);font-size:0.78rem;color:var(--text-3);line-height:1.65;margin-bottom:0.5rem">
                    {m.cure_details.length > 140 ? m.cure_details.slice(0, 140) + "…" : m.cure_details}
                  </p>
                )}

                {m.topics && m.topics.length > 0 && (
                  <div class="flex flex-wrap gap-1">
                    {m.topics.slice(0, 5).map((t) => <span class="tag">{t}</span>)}
                    {m.topics.length > 5 && <span class="tag">+{m.topics.length - 5}</span>}
                  </div>
                )}
              </div>

              <div class="shrink-0 flex flex-col gap-1 items-end">
                {m.used_for_beatification && <span class="used-badge">Beatification</span>}
                {m.used_for_canonization && <span class="used-badge">Canonization</span>}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    {totalPages > 1 && (
      <nav class="pagination" aria-label="Page navigation">
        {hasPrev
          ? <a href={`/miracles?page=${page - 1}`} class="pagination-btn">← Previous</a>
          : <span class="pagination-btn disabled">← Previous</span>
        }
        <span class="pagination-info">Page {page} of {totalPages}</span>
        {hasNext
          ? <a href={`/miracles?page=${page + 1}`} class="pagination-btn">Next →</a>
          : <span class="pagination-btn disabled">Next →</span>
        }
      </nav>
    )}
  </div>

</Base>

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule-light);
  }
  .pagination-btn {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    letter-spacing: 0.03em;
  }
  .pagination-btn:hover { text-decoration: underline; }
  .pagination-btn.disabled {
    color: var(--text-4);
    cursor: default;
  }
  .pagination-info {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--text-3);
  }
</style>
