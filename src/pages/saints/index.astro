---
import Base from "../../layouts/Base.astro";
import { createDb } from "../../db";
import { saints } from "../../db/schema";
import { asc } from "drizzle-orm";

import { env } from "cloudflare:workers";
const db = createDb(env.DATABASE_URL);

const allSaints = await db
  .select({
    slug: saints.slug,
    name: saints.name,
    feast_day: saints.feast_day,
    nationality: saints.nationality,
    canonization_stage: saints.canonization_stage,
    total_attributed_miracles: saints.total_attributed_miracles,
  })
  .from(saints)
  .orderBy(asc(saints.name));
---

<Base title="Saints">
  <h1>Saints</h1>
  <p class="meta">{allSaints.length} saints in the register</p>

  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Feast Day</th>
        <th>Nationality</th>
        <th>Stage</th>
        <th>Miracles</th>
      </tr>
    </thead>
    <tbody>
      {allSaints.map((s) => (
        <tr>
          <td><a href={`/saints/${s.slug}`}>{s.name}</a></td>
          <td>{s.feast_day ?? "—"}</td>
          <td>{s.nationality ?? "—"}</td>
          <td><span class="badge">{s.canonization_stage}</span></td>
          <td>{s.total_attributed_miracles ?? "—"}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
