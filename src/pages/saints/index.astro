---
import Base from "../../layouts/Base.astro";
import SaintCard from "../../components/SaintCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import FilterSelect from "../../components/FilterSelect.astro";
import { PAGE_DESCRIPTIONS } from "../../lib/seo";
import { createDb } from "../../db";
import { saints } from "../../db/schema";
import { canonizationStage } from "../../db/schema/enums";
import { SAINT_THEMES } from "../../db/topics";
import { humanizeSnakeCase } from "../../lib/format";
import { paginationHtml } from "../../lib/cards";
import { asc, count, eq, and, isNotNull } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { CACHE_CONTENT } from "../../lib/cache";
import { saintFilterConditions } from "../../lib/queries/saints";

const PAGE_SIZE = 20;
const sp = Astro.url.searchParams;
const rawPage = parseInt(sp.get("page") ?? "1");
const page = Math.max(1, isNaN(rawPage) ? 1 : rawPage);
const offset = (page - 1) * PAGE_SIZE;

const rawStage = sp.get("canonization_stage") ?? "";
const filterStage = (canonizationStage.enumValues as string[]).includes(rawStage)
  ? rawStage as typeof canonizationStage.enumValues[number]
  : undefined;
const rawTheme = sp.get("theme") ?? "";
const filterTheme = (SAINT_THEMES as readonly string[]).includes(rawTheme) ? rawTheme : undefined;
const filterOrder = sp.get("religious_order") || undefined;
const filterNationality = sp.get("nationality") || undefined;
const hasActiveFilters = !!(filterStage || filterTheme || filterOrder || filterNationality);

Astro.response.headers.set("Cache-Control", CACHE_CONTENT);

const db = createDb(env.DATABASE_URL);

const conditions = saintFilterConditions({
  canonization_stage: filterStage,
  theme: filterTheme,
  religious_order: filterOrder,
  nationality: filterNationality,
});
const where = and(...conditions);

const [[{ total }], pageSaints, orderRows, nationalityRows] = await Promise.all([
  db.select({ total: count() }).from(saints).where(where),
  db
    .select({
      slug: saints.slug,
      name: saints.name,
      birth_name: saints.birth_name,
      feast_day: saints.feast_day,
      nationality: saints.nationality,
      canonization_stage: saints.canonization_stage,
      image_url: saints.image_url,
      death_date: saints.death_date,
      canonization_date: saints.canonization_date,
    })
    .from(saints)
    .where(where)
    .orderBy(asc(saints.name))
    .limit(PAGE_SIZE)
    .offset(offset),
  db
    .selectDistinct({ religious_order: saints.religious_order })
    .from(saints)
    .where(and(eq(saints.published, true), isNotNull(saints.religious_order)))
    .orderBy(asc(saints.religious_order)),
  db
    .selectDistinct({ nationality: saints.nationality })
    .from(saints)
    .where(and(eq(saints.published, true), isNotNull(saints.nationality)))
    .orderBy(asc(saints.nationality)),
]);

const religiousOrders = orderRows.map(r => r.religious_order as string);
const nationalities = nationalityRows.map(r => r.nationality as string);

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
if (page > totalPages) return Astro.redirect(buildUrl(totalPages));

function buildUrl(p: number) {
  const params = new URLSearchParams();
  if (filterStage) params.set("canonization_stage", filterStage);
  if (filterTheme) params.set("theme", filterTheme);
  if (filterOrder) params.set("religious_order", filterOrder);
  if (filterNationality) params.set("nationality", filterNationality);
  params.set("page", String(p));
  return `/saints?${params.toString()}`;
}
---

<Base title="Saints" description={PAGE_DESCRIPTIONS.saints}>

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
      <p class="eyebrow mb-4">The Register</p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,5vw,4rem);font-weight:300;color:var(--text-1);line-height:1.05;letter-spacing:-0.01em" id="page-title" tabindex="-1">Saints</h1>
      <p data-browse-count style="font-family:var(--font-sans);font-size:0.8rem;color:var(--text-4);margin-top:0.6rem;letter-spacing:0.02em">{total} saints documented</p>
      <p data-browse-status class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

    <FilterBar action="/saints" hasActiveFilters={hasActiveFilters}>
      <FilterSelect
        id="f-stage"
        name="canonization_stage"
        label="Stage"
        allLabel="All Stages"
        options={[
          { value: "saint", label: "Saint" },
          { value: "blessed", label: "Blessed" },
          { value: "venerable", label: "Venerable" },
          { value: "servant_of_god", label: "Servant of God" },
        ]}
        selected={filterStage}
      />
      <FilterSelect id="f-theme" name="theme" label="Theme" allLabel="All Themes" options={SAINT_THEMES.map((t) => ({ value: t, label: humanizeSnakeCase(t) }))} selected={filterTheme} />
      <FilterSelect id="f-order" name="religious_order" label="Religious Order" allLabel="All Orders" options={religiousOrders.map((o) => ({ value: o, label: o }))} selected={filterOrder} />
      <FilterSelect id="f-nationality" name="nationality" label="Nationality" allLabel="All Nationalities" options={nationalities.map((n) => ({ value: n, label: n }))} selected={filterNationality} />
    </FilterBar>

    <div data-browse-results class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10 mt-8">
      {pageSaints.length === 0 ? (
        <p class="empty-state col-span-full">No saints match the selected filters.</p>
      ) : pageSaints.map((s, i) => (
        <SaintCard saint={s} eager={i < 4} />
      ))}
    </div>

    <nav data-browse-pagination class="pagination" aria-label="Page navigation" hidden={totalPages <= 1} set:html={paginationHtml(page, totalPages, buildUrl)} />
  </div>

</Base>

<script>
import { initBrowse } from "../../scripts/browse";
import { saintCardHtml } from "../../lib/cards";
import type { SaintListItem } from "../../api/schemas";

initBrowse<SaintListItem>({
  fields: [
    { form: "canonization_stage" },
    { form: "theme" },
    { form: "religious_order" },
    { form: "nationality" },
  ],
  apiPath: "/api/v1/saints",
  pagePath: "/saints",
  pageSize: 20,
  noun: { singular: "saint", plural: "saints", suffix: "documented" },
  emptyHtml: `<p class="empty-state col-span-full">No saints match the selected filters.</p>`,
  renderItems: (items) => items.map((s, i) => saintCardHtml(s, { eager: i < 4 })).join(""),
});
</script>
