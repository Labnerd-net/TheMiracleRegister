---
import Base from "../../layouts/Base.astro";
import { createDb } from "../../db";
import { saints, miracles, miracleSaints, saintRelations, saintSources, saintLocations } from "../../db/schema";
import { asc, and, eq } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { renderMarkdown } from "../../lib/markdown";

const { slug } = Astro.params;
const db = createDb(env.DATABASE_URL);

const [saint] = await db.select().from(saints).where(and(eq(saints.slug, slug!), eq(saints.published, true)));
if (!saint) return Astro.redirect("/404");

const [saintMiracles, relatedRows, sources, locations] = await Promise.all([
  db.select({
    slug: miracles.slug,
    title: miracles.title,
    type: miracles.type,
    miracle_category: miracles.miracle_category,
    topics: miracles.topics,
    date_of_event: miracles.date_of_event,
    date_precision: miracles.date_precision,
    country: miracles.country,
    recipient_name: miracles.recipient_name,
    medical_diagnosis: miracles.medical_diagnosis,
    was_medically_verified: miracles.was_medically_verified,
    vatican_recognized: miracles.vatican_recognized,
    used_for_beatification: miracles.used_for_beatification,
    used_for_canonization: miracles.used_for_canonization,
    cure_details: miracles.cure_details,
  }).from(miracles)
    .innerJoin(miracleSaints, eq(miracles.id, miracleSaints.miracle_id))
    .where(and(eq(miracleSaints.saint_id, saint.id), eq(miracles.published, true))),
  db.select({
    id: saints.id, slug: saints.slug, name: saints.name,
    relation_type: saintRelations.relation_type,
  })
  .from(saintRelations)
  .innerJoin(saints, eq(saintRelations.related_saint_id, saints.id))
  .where(eq(saintRelations.saint_id, saint.id)),
  db.select({
    url: saintSources.url,
    title: saintSources.title,
    source_type: saintSources.source_type,
    accessed_date: saintSources.accessed_date,
  }).from(saintSources).where(eq(saintSources.saint_id, saint.id)).orderBy(asc(saintSources.id)),
  db.select({
    id: saintLocations.id,
    location_name: saintLocations.location_name,
    lat: saintLocations.lat,
    lng: saintLocations.lng,
    location_type: saintLocations.location_type,
  }).from(saintLocations).where(eq(saintLocations.saint_id, saint.id)),
]);

const mappableLocations = locations.filter(l => l.lat && l.lng);
const birthLocation = locations.find(l => l.location_type === "birthplace");
const deathLocation = locations.find(l => l.location_type === "death_place");

const sourceTypeLabel: Record<string, string> = {
  vatican_decree: "Vatican",
  news_article: "Press",
  book: "Book",
  academic: "Reference",
  other: "Official Site",
};
---

<Base title={saint.name}>
  {mappableLocations.length > 0 && (
    <link slot="head" rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  )}

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-8 py-4">
      <a href="/saints" style="font-family:var(--font-sans);font-size:0.68rem;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-4);text-decoration:none">
        ← Saints
      </a>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-8 pb-10 sm:pb-16 lg:grid lg:grid-cols-[1fr_280px] lg:gap-16 lg:items-start">
      <div class="pt-8">
        <div class="flex items-center gap-3 mb-6">
          <span class={`stage-badge ${saint.canonization_stage}`}>{saint.canonization_stage}</span>
          {saint.canonization_type && (
            <span style="font-family:var(--font-sans);font-size:0.65rem;color:var(--text-4);letter-spacing:0.04em">{saint.canonization_type.replace(/_/g," ")}</span>
          )}
        </div>
        <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,6vw,4.5rem);font-weight:300;color:var(--text-1);line-height:1.05;margin-bottom:0.6rem;letter-spacing:-0.01em">
          {saint.name}
        </h1>
        {saint.birth_name && saint.birth_name !== saint.name && (
          <p style="font-family:var(--font-sans);font-size:0.8rem;color:var(--text-4);margin-bottom:1.5rem;font-style:italic">{saint.birth_name}</p>
        )}

        <div class="flex flex-wrap gap-x-8 gap-y-3 mt-7 pt-7" style="border-top:1px solid var(--rule)">
          {saint.feast_day && (
            <div>
              <p style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);margin-bottom:0.3rem">Feast Day</p>
              <p style="font-family:var(--font-sans);font-size:0.82rem;color:var(--text-2)">{saint.feast_day}</p>
            </div>
          )}
          {saint.nationality && (
            <div>
              <p style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);margin-bottom:0.3rem">Nationality</p>
              <p style="font-family:var(--font-sans);font-size:0.82rem;color:var(--text-2)">{saint.nationality}</p>
            </div>
          )}
          {saint.religious_order && (
            <div>
              <p style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);margin-bottom:0.3rem">Order</p>
              <p style="font-family:var(--font-sans);font-size:0.82rem;color:var(--text-2)">{saint.religious_order}</p>
            </div>
          )}
          {saint.canonization_date && (
            <div>
              <p style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);margin-bottom:0.3rem">Canonized</p>
              <p style="font-family:var(--font-sans);font-size:0.82rem;color:var(--text-2)">{saint.canonization_date}</p>
            </div>
          )}
          {relatedRows.length > 0 && (
            <div>
              <p style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-4);margin-bottom:0.3rem">Related</p>
              {relatedRows.map((r) => (
                <a href={`/saints/${r.slug}`} style="font-family:var(--font-sans);font-size:0.82rem;display:block">{r.name}</a>
              ))}
            </div>
          )}
        </div>
      </div>

      <div class="mt-8 lg:mt-8">
        {saint.image_url ? (
          <div class="saint-header-img overflow-hidden" style="background:var(--bg-elevated)">
            <img src={saint.image_url} alt={saint.name} class="w-full h-full object-cover object-center" />
          </div>
        ) : (
          <div class="saint-header-img saint-placeholder">
            {saint.name.charAt(0)}
          </div>
        )}

        <div class="card p-5 mt-4 lg:hidden">
          <p class="eyebrow mb-5">Record</p>
          <dl class="meta-grid">
            {saint.birth_date && (
              <><dt>Born</dt><dd>{saint.birth_date}{birthLocation ? <><br/><span style="color:var(--text-4)">{birthLocation.location_name}</span></> : ""}</dd></>
            )}
            {saint.death_date && (
              <><dt>Died</dt><dd>{saint.death_date}{deathLocation ? <><br/><span style="color:var(--text-4)">{deathLocation.location_name}</span></> : ""}</dd></>
            )}
            {saint.beatification_date && (
              <><dt>Beatified</dt><dd>{saint.beatification_date}{saint.beatified_by ? <><br/><span style="color:var(--text-4)">{saint.beatified_by}</span></> : ""}</dd></>
            )}
            {saint.canonization_date && (
              <><dt>Canonized</dt><dd>{saint.canonization_date}{saint.canonized_by ? <><br/><span style="color:var(--text-4)">{saint.canonized_by}</span></> : ""}</dd></>
            )}
            {saint.wikipedia_url && (
              <><dt>External</dt><dd><a href={saint.wikipedia_url} target="_blank" rel="noopener" style="font-size:0.8rem">Wikipedia ↗</a></dd></>
            )}
          </dl>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-10 sm:py-14 lg:grid lg:grid-cols-[1fr_240px] lg:gap-12">

    <div>
      {saint.patronage && saint.patronage.length > 0 && (
        <div class="mb-9 pb-9 section-rule">
          <p class="eyebrow mb-3">Patronage</p>
          <p style="font-family:var(--font-sans);font-size:0.875rem;color:var(--text-3);line-height:1.8">{saint.patronage.join(" · ")}</p>
        </div>
      )}

      {saint.biography_short && (
        <div class="mb-11 pb-11 section-rule">
          <p class="eyebrow mb-5">Biography</p>
          <div class="prose" set:html={renderMarkdown(saint.biography_short)} />
        </div>
      )}

      <div>
        <p class="eyebrow mb-6">Miracles <span style="color:var(--text-5);font-weight:400">({saintMiracles.length})</span></p>
        {saintMiracles.length === 0 ? (
          <p style="font-family:var(--font-sans);font-size:0.875rem;color:var(--text-4)">No miracles recorded.</p>
        ) : (
          <div class="space-y-3">
            {saintMiracles.map((m) => (
              <a href={`/miracles/${m.slug}`} class="block no-underline group">
                <div class="card p-6">
                  <div class="flex items-start justify-between gap-4 mb-3">
                    <h3 style="font-family:var(--font-display);font-size:1.25rem;font-weight:400;color:var(--text-1);line-height:1.3;transition:color 0.2s" class="group-hover:text-[--color-accent]">
                      {m.title}
                    </h3>
                    <div class="shrink-0 flex gap-1.5">
                      {m.used_for_beatification && <span class="used-badge">Beat.</span>}
                      {m.used_for_canonization && <span class="used-badge">Canon.</span>}
                    </div>
                  </div>

                  {m.cure_details && (
                    <p style="font-family:var(--font-sans);font-size:0.8rem;color:var(--text-3);line-height:1.65;margin-bottom:0.75rem">
                      {m.cure_details.length > 160 ? m.cure_details.slice(0, 160) + "…" : m.cure_details}
                    </p>
                  )}

                  <div class="flex flex-wrap items-center gap-3 mb-2">
                    <span style="font-family:var(--font-sans);font-size:0.7rem;color:var(--text-4)">{m.type}</span>
                    {m.country && <span style="font-family:var(--font-sans);font-size:0.7rem;color:var(--text-4)">{m.country}</span>}
                    {m.date_of_event && <span style="font-family:var(--font-sans);font-size:0.7rem;color:var(--text-4)">{m.date_of_event}</span>}
                    {m.recipient_name && <span style="font-family:var(--font-sans);font-size:0.7rem;color:var(--text-4);font-style:italic">{m.recipient_name}</span>}
                  </div>

                  {m.topics && m.topics.length > 0 && (
                    <div class="flex flex-wrap gap-1">
                      {m.topics.map((t) => <span class="tag">{t}</span>)}
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        )}
      </div>

      {mappableLocations.length > 0 && (
        <div class="mt-9 pt-9 section-rule">
          <p class="eyebrow mb-4">Locations</p>
          <div id="saint-map" style="height:360px;width:100%;background:var(--bg-elevated)"></div>
          <div class="flex flex-wrap gap-x-5 gap-y-2 mt-4">
            {[
              { type: "tomb", color: "#c9a84c", label: "Tomb" },
              { type: "birthplace", color: "#4a90d9", label: "Birthplace" },
              { type: "death_place", color: "#888", label: "Death place" },
              { type: "shrine", color: "#7c5cbf", label: "Shrine" },
              { type: "relic", color: "#c0392b", label: "Relic" },
              { type: "major_devotional_center", color: "#27ae60", label: "Devotional center" },
              { type: "other", color: "#5ba8a0", label: "Other" },
            ].filter(({ type }) => mappableLocations.some(l => l.location_type === type)).map(({ color, label }) => (
              <span class="flex items-center gap-1.5">
                <span style={`width:10px;height:10px;border-radius:50%;background:${color};display:inline-block;flex-shrink:0`}></span>
                <span style="font-family:var(--font-sans);font-size:0.7rem;color:var(--text-4)">{label}</span>
              </span>
            ))}
          </div>
        </div>
      )}

      {sources.length > 0 && (
        <div class="mt-9 pt-9 section-rule">
          <p class="eyebrow mb-4">Sources</p>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.6rem">
            {sources.map((s) => (
              <li style="display:flex;align-items:baseline;gap:0.6rem">
                <span style="font-family:var(--font-sans);font-size:0.6rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-5);white-space:nowrap;flex-shrink:0;padding-top:0.1rem">
                  {sourceTypeLabel[s.source_type] ?? s.source_type}
                </span>
                <a href={s.url} target="_blank" rel="noopener" style="font-family:var(--font-sans);font-size:0.82rem;color:var(--color-accent);text-decoration:none;line-height:1.4" class="hover:underline">
                  {s.title} ↗
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <aside class="hidden lg:block">
      <div class="card p-5 lg:sticky lg:top-24">
        <p class="eyebrow mb-5">Record</p>
        <dl class="meta-grid">
          {saint.birth_date && (
            <><dt>Born</dt><dd>{saint.birth_date}{birthLocation ? <><br/><span style="color:var(--text-4)">{birthLocation.location_name}</span></> : ""}</dd></>
          )}
          {saint.death_date && (
            <><dt>Died</dt><dd>{saint.death_date}{deathLocation ? <><br/><span style="color:var(--text-4)">{deathLocation.location_name}</span></> : ""}</dd></>
          )}
          {saint.beatification_date && (
            <><dt>Beatified</dt><dd>{saint.beatification_date}{saint.beatified_by ? <><br/><span style="color:var(--text-4)">{saint.beatified_by}</span></> : ""}</dd></>
          )}
          {saint.canonization_date && (
            <><dt>Canonized</dt><dd>{saint.canonization_date}{saint.canonized_by ? <><br/><span style="color:var(--text-4)">{saint.canonized_by}</span></> : ""}</dd></>
          )}
          {saint.total_attributed_miracles != null && (
            <><dt>Miracles</dt><dd>{saint.total_attributed_miracles}</dd></>
          )}
          {saint.wikipedia_url && (
            <><dt>External</dt><dd><a href={saint.wikipedia_url} target="_blank" rel="noopener" style="font-size:0.8rem">Wikipedia ↗</a></dd></>
          )}
        </dl>
      </div>
    </aside>

  </div>

  {mappableLocations.length > 0 && (
    <>
      <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
      <script is:inline define:vars={{ locations: mappableLocations }}>
        const typeColors = {
          tomb: "#c9a84c",
          birthplace: "#4a90d9",
          death_place: "#888888",
          shrine: "#7c5cbf",
          relic: "#c0392b",
          major_devotional_center: "#27ae60",
          other: "#5ba8a0",
        };

        const map = L.map('saint-map');
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
          maxZoom: 19,
        }).addTo(map);

        const bounds = [];
        locations.forEach(loc => {
          const lat = Number(loc.lat);
          const lng = Number(loc.lng);
          const color = typeColors[loc.location_type] || typeColors.other;
          const marker = L.circleMarker([lat, lng], {
            radius: 8,
            fillColor: color,
            color: "#fff",
            weight: 2,
            opacity: 1,
            fillOpacity: 0.9,
          }).addTo(map);
          const label = loc.location_type.replace(/_/g, " ");
          marker.bindPopup(`<strong>${loc.location_name}</strong><br><span style="font-size:0.75rem;color:#666">${label}</span>`);
          bounds.push([lat, lng]);
        });

        if (bounds.length === 1) {
          map.setView(bounds[0], 9);
        } else {
          map.fitBounds(bounds, { padding: [40, 40] });
        }
      </script>
    </>
  )}

</Base>

<style>
  .saint-header-img {
    width: 100%;
    max-height: 340px;
    aspect-ratio: 3 / 4;
  }
  @media (min-width: 1024px) {
    .saint-header-img {
      max-height: none;
      aspect-ratio: 3 / 4;
    }
  }
</style>
