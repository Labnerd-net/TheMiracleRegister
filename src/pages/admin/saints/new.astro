---
import AdminBase from "../../../layouts/AdminBase.astro";
import { createDb } from "../../../db";
import { saints } from "../../../db/schema";
import { slugify } from "../../../lib/slugify";
import { canonizationType, canonizationStage, dispensationReason, gender } from "../../../db/schema/enums";
import { parseEnum, formHelpers } from "../../../lib/form-utils";
import { SaintFormSchema, formatZodErrors } from "../../../lib/form-schemas";
import SaintForm from "../../../components/SaintForm.astro";
import { env } from "cloudflare:workers";

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const { get, getBool, getArr, getMulti } = formHelpers(form);

  const name = get("name");
  const slug = get("slug") || slugify(name);

  const validation = SaintFormSchema.safeParse({ name, canonization_stage: get("canonization_stage") });
  if (!validation.success) {
    error = formatZodErrors(validation);
  } else try {
    const db = createDb(env.DATABASE_URL);
    await db.insert(saints).values({
      slug,
      name,
      saint_name: get("saint_name") || null,
      birth_name: get("birth_name") || null,
      birth_date: get("birth_date") || null,
      death_date: get("death_date") || null,
      feast_day: get("feast_day") || null,
      nationality: get("nationality") || null,
      religious_order: get("religious_order") || null,
      beatification_date: get("beatification_date") || null,
      beatified_by: get("beatified_by") || null,
      canonization_date: get("canonization_date") || null,
      canonized_by: get("canonized_by") || null,
      canonization_type: parseEnum(get("canonization_type"), canonizationType.enumValues),
      canonization_stage: parseEnum(get("canonization_stage"), canonizationStage.enumValues, "saint")!,
      patronage: getArr("patronage"),
      themes: getMulti("themes"),
      biography_short: get("biography_short") || null,
      gender: parseEnum(get("gender"), gender.enumValues),
      lay_person: getBool("lay_person"),
      beatification_miracle_dispensed: getBool("beatification_miracle_dispensed"),
      canonization_miracle_dispensed: getBool("canonization_miracle_dispensed"),
      dispensation_reason: parseEnum(get("dispensation_reason"), dispensationReason.enumValues),
      image_url: get("image_url") || null,
      wikipedia_url: get("wikipedia_url") || null,
      published: getBool("published"),
    });
    return Astro.redirect("/admin/saints");
  } catch (e: any) {
    error = e?.message ?? "Failed to save saint.";
  }
}
---

<AdminBase title="New Saint">
  <a href="/admin/saints" style="font-size:0.85rem;display:block;margin-bottom:1rem">← Saints</a>
  <h1>New Saint</h1>

  {error && <div class="error">{error}</div>}

  <SaintForm />
</AdminBase>
