---
import AdminBase from "../../../layouts/AdminBase.astro";
import { createDb } from "../../../db";
import { saints } from "../../../db/schema";
import { slugify } from "../../../lib/slugify";
import { SAINT_THEMES } from "../../../db/topics";
import { canonizationType, canonizationStage } from "../../../db/schema/enums";
import { parseEnum } from "../../../lib/form-utils";
import { env } from "cloudflare:workers";

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const get = (key: string) => form.get(key)?.toString().trim() ?? "";
  const getArr = (key: string) =>
    get(key).split(",").map((s) => s.trim()).filter(Boolean);
  const getThemes = () => form.getAll("themes").map((v) => v.toString());

  const name = get("name");
  const slug = get("slug") || slugify(name);

  try {
    const db = createDb(env.DATABASE_URL);
    await db.insert(saints).values({
      slug,
      name,
      birth_name: get("birth_name") || null,
      birth_date: get("birth_date") || null,
      birth_place: get("birth_place") || null,
      death_date: get("death_date") || null,
      death_place: get("death_place") || null,
      feast_day: get("feast_day") || null,
      nationality: get("nationality") || null,
      religious_order: get("religious_order") || null,
      beatification_date: get("beatification_date") || null,
      beatified_by: get("beatified_by") || null,
      canonization_date: get("canonization_date") || null,
      canonized_by: get("canonized_by") || null,
      canonization_type: parseEnum(get("canonization_type"), canonizationType.enumValues),
      canonization_stage: parseEnum(get("canonization_stage"), canonizationStage.enumValues, "saint")!,
      patronage: getArr("patronage"),
      themes: getThemes(),
      biography_short: get("biography_short") || null,
      total_attributed_miracles: get("total_attributed_miracles")
        ? parseInt(get("total_attributed_miracles"))
        : null,
      image_url: get("image_url") || null,
      wikipedia_url: get("wikipedia_url") || null,
    });
    return Astro.redirect("/admin/saints");
  } catch (e: any) {
    error = e?.message ?? "Failed to save saint.";
  }
}
---

<AdminBase title="New Saint">
  <a href="/admin/saints" style="font-size:0.85rem;display:block;margin-bottom:1rem">← Saints</a>
  <h1>New Saint</h1>

  {error && <div class="error">{error}</div>}

  <form method="post">
    <fieldset>
      <legend>Identity</legend>
      <div class="two-col">
        <div class="field">
          <label for="name">Name *</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="field">
          <label for="slug">Slug</label>
          <input type="text" id="slug" name="slug" placeholder="auto-generated from name" />
        </div>
      </div>
      <div class="field">
        <label for="birth_name">Birth Name</label>
        <input type="text" id="birth_name" name="birth_name" />
      </div>
    </fieldset>

    <fieldset>
      <legend>Life</legend>
      <div class="two-col">
        <div class="field">
          <label for="birth_date">Birth Date</label>
          <input type="date" id="birth_date" name="birth_date" />
        </div>
        <div class="field">
          <label for="birth_place">Birth Place</label>
          <input type="text" id="birth_place" name="birth_place" />
        </div>
        <div class="field">
          <label for="death_date">Death Date</label>
          <input type="date" id="death_date" name="death_date" />
        </div>
        <div class="field">
          <label for="death_place">Death Place</label>
          <input type="text" id="death_place" name="death_place" />
        </div>
        <div class="field">
          <label for="nationality">Nationality</label>
          <input type="text" id="nationality" name="nationality" />
        </div>
        <div class="field">
          <label for="religious_order">Religious Order</label>
          <input type="text" id="religious_order" name="religious_order" />
        </div>
        <div class="field">
          <label for="feast_day">Feast Day</label>
          <input type="text" id="feast_day" name="feast_day" placeholder="e.g. October 22" />
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Canonization</legend>
      <div class="two-col">
        <div class="field">
          <label for="beatification_date">Beatification Date</label>
          <input type="date" id="beatification_date" name="beatification_date" />
        </div>
        <div class="field">
          <label for="beatified_by">Beatified By</label>
          <input type="text" id="beatified_by" name="beatified_by" />
        </div>
        <div class="field">
          <label for="canonization_date">Canonization Date</label>
          <input type="date" id="canonization_date" name="canonization_date" />
        </div>
        <div class="field">
          <label for="canonized_by">Canonized By</label>
          <input type="text" id="canonized_by" name="canonized_by" />
        </div>
        <div class="field">
          <label for="canonization_type">Type</label>
          <select id="canonization_type" name="canonization_type">
            <option value="">— select —</option>
            <option value="confessor">Confessor</option>
            <option value="martyr">Martyr</option>
            <option value="virgin">Virgin</option>
            <option value="married_couple">Married Couple</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="field">
          <label for="canonization_stage">Stage *</label>
          <select id="canonization_stage" name="canonization_stage" required>
            <option value="saint">Saint</option>
            <option value="blessed">Blessed</option>
            <option value="venerable">Venerable</option>
            <option value="servant_of_god">Servant of God</option>
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Taxonomy</legend>
      <div class="field">
        <label for="patronage">Patronage</label>
        <input type="text" id="patronage" name="patronage" placeholder="comma-separated" />
      </div>
      <div class="field">
        <label>Themes</label>
        <div class="checkbox-group">
          {SAINT_THEMES.map((t) => (
            <label><input type="checkbox" name="themes" value={t} />{t}</label>
          ))}
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Content</legend>
      <div class="field">
        <label for="biography_short">Biography</label>
        <textarea id="biography_short" name="biography_short" rows="6"></textarea>
        <p class="hint">~300 words</p>
      </div>
      <div class="two-col">
        <div class="field">
          <label for="total_attributed_miracles">Total Attributed Miracles</label>
          <input type="number" id="total_attributed_miracles" name="total_attributed_miracles" min="0" />
        </div>
      </div>
      <div class="field">
        <label for="image_url">Image URL</label>
        <input type="url" id="image_url" name="image_url" />
      </div>
      <div class="field">
        <label for="wikipedia_url">Wikipedia URL</label>
        <input type="url" id="wikipedia_url" name="wikipedia_url" />
      </div>
    </fieldset>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Create Saint</button>
      <a href="/admin/saints" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</AdminBase>
