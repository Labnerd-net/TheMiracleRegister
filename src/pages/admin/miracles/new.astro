---
import AdminBase from "../../../layouts/AdminBase.astro";
import { createDb } from "../../../db";
import { miracles, miracleSaints, saints } from "../../../db/schema";
import { asc } from "drizzle-orm";
import { slugify } from "../../../lib/slugify";
import {
  miracleCategory, miracleType, datePrecision, timingRelativeToSaintDeath,
  recipientPrivacy, cureCharacteristics, intercessoryMedium, approvalAuthority,
} from "../../../db/schema/enums";
import { parseEnum, formHelpers } from "../../../lib/form-utils";
import { MiracleFormSchema, formatZodErrors } from "../../../lib/form-schemas";
import MiracleForm from "../../../components/MiracleForm.astro";
import { env } from "cloudflare:workers";

const db = createDb(env.DATABASE_URL);
const allSaints = await db
  .select({ id: saints.id, name: saints.name })
  .from(saints)
  .orderBy(asc(saints.name));

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const { get, getBool, getMulti } = formHelpers(form);

  const title = get("title");
  const slug = get("slug") || slugify(title);
  const saintIds = form.getAll("saint_ids").map(String);

  const validation = MiracleFormSchema.safeParse({ title: get("title"), saint_ids: saintIds });
  if (!validation.success) {
    error = formatZodErrors(validation);
  } else try {
    const [inserted] = await db.insert(miracles).values({
      slug,
      title,
      miracle_category: parseEnum(get("miracle_category"), miracleCategory.enumValues, "intercessory")!,
      type: parseEnum(get("type"), miracleType.enumValues, "healing")!,
      topics: getMulti("topics"),
      date_of_event: get("date_of_event") || null,
      date_precision: parseEnum(get("date_precision"), datePrecision.enumValues, "year")!,
      timing_relative_to_saint_death: parseEnum(get("timing_relative_to_saint_death"), timingRelativeToSaintDeath.enumValues, "posthumous")!,
      location_name: get("location_name") || null,
      country: get("country") || null,
      region: get("region") || null,
      recipient_name: get("recipient_name") || null,
      recipient_privacy: parseEnum(get("recipient_privacy"), recipientPrivacy.enumValues, "public")!,
      recipient_age_at_event: get("recipient_age_at_event") ? parseInt(get("recipient_age_at_event")) : null,
      recipient_age_approximate: getBool("recipient_age_approximate"),
      medical_diagnosis: get("medical_diagnosis") || null,
      cure_details: get("cure_details") || null,
      cure_characteristics: parseEnum(get("cure_characteristics"), cureCharacteristics.enumValues, "not_applicable")!,
      was_medically_verified: getBool("was_medically_verified"),
      medical_verification_date: get("medical_verification_date") || null,
      intercessory_medium: parseEnum(get("intercessory_medium"), intercessoryMedium.enumValues, "prayer_only")!,
      approval_authority: parseEnum(get("approval_authority"), approvalAuthority.enumValues, "none")!,
      witness_count: get("witness_count") ? parseInt(get("witness_count")) : null,
      vatican_decree_date: get("vatican_decree_date") || null,
      vatican_medical_board_verdict: get("vatican_medical_board_verdict") || null,
      used_for_beatification: getBool("used_for_beatification"),
      used_for_canonization: getBool("used_for_canonization"),
      synopsis: get("synopsis") || null,
      has_primary_sources: getBool("has_primary_sources"),
      published: getBool("published"),
    }).returning({ id: miracles.id });

    await db.insert(miracleSaints).values(
      saintIds.map((id) => ({ miracle_id: inserted.id, saint_id: parseInt(id) }))
    );

    return Astro.redirect("/admin/miracles");
  } catch (e: any) {
    error = e?.message ?? "Failed to save miracle.";
  }
}
---

<AdminBase title="New Miracle">
  <a href="/admin/miracles" style="font-size:0.85rem;display:block;margin-bottom:1rem">← Miracles</a>
  <h1>New Miracle</h1>

  {error && <div class="error">{error}</div>}

  <MiracleForm allSaints={allSaints} />
</AdminBase>
