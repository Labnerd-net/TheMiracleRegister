---
import AdminBase from "../../../layouts/AdminBase.astro";
import Pagination from "../../../components/Pagination.astro";
import { createDb } from "../../../db";
import { miracles, miracleSaints, saints } from "../../../db/schema";
import { asc, count, eq, inArray } from "drizzle-orm";
import { env } from "cloudflare:workers";

const PAGE_SIZE = 25;
const rawPage = parseInt(Astro.url.searchParams.get("page") ?? "1");
const page = Math.max(1, isNaN(rawPage) ? 1 : rawPage);
const offset = (page - 1) * PAGE_SIZE;

const db = createDb(env.DATABASE_URL);

const [[{ total }], pageMiracles] = await Promise.all([
  db.select({ total: count() }).from(miracles),
  db
    .select({
      id: miracles.id,
      slug: miracles.slug,
      title: miracles.title,
      type: miracles.type,
      date_of_event: miracles.date_of_event,
      used_for_beatification: miracles.used_for_beatification,
      used_for_canonization: miracles.used_for_canonization,
      published: miracles.published,
    })
    .from(miracles)
    .orderBy(asc(miracles.title))
    .limit(PAGE_SIZE)
    .offset(offset),
]);

const miracleIds = pageMiracles.map((m) => m.id);
const saintLinks =
  miracleIds.length > 0
    ? await db
        .select({
          miracle_id: miracleSaints.miracle_id,
          saint_slug: saints.slug,
          saint_name: saints.name,
        })
        .from(miracleSaints)
        .innerJoin(saints, eq(miracleSaints.saint_id, saints.id))
        .where(inArray(miracleSaints.miracle_id, miracleIds))
    : [];

const saintsByMiracle = new Map<number, { saint_slug: string; saint_name: string }[]>();
for (const link of saintLinks) {
  if (!saintsByMiracle.has(link.miracle_id)) saintsByMiracle.set(link.miracle_id, []);
  saintsByMiracle.get(link.miracle_id)!.push({ saint_slug: link.saint_slug, saint_name: link.saint_name });
}

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
if (page > totalPages) return Astro.redirect(`/admin/miracles?page=${totalPages}`);

---

<AdminBase title="Miracles">
  <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:1.5rem">
    <h1>Miracles <span style="font-size:1rem;font-weight:normal;color:#666">({total})</span></h1>
    <a href="/admin/miracles/new" class="btn btn-primary">+ New Miracle</a>
  </div>

  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Saint(s)</th>
        <th>Type</th>
        <th>Date</th>
        <th>Used For</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {pageMiracles.map((m) => {
        const linked = saintsByMiracle.get(m.id) ?? [];
        return (
          <tr>
            <td><a href={`/miracles/${m.slug}`} target="_blank">{m.title}</a></td>
            <td>
              {linked.length === 0
                ? <span style="color:#aaa">—</span>
                : linked.map((s, i) => (
                    <>
                      {i > 0 && ", "}
                      <a href={`/saints/${s.saint_slug}`} target="_blank">{s.saint_name}</a>
                    </>
                  ))
              }
            </td>
            <td>{m.type}</td>
            <td>{m.date_of_event ?? "—"}</td>
            <td>
              {m.used_for_beatification && <span class="badge">beatification</span>}
              {m.used_for_canonization && <span class="badge badge-green">canonization</span>}
            </td>
            <td>{m.published ? <span class="badge badge-green">Live</span> : <span class="badge">Draft</span>}</td>
            <td><a href={`/admin/miracles/${m.slug}/edit`}>Edit</a></td>
          </tr>
        );
      })}
    </tbody>
  </table>

  <Pagination page={page} totalPages={totalPages} prevUrl={`/admin/miracles?page=${page - 1}`} nextUrl={`/admin/miracles?page=${page + 1}`} />
</AdminBase>

<style>
  .btn { display: inline-block; padding: 0.5rem 1.25rem; border-radius: 4px; font-size: 0.875rem; text-decoration: none; }
  .btn-primary { background: #2a5db0; color: white; }
  .badge { display: inline-block; font-size: 0.7rem; padding: 0.15rem 0.4rem; border-radius: 3px; background: #e8f0fe; color: #2a5db0; margin-right: 0.2rem; }
  .badge-green { background: #dcfce7; color: #166534; }
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e5e7eb;
  }
  .pagination-btn {
    font-size: 0.8rem;
    font-weight: 500;
    color: #2a5db0;
    text-decoration: none;
  }
  .pagination-btn:hover { text-decoration: underline; }
  .pagination-btn.disabled { color: #9ca3af; cursor: default; }
  .pagination-info { font-size: 0.78rem; color: #6b7280; }
</style>
