---
import AdminBase from "../../../../layouts/AdminBase.astro";
import { createDb } from "../../../../db";
import { miracles, miracleSources, saints } from "../../../../db/schema";
import { eq } from "drizzle-orm";
import { env } from "cloudflare:workers";

const { slug } = Astro.params;
const db = createDb(env.DATABASE_URL);

const [miracle] = await db
  .select({ id: miracles.id, title: miracles.title, slug: miracles.slug, saint_id: miracles.saint_id })
  .from(miracles)
  .where(eq(miracles.slug, slug!));
if (!miracle) return Astro.redirect("/admin/miracles");

const [saint] = await db
  .select({ name: saints.name })
  .from(saints)
  .where(eq(saints.id, miracle.saint_id));

if (Astro.request.method === "POST") {
  await db.delete(miracleSources).where(eq(miracleSources.miracle_id, miracle.id));
  await db.delete(miracles).where(eq(miracles.id, miracle.id));
  return Astro.redirect("/admin/miracles");
}
---

<AdminBase title={`Delete: ${miracle.title}`}>
  <a href={`/admin/miracles/${slug}/edit`} style="font-size:0.85rem;display:block;margin-bottom:1rem">← Back to Edit</a>
  <h1>Delete Miracle</h1>

  <div class="error" style="margin-bottom:1.5rem">
    <strong>This action is permanent and cannot be undone.</strong>
  </div>

  <p>You are about to delete <strong>{miracle.title}</strong>{saint ? <> attributed to <strong>{saint.name}</strong></> : ""}.</p>
  <p>Any sources attached to this miracle will also be deleted.</p>

  <form method="post" style="margin-top:1.5rem;display:flex;gap:1rem;align-items:center">
    <button type="submit" class="btn" style="background:#dc2626;color:white;padding:0.5rem 1.25rem;border-radius:4px;font-size:0.9rem;font-family:inherit;cursor:pointer;border:none">
      Delete Miracle
    </button>
    <a href={`/admin/miracles/${slug}/edit`} class="btn btn-secondary">Cancel</a>
  </form>
</AdminBase>
