---
import AdminBase from "../../../../layouts/AdminBase.astro";
import { createDb } from "../../../../db";
import { miracles, miracleSaints, saints, miracleSources, miracleImages } from "../../../../db/schema";
import { asc, and, eq } from "drizzle-orm";
import {
  miracleCategory, miracleType, datePrecision, timingRelativeToSaintDeath,
  recipientPrivacy, recipientGender, cureCharacteristics, intercessoryMedium, approvalAuthority, sourceType,
  contentTier,
} from "../../../../db/schema/enums";
import { parseEnum, formHelpers } from "../../../../lib/form-utils";
import { humanizeSnakeCase } from "../../../../lib/format";
import { MiracleFormSchema, formatZodErrors } from "../../../../lib/form-schemas";
import MiracleForm from "../../../../components/MiracleForm.astro";
import { env } from "cloudflare:workers";

const { slug } = Astro.params;
const db = createDb(env.DATABASE_URL);

const [miracle] = await db.select().from(miracles).where(eq(miracles.slug, slug!));
if (!miracle) return Astro.redirect("/admin/miracles");

const [allSaints, existingLinks] = await Promise.all([
  db.select({ id: saints.id, name: saints.name }).from(saints).orderBy(asc(saints.name)),
  db.select({ saint_id: miracleSaints.saint_id }).from(miracleSaints).where(eq(miracleSaints.miracle_id, miracle.id)),
]);
let selectedSaintIds = existingLinks.map((l) => l.saint_id);

let error = "";
let success = false;
let sourceError = "";
let sourceSuccess = "";
let imageError = "";
let imageSuccess = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const { get, getBool, getMulti } = formHelpers(form);
  const action = get("_action");

  if (action === "add_image") {
    const url = get("image_url");
    const caption = get("image_caption");
    const attribution = get("image_source_attribution");
    const order = (() => { const v = parseInt(get("image_display_order")); return isNaN(v) ? 0 : v; })();
    if (!url) {
      imageError = "URL is required.";
    } else try {
      await db.insert(miracleImages).values({
        miracle_id: miracle.id,
        url,
        caption: caption || null,
        display_order: order,
        source_attribution: attribution || null,
      });
      imageSuccess = "Image added.";
    } catch (e: any) {
      imageError = e?.message ?? "Failed to add image.";
    }
  } else if (action === "delete_image") {
    const imageId = parseInt(get("image_id"));
    if (imageId) {
      await db.delete(miracleImages)
        .where(and(eq(miracleImages.id, imageId), eq(miracleImages.miracle_id, miracle.id)));
      imageSuccess = "Image removed.";
    }
  } else if (action === "add_source") {
    const url = get("source_url");
    const title = get("source_title");
    const type = parseEnum(get("source_type"), sourceType.enumValues, "other");
    const accessed = get("source_accessed_date");
    if (!url || !title) {
      sourceError = "URL and title are required.";
    } else try {
      await db.insert(miracleSources).values({
        miracle_id: miracle.id,
        url,
        title,
        source_type: type!,
        accessed_date: accessed || null,
      });
      sourceSuccess = "Source added.";
    } catch (e: any) {
      sourceError = e?.message ?? "Failed to add source.";
    }
  } else if (action === "delete_source") {
    const sourceId = parseInt(get("source_id"));
    if (sourceId) {
      await db.delete(miracleSources)
        .where(and(eq(miracleSources.id, sourceId), eq(miracleSources.miracle_id, miracle.id)));
      sourceSuccess = "Source removed.";
    }
  } else {
    const saintIds = form.getAll("saint_ids").map(String);
    const validation = MiracleFormSchema.safeParse({ title: get("title"), saint_ids: saintIds });
    if (!validation.success) {
      error = formatZodErrors(validation);
    } else try {
      await db.update(miracles).set({
        slug: get("slug").trim() || miracle.slug,
        title: get("title") || miracle.title,
        miracle_category: parseEnum(get("miracle_category"), miracleCategory.enumValues) ?? miracle.miracle_category,
        type: parseEnum(get("type"), miracleType.enumValues) ?? miracle.type,
        topics: getMulti("topics"),
        date_of_event: get("date_of_event") || null,
        date_precision: parseEnum(get("date_precision"), datePrecision.enumValues) ?? miracle.date_precision,
        timing_relative_to_saint_death: parseEnum(get("timing_relative_to_saint_death"), timingRelativeToSaintDeath.enumValues) ?? miracle.timing_relative_to_saint_death,
        location_name: get("location_name") || null,
        location_lat: get("location_lat") || null,
        location_lng: get("location_lng") || null,
        country: get("country") || null,
        region: get("region") || null,
        recipient_name: get("recipient_name") || null,
        recipient_gender: parseEnum(get("recipient_gender"), recipientGender.enumValues),
        recipient_country: get("recipient_country") || null,
        recipient_privacy: parseEnum(get("recipient_privacy"), recipientPrivacy.enumValues) ?? miracle.recipient_privacy,
        recipient_age_at_event: (() => { const v = parseInt(get("recipient_age_at_event")); return isNaN(v) ? null : v; })(),
        recipient_age_approximate: getBool("recipient_age_approximate"),
        medical_diagnosis: get("medical_diagnosis") || null,
        cure_details: get("cure_details") || null,
        cure_characteristics: parseEnum(get("cure_characteristics"), cureCharacteristics.enumValues) ?? miracle.cure_characteristics,
        was_medically_verified: getBool("was_medically_verified"),
        medical_verification_date: get("medical_verification_date") || null,
        intercessory_medium: parseEnum(get("intercessory_medium"), intercessoryMedium.enumValues) ?? miracle.intercessory_medium,
        approval_authority: parseEnum(get("approval_authority"), approvalAuthority.enumValues) ?? miracle.approval_authority,
        witness_count: (() => { const v = parseInt(get("witness_count")); return isNaN(v) ? null : v; })(),
        vatican_decree_date: get("vatican_decree_date") || null,
        vatican_medical_board_verdict: get("vatican_medical_board_verdict") || null,
        used_for_beatification: getBool("used_for_beatification"),
        used_for_canonization: getBool("used_for_canonization"),
        synopsis: get("synopsis") || null,
        content_tier: parseEnum(get("content_tier"), contentTier.enumValues) ?? miracle.content_tier,
        has_primary_sources: getBool("has_primary_sources"),
        feast_month: (() => { const n = parseInt(get("feast_month")); return isNaN(n) ? null : n; })(),
        feast_day_of_month: (() => { const n = parseInt(get("feast_day_of_month")); return isNaN(n) ? null : n; })(),
        feast_easter_offset: (() => { const n = parseInt(get("feast_easter_offset")); return isNaN(n) ? null : n; })(),
        published: getBool("published"),
      }).where(eq(miracles.slug, slug!));

      // Replace saint links atomically
      await db.transaction(async (tx) => {
        await tx.delete(miracleSaints).where(eq(miracleSaints.miracle_id, miracle.id));
        await tx.insert(miracleSaints).values(
          saintIds.map((id) => ({ miracle_id: miracle.id, saint_id: parseInt(id) }))
        );
      });

      selectedSaintIds = saintIds.map(Number);
      success = true;
      const newSlug = get("slug").trim() || miracle.slug;
      if (newSlug !== slug) return Astro.redirect(`/admin/miracles/${newSlug}/edit`);
    } catch (e: any) {
      error = e?.message ?? "Failed to save.";
    }
  }
}

let v = miracle;
if (success) {
  const [updated] = await db.select().from(miracles).where(eq(miracles.slug, slug!));
  v = updated ?? miracle;
}
const [sources, images] = await Promise.all([
  db.select().from(miracleSources).where(eq(miracleSources.miracle_id, miracle.id)),
  db.select().from(miracleImages).where(eq(miracleImages.miracle_id, miracle.id)).orderBy(asc(miracleImages.display_order)),
]);
---

<AdminBase title={`Edit: ${v.title}`}>
  <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:1rem">
    <a href="/admin/miracles" style="font-size:0.85rem">← Miracles</a>
    <a href={`/admin/miracles/${slug}/delete`} style="font-size:0.85rem;color:#dc2626">Delete miracle</a>
  </div>
  <h1 style="font-size:1.2rem">Edit: {v.title}</h1>
  <p style="font-size:0.85rem;color:#666;margin-bottom:1.5rem">
    Slug: <code>{slug}</code> · <a href={`/miracles/${slug}?preview=${env.PREVIEW_TOKEN}`} target="_blank">View public page ↗</a>
  </p>

  {error && <div class="error">{error}</div>}
  {success && <div class="success">Saved successfully.</div>}

  <MiracleForm miracle={v} allSaints={allSaints} selectedSaintIds={selectedSaintIds} />

  <fieldset style="margin-top:2rem">
    <legend>Sources</legend>

    {sourceError && <div class="error" style="margin-bottom:1rem">{sourceError}</div>}
    {sourceSuccess && <div class="success" style="margin-bottom:1rem">{sourceSuccess}</div>}

    {sources.length === 0 && (
      <p style="font-size:0.85rem;color:#888;margin-bottom:1rem">No sources added yet.</p>
    )}

    {sources.map((s, i) => (
      <div style="display:flex;align-items:baseline;gap:0.75rem;padding:0.5rem 0;border-bottom:1px solid #eee">
        <div style="flex:1;min-width:0">
          <div style="font-size:0.875rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
            <a href={s.url} target="_blank" rel="noopener">{s.title}</a>
          </div>
          <div style="font-size:0.75rem;color:#888;margin-top:0.1rem">
            {humanizeSnakeCase(s.source_type)}
            {s.accessed_date && <> · accessed {s.accessed_date}</>}
          </div>
        </div>
        <code style="font-size:0.75rem;color:#666;flex-shrink:0">[^{i + 1}]</code>
        <form method="post" style="flex-shrink:0">
          <input type="hidden" name="_action" value="delete_source" />
          <input type="hidden" name="source_id" value={s.id} />
          <button type="submit" onclick="return confirm('Remove this source?')" style="background:none;border:none;color:#dc2626;font-size:0.8rem;cursor:pointer;padding:0">Remove</button>
        </form>
      </div>
    ))}

    <div style="margin-top:1.25rem">
      <p style="font-size:0.8rem;font-weight:600;color:#444;margin-bottom:0.75rem">Add Source</p>
      <form method="post">
        <input type="hidden" name="_action" value="add_source" />
        <div class="two-col" style="margin-bottom:0.75rem">
          <div class="field">
            <label for="source_title">Title *</label>
            <input type="text" id="source_title" name="source_title" />
          </div>
          <div class="field">
            <label for="source_type">Type</label>
            <select id="source_type" name="source_type">
              {sourceType.enumValues.map((t) => (
                <option value={t}>{humanizeSnakeCase(t)}</option>
              ))}
            </select>
          </div>
        </div>
        <div class="field" style="margin-bottom:0.75rem">
          <label for="source_url">URL *</label>
          <input type="url" id="source_url" name="source_url" />
        </div>
        <div class="field" style="margin-bottom:0.75rem">
          <label for="source_accessed_date">Accessed Date</label>
          <input type="date" id="source_accessed_date" name="source_accessed_date" style="max-width:200px" />
        </div>
        <button type="submit" class="btn btn-primary">Add Source</button>
      </form>
    </div>
  </fieldset>

  <fieldset style="margin-top:2rem">
    <legend>Images</legend>

    {imageError && <div class="error" style="margin-bottom:1rem">{imageError}</div>}
    {imageSuccess && <div class="success" style="margin-bottom:1rem">{imageSuccess}</div>}

    {images.length === 0 && (
      <p style="font-size:0.85rem;color:#888;margin-bottom:1rem">No images added yet.</p>
    )}

    {images.map((img) => (
      <div style="display:flex;align-items:flex-start;gap:0.75rem;padding:0.75rem 0;border-bottom:1px solid #eee">
        <img src={img.url} alt={img.caption ?? ""} style="width:80px;height:60px;object-fit:cover;flex-shrink:0;border-radius:3px" />
        <div style="flex:1;min-width:0">
          <div style="font-size:0.875rem;font-weight:600;word-break:break-all">
            <a href={img.url} target="_blank" rel="noopener">{img.url}</a>
          </div>
          {img.caption && <div style="font-size:0.8rem;color:#555;margin-top:0.2rem">{img.caption}</div>}
          {img.source_attribution && <div style="font-size:0.75rem;color:#888;margin-top:0.1rem">Credit: {img.source_attribution}</div>}
          <div style="font-size:0.75rem;color:#888;margin-top:0.1rem">Order: {img.display_order}</div>
        </div>
        <form method="post" style="flex-shrink:0">
          <input type="hidden" name="_action" value="delete_image" />
          <input type="hidden" name="image_id" value={img.id} />
          <button type="submit" onclick="return confirm('Remove this image?')" style="background:none;border:none;color:#dc2626;font-size:0.8rem;cursor:pointer;padding:0">Remove</button>
        </form>
      </div>
    ))}

    <div style="margin-top:1.25rem">
      <p style="font-size:0.8rem;font-weight:600;color:#444;margin-bottom:0.75rem">Add Image</p>
      <form method="post">
        <input type="hidden" name="_action" value="add_image" />
        <div class="field" style="margin-bottom:0.75rem">
          <label for="image_url">URL *</label>
          <input type="url" id="image_url" name="image_url" />
        </div>
        <div class="field" style="margin-bottom:0.75rem">
          <label for="image_caption">Caption</label>
          <textarea id="image_caption" name="image_caption" rows="2"></textarea>
        </div>
        <div class="two-col" style="margin-bottom:0.75rem">
          <div class="field">
            <label for="image_source_attribution">Credit / Attribution</label>
            <input type="text" id="image_source_attribution" name="image_source_attribution" />
          </div>
          <div class="field">
            <label for="image_display_order">Display Order</label>
            <input type="number" id="image_display_order" name="image_display_order" value="0" min="0" style="max-width:100px" />
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Add Image</button>
      </form>
    </div>
  </fieldset>
</AdminBase>
