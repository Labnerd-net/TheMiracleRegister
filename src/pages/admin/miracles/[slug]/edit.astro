---
import AdminBase from "../../../../layouts/AdminBase.astro";
import { createDb } from "../../../../db";
import { miracles, saints } from "../../../../db/schema";
import { asc, eq } from "drizzle-orm";
import { MIRACLE_TOPICS } from "../../../../db/topics";
import {
  miracleCategory, miracleType, datePrecision, timingRelativeToSaintDeath,
  recipientPrivacy, cureCharacteristics, intercessoryMedium,
} from "../../../../db/schema/enums";
import { parseEnum } from "../../../../lib/form-utils";
import { env } from "cloudflare:workers";

const { slug } = Astro.params;
const db = createDb(env.DATABASE_URL);

const [miracle] = await db.select().from(miracles).where(eq(miracles.slug, slug!));
if (!miracle) return Astro.redirect("/admin/miracles");

const allSaints = await db
  .select({ id: saints.id, name: saints.name })
  .from(saints)
  .orderBy(asc(saints.name));

let error = "";
let success = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const get = (key: string) => form.get(key)?.toString().trim() ?? "";
  const getBool = (key: string) => form.get(key) === "true";
  const getTopics = () => form.getAll("topics").map((v) => v.toString());

  try {
    await db.update(miracles).set({
      title: get("title") || miracle.title,
      saint_id: parseInt(get("saint_id")) || miracle.saint_id,
      miracle_category: parseEnum(get("miracle_category"), miracleCategory.enumValues) ?? miracle.miracle_category,
      type: parseEnum(get("type"), miracleType.enumValues) ?? miracle.type,
      topics: getTopics(),
      date_of_event: get("date_of_event") || null,
      date_precision: parseEnum(get("date_precision"), datePrecision.enumValues) ?? miracle.date_precision,
      timing_relative_to_saint_death: parseEnum(get("timing_relative_to_saint_death"), timingRelativeToSaintDeath.enumValues) ?? miracle.timing_relative_to_saint_death,
      location_name: get("location_name") || null,
      country: get("country") || null,
      region: get("region") || null,
      recipient_name: get("recipient_name") || null,
      recipient_privacy: parseEnum(get("recipient_privacy"), recipientPrivacy.enumValues) ?? miracle.recipient_privacy,
      recipient_age_at_event: get("recipient_age_at_event") ? parseInt(get("recipient_age_at_event")) : null,
      medical_diagnosis: get("medical_diagnosis") || null,
      cure_details: get("cure_details") || null,
      cure_characteristics: parseEnum(get("cure_characteristics"), cureCharacteristics.enumValues) ?? miracle.cure_characteristics,
      was_medically_verified: getBool("was_medically_verified"),
      medical_verification_date: get("medical_verification_date") || null,
      intercessory_medium: parseEnum(get("intercessory_medium"), intercessoryMedium.enumValues) ?? miracle.intercessory_medium,
      vatican_recognized: getBool("vatican_recognized"),
      vatican_decree_date: get("vatican_decree_date") || null,
      vatican_medical_board_verdict: get("vatican_medical_board_verdict") || null,
      used_for_beatification: getBool("used_for_beatification"),
      used_for_canonization: getBool("used_for_canonization"),
      synopsis: get("synopsis") || null,
      has_primary_sources: getBool("has_primary_sources"),
    }).where(eq(miracles.slug, slug!));
    success = true;
  } catch (e: any) {
    error = e?.message ?? "Failed to save.";
  }
}

const [m] = await db.select().from(miracles).where(eq(miracles.slug, slug!));
const v = m ?? miracle;
const currentTopics = new Set(v.topics ?? []);
---

<AdminBase title={`Edit: ${v.title}`}>
  <a href="/admin/miracles" style="font-size:0.85rem;display:block;margin-bottom:1rem">← Miracles</a>
  <h1 style="font-size:1.2rem">Edit: {v.title}</h1>
  <p style="font-size:0.85rem;color:#666;margin-bottom:1.5rem">
    Slug: <code>{slug}</code> · <a href={`/miracles/${slug}`} target="_blank">View public page ↗</a>
  </p>

  {error && <div class="error">{error}</div>}
  {success && <div class="success">Saved successfully.</div>}

  <form method="post">
    <fieldset>
      <legend>Identity</legend>
      <div class="field">
        <label for="title">Title *</label>
        <input type="text" id="title" name="title" value={v.title} required />
      </div>
      <div class="two-col">
        <div class="field">
          <label for="saint_id">Saint *</label>
          <select id="saint_id" name="saint_id" required>
            {allSaints.map((s) => (
              <option value={s.id} selected={s.id === v.saint_id}>{s.name}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="miracle_category">Category</label>
          <select id="miracle_category" name="miracle_category">
            {["intercessory","associated"].map((t) => (
              <option value={t} selected={v.miracle_category === t}>{t}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="type">Type</label>
          <select id="type" name="type">
            {["healing","nature","eucharistic","stigmata","incorruptibility","apparition","miraculous_image","prophecy","bilocation","other"].map((t) => (
              <option value={t} selected={v.type === t}>{t}</option>
            ))}
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Topics</legend>
      <div class="checkbox-group">
        {MIRACLE_TOPICS.map((t) => (
          <label>
            <input type="checkbox" name="topics" value={t} checked={currentTopics.has(t)} />
            {t}
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset>
      <legend>Date &amp; Location</legend>
      <div class="two-col">
        <div class="field">
          <label for="date_of_event">Date</label>
          <input type="date" id="date_of_event" name="date_of_event" value={v.date_of_event ?? ""} />
        </div>
        <div class="field">
          <label for="date_precision">Date Precision</label>
          <select id="date_precision" name="date_precision">
            {["exact_day","month","year","decade","century","unknown"].map((t) => (
              <option value={t} selected={v.date_precision === t}>{t}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="timing_relative_to_saint_death">Timing</label>
          <select id="timing_relative_to_saint_death" name="timing_relative_to_saint_death">
            {["posthumous","during_lifetime","not_applicable"].map((t) => (
              <option value={t} selected={v.timing_relative_to_saint_death === t}>{t}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="country">Country</label>
          <input type="text" id="country" name="country" value={v.country ?? ""} />
        </div>
        <div class="field">
          <label for="region">Region</label>
          <input type="text" id="region" name="region" value={v.region ?? ""} />
        </div>
        <div class="field">
          <label for="location_name">Location Name</label>
          <input type="text" id="location_name" name="location_name" value={v.location_name ?? ""} />
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Recipient</legend>
      <div class="two-col">
        <div class="field">
          <label for="recipient_name">Name</label>
          <input type="text" id="recipient_name" name="recipient_name" value={v.recipient_name ?? ""} />
        </div>
        <div class="field">
          <label for="recipient_privacy">Privacy</label>
          <select id="recipient_privacy" name="recipient_privacy">
            {["public","first_name_only","confidential","not_applicable"].map((t) => (
              <option value={t} selected={v.recipient_privacy === t}>{t}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="recipient_age_at_event">Age at Event</label>
          <input type="number" id="recipient_age_at_event" name="recipient_age_at_event" value={v.recipient_age_at_event ?? ""} min="0" />
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Medical</legend>
      <div class="field">
        <label for="medical_diagnosis">Diagnosis</label>
        <input type="text" id="medical_diagnosis" name="medical_diagnosis" value={v.medical_diagnosis ?? ""} />
      </div>
      <div class="field">
        <label for="cure_details">Cure Details</label>
        <textarea id="cure_details" name="cure_details" rows="4">{v.cure_details ?? ""}</textarea>
      </div>
      <div class="two-col">
        <div class="field">
          <label for="cure_characteristics">Cure Characteristics</label>
          <select id="cure_characteristics" name="cure_characteristics">
            {["instant_complete","gradual_complete","instant_partial","gradual_partial","not_applicable"].map((t) => (
              <option value={t} selected={v.cure_characteristics === t}>{t}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="intercessory_medium">Intercessory Medium</label>
          <select id="intercessory_medium" name="intercessory_medium">
            {["prayer_only","relic","blessed_oil","medallion","visitation","tomb_prayer","saint_image","not_applicable","other"].map((t) => (
              <option value={t} selected={v.intercessory_medium === t}>{t}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label>
            <input type="hidden" name="was_medically_verified" value="false" />
            <input type="checkbox" name="was_medically_verified" value="true" checked={v.was_medically_verified} />
            Medically Verified
          </label>
        </div>
        <div class="field">
          <label for="medical_verification_date">Verification Date</label>
          <input type="date" id="medical_verification_date" name="medical_verification_date" value={v.medical_verification_date ?? ""} />
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Vatican</legend>
      <div class="two-col">
        <div class="field">
          <label>
            <input type="hidden" name="vatican_recognized" value="false" />
            <input type="checkbox" name="vatican_recognized" value="true" checked={v.vatican_recognized} />
            Vatican Recognized
          </label>
        </div>
        <div class="field">
          <label for="vatican_decree_date">Decree Date</label>
          <input type="date" id="vatican_decree_date" name="vatican_decree_date" value={v.vatican_decree_date ?? ""} />
        </div>
        <div class="field">
          <label>
            <input type="hidden" name="used_for_beatification" value="false" />
            <input type="checkbox" name="used_for_beatification" value="true" checked={v.used_for_beatification} />
            Used for Beatification
          </label>
        </div>
        <div class="field">
          <label>
            <input type="hidden" name="used_for_canonization" value="false" />
            <input type="checkbox" name="used_for_canonization" value="true" checked={v.used_for_canonization} />
            Used for Canonization
          </label>
        </div>
      </div>
      <div class="field">
        <label for="vatican_medical_board_verdict">Medical Board Verdict</label>
        <input type="text" id="vatican_medical_board_verdict" name="vatican_medical_board_verdict" value={v.vatican_medical_board_verdict ?? ""} />
      </div>
    </fieldset>

    <fieldset>
      <legend>Content</legend>
      <div class="field">
        <label for="synopsis">Synopsis</label>
        <textarea id="synopsis" name="synopsis" rows="10">{v.synopsis ?? ""}</textarea>
        <p class="hint">500–1000 words narrative</p>
      </div>
      <div class="field">
        <label>
          <input type="hidden" name="has_primary_sources" value="false" />
          <input type="checkbox" name="has_primary_sources" value="true" checked={v.has_primary_sources} />
          Has Primary Sources
        </label>
      </div>
    </fieldset>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/admin/miracles" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</AdminBase>
