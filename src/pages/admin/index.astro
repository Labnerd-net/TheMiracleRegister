---
import AdminBase from "../../layouts/AdminBase.astro";
import { createDb } from "../../db";
import { saints, miracles } from "../../db/schema";
import { sql } from "drizzle-orm";
import { env } from "cloudflare:workers";

const db = createDb(env.DATABASE_URL);
const [[{ saintCount }], [{ miracleCount }]] = await Promise.all([
  db.select({ saintCount: sql<number>`count(*)::int` }).from(saints),
  db.select({ miracleCount: sql<number>`count(*)::int` }).from(miracles),
]);
---

<AdminBase title="Dashboard">
  <h1>Dashboard</h1>

  <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;max-width:400px;margin-bottom:2rem">
    <div style="border:1px solid #ddd;border-radius:6px;padding:1rem">
      <div style="font-size:2rem;font-weight:bold">{saintCount}</div>
      <div style="font-size:0.85rem;color:#666">Saints</div>
    </div>
    <div style="border:1px solid #ddd;border-radius:6px;padding:1rem">
      <div style="font-size:2rem;font-weight:bold">{miracleCount}</div>
      <div style="font-size:0.85rem;color:#666">Miracles</div>
    </div>
  </div>

  <h2>Quick Actions</h2>
  <div style="display:flex;gap:1rem">
    <a href="/admin/saints/new" class="btn btn-primary">+ New Saint</a>
    <a href="/admin/miracles/new" class="btn btn-primary">+ New Miracle</a>
  </div>
</AdminBase>

<style>
  .btn { display: inline-block; padding: 0.5rem 1.25rem; border-radius: 4px; font-size: 0.9rem; text-decoration: none; }
  .btn-primary { background: #2a5db0; color: white; }
  .btn-primary:hover { background: #1e4a8a; }
</style>
