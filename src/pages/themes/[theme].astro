---
import Base from "../../layouts/Base.astro";
import SaintCard from "../../components/SaintCard.astro";
import { createDb } from "../../db";
import { saints } from "../../db/schema";
import { SAINT_THEMES } from "../../db/topics";
import { and, asc, eq, sql } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { CACHE_CONTENT } from "../../lib/cache";
import { isIndexable } from "../../lib/browse";
import { humanizeSlug } from "../../lib/format";
import { collectionJsonLd, breadcrumbJsonLd } from "../../lib/jsonld";

const { theme } = Astro.params;
if (!theme || !(SAINT_THEMES as readonly string[]).includes(theme)) return Astro.rewrite("/404");

Astro.response.headers.set("Cache-Control", CACHE_CONTENT);

const db = createDb(env.DATABASE_URL);

const themeSaints = await db
  .select({
    slug: saints.slug,
    name: saints.name,
    feast_day: saints.feast_day,
    nationality: saints.nationality,
    canonization_stage: saints.canonization_stage,
    image_url: saints.image_url,
  })
  .from(saints)
  .where(and(eq(saints.published, true), sql`${saints.themes} @> ARRAY[${theme}]::text[]`))
  .orderBy(asc(saints.name));

const label = humanizeSlug(theme);
const total = themeSaints.length;
const path = `/themes/${theme}`;
const description = `${total} ${total === 1 ? "saint" : "saints"} associated with ${label.toLowerCase()}, with biographies and documented miracles.`;
const jsonLd = [
  collectionJsonLd({ name: `Saints: ${label}`, description, path }),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Themes", path: "/themes" },
    { name: label, path },
  ]),
];
---

<Base title={`${label} Saints`} description={description} jsonLd={jsonLd} noindex={!isIndexable(total)}>

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
      <p class="eyebrow mb-4"><a href="/themes" style="color:inherit;text-decoration:none">Themes</a></p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,5vw,4rem);font-weight:300;color:var(--text-1);line-height:1.05;letter-spacing:-0.01em">{label}</h1>
      <p style="font-family:var(--font-sans);font-size:0.8rem;color:var(--text-4);margin-top:0.6rem;letter-spacing:0.02em">{total} {total === 1 ? "saint" : "saints"} recorded</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-10">
      {total === 0 ? (
        <p class="empty-state col-span-full">No published saints for this theme yet.</p>
      ) : themeSaints.map((s, i) => (
        <SaintCard saint={s} eager={i < 4} />
      ))}
    </div>
  </div>

</Base>
