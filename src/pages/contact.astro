---
import Base from "../layouts/Base.astro";
---

<Base title="Contact" description="Report incorrect data or source information in The Miracles Register.">

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-8 py-16">
      <p class="eyebrow mb-4">The Register</p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,5vw,4rem);font-weight:300;color:var(--text-1);line-height:1.05;letter-spacing:-0.01em">Contact</h1>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-8 py-16">
    <div class="max-w-xl">
      <p style="font-family:var(--font-sans);font-size:0.95rem;color:var(--text-2);line-height:1.7;margin-bottom:2rem">
        Found an error in a miracle record, a source citation, or a saint's biographical details?
        Please send a note — corrections are taken seriously and reviewed before any change is made.
      </p>
      <p style="font-family:var(--font-sans);font-size:0.95rem;color:var(--text-2);line-height:1.7;margin-bottom:2.5rem">
        Include the page URL, the specific field in question, and your suggested correction along with any source you can point to.
      </p>
      <a
        href="mailto:contact@themiracleregister.org"
        style="font-family:var(--font-sans);font-size:0.85rem;font-weight:500;letter-spacing:0.04em;color:var(--color-accent);text-decoration:none;border-bottom:1px solid var(--color-accent);padding-bottom:0.1rem;transition:opacity 0.2s"
      >
        contact@themiracleregister.org
      </a>
    </div>
  </div>

</Base>
