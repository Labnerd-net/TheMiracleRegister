---
import Base from "../layouts/Base.astro";
import { createDb } from "../db";
import { miracles, saints, saintLocations } from "../db/schema";
import { and, eq, isNotNull } from "drizzle-orm";
import { env } from "cloudflare:workers";

const db = createDb(env.DATABASE_URL);

const [miracleRows, locationRows] = await Promise.all([
  db.select({
    slug: miracles.slug,
    title: miracles.title,
    miracle_category: miracles.miracle_category,
    type: miracles.type,
    location_lat: miracles.location_lat,
    location_lng: miracles.location_lng,
    location_name: miracles.location_name,
    country: miracles.country,
  }).from(miracles).where(
    and(
      eq(miracles.published, true),
      isNotNull(miracles.location_lat),
      isNotNull(miracles.location_lng),
    )
  ),
  db.select({
    location_name: saintLocations.location_name,
    lat: saintLocations.lat,
    lng: saintLocations.lng,
    location_type: saintLocations.location_type,
    saint_name: saints.name,
    saint_slug: saints.slug,
  }).from(saintLocations)
    .innerJoin(saints, eq(saintLocations.saint_id, saints.id))
    .where(
      and(
        eq(saints.published, true),
        isNotNull(saintLocations.lat),
        isNotNull(saintLocations.lng),
      )
    ),
]);

const miracleData = miracleRows.map(m => ({
  slug: m.slug,
  title: m.title,
  category: m.miracle_category,
  type: m.type,
  lat: Number(m.location_lat),
  lng: Number(m.location_lng),
  label: m.location_name ?? m.country ?? "",
}));

const locationData = locationRows.map(l => ({
  location_name: l.location_name,
  lat: Number(l.lat),
  lng: Number(l.lng),
  location_type: l.location_type,
  saint_name: l.saint_name,
  saint_slug: l.saint_slug,
}));
---

<Base title="Map — The Miracle Register">
  <link slot="head" rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-8 py-8 sm:py-10">
      <h1 style="font-family:var(--font-display);font-size:clamp(1.8rem,4vw,2.8rem);font-weight:300;color:var(--text-1);letter-spacing:-0.01em;margin-bottom:0.4rem">Map</h1>
      <p style="font-family:var(--font-sans);font-size:0.82rem;color:var(--text-4)">{miracleData.length} miracle locations · {locationData.length} saint locations</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-8 pb-14">
    <div class="map-wrapper">
      <div id="world-map"></div>

      <div class="map-panel" id="map-panel">
        <div class="panel-section">
          <label class="panel-parent">
            <input type="checkbox" id="toggle-saints" checked />
            <span class="panel-label">Saint Locations</span>
          </label>
          <div class="panel-children">
            <label class="panel-child"><input type="checkbox" class="saint-sub" data-type="tomb" checked /><span class="dot" style="background:#c9a84c"></span>Tomb</label>
            <label class="panel-child"><input type="checkbox" class="saint-sub" data-type="birthplace" checked /><span class="dot" style="background:#4a90d9"></span>Birthplace</label>
            <label class="panel-child"><input type="checkbox" class="saint-sub" data-type="shrine" checked /><span class="dot" style="background:#7c5cbf"></span>Shrine</label>
            <label class="panel-child"><input type="checkbox" class="saint-sub" data-type="death_place" checked /><span class="dot" style="background:#888"></span>Death place</label>
            <label class="panel-child"><input type="checkbox" class="saint-sub" data-type="relic" checked /><span class="dot" style="background:#c0392b"></span>Relic</label>
          </div>
        </div>

        <div class="panel-section">
          <label class="panel-parent">
            <input type="checkbox" id="toggle-miracles" checked />
            <span class="panel-label">Miracles</span>
          </label>
          <div class="panel-children">
            <label class="panel-child"><input type="checkbox" class="miracle-sub" data-cat="apparition" checked /><span class="dot" style="background:#c9a84c"></span>Apparitions</label>
            <label class="panel-child"><input type="checkbox" class="miracle-sub" data-cat="intercessory" checked /><span class="dot" style="background:#8b4513"></span>Intercessory</label>
            <label class="panel-child"><input type="checkbox" class="miracle-sub" data-cat="associated" checked /><span class="dot" style="background:#5ba8a0"></span>Associated</label>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline define:vars={{ miracleData, locationData }}>
    function escHtml(s) {
      return String(s ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
    }

    const typeColors = {
      tomb: "#c9a84c",
      birthplace: "#4a90d9",
      death_place: "#888888",
      shrine: "#7c5cbf",
      relic: "#c0392b",
      major_devotional_center: "#27ae60",
      other: "#5ba8a0",
    };

    const categoryColors = {
      apparition: "#c9a84c",
      intercessory: "#8b4513",
      associated: "#5ba8a0",
    };

    const map = L.map('world-map').setView([30, 10], 2);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      maxZoom: 19,
    }).addTo(map);

    // Saint markers grouped by location_type
    const saintMarkersByType = {};
    locationData.forEach(loc => {
      const color = typeColors[loc.location_type] || typeColors.other;
      const marker = L.circleMarker([loc.lat, loc.lng], {
        radius: 7,
        fillColor: color,
        color: "#fff",
        weight: 2,
        opacity: 1,
        fillOpacity: 0.9,
      });
      const typeLabel = loc.location_type.replace(/_/g, " ");
      marker.bindPopup(
        `<strong><a href="/saints/${escHtml(loc.saint_slug)}" style="color:inherit">${escHtml(loc.saint_name)}</a></strong><br>` +
        `<span style="font-size:0.75rem;color:#666">${escHtml(loc.location_name)} · ${escHtml(typeLabel)}</span>`
      );
      marker.addTo(map);
      if (!saintMarkersByType[loc.location_type]) saintMarkersByType[loc.location_type] = [];
      saintMarkersByType[loc.location_type].push(marker);
    });

    // Miracle markers grouped by category
    const miracleMarkersByCategory = {};
    miracleData.forEach(m => {
      const color = categoryColors[m.category] || "#8b4513";
      const isApparition = m.category === "apparition";
      const marker = L.circleMarker([m.lat, m.lng], {
        radius: isApparition ? 8 : 6,
        fillColor: color,
        color: "#fff",
        weight: 2,
        opacity: 1,
        fillOpacity: 0.85,
      });
      const typeLabel = m.type.replace(/_/g, " ");
      marker.bindPopup(
        `<strong><a href="/miracles/${escHtml(m.slug)}" style="color:inherit">${escHtml(m.title)}</a></strong><br>` +
        `<span style="font-size:0.75rem;color:#666">${escHtml(typeLabel)}${m.label ? " · " + escHtml(m.label) : ""}</span>`
      );
      marker.addTo(map);
      if (!miracleMarkersByCategory[m.category]) miracleMarkersByCategory[m.category] = [];
      miracleMarkersByCategory[m.category].push(marker);
    });

    function setVisible(markers, visible) {
      (markers || []).forEach(m => visible ? m.addTo(map) : m.removeFrom(map));
    }

    function updateParent(parentId, subSelector) {
      const subs = document.querySelectorAll(subSelector);
      const allChecked = [...subs].every(s => s.checked);
      const noneChecked = [...subs].every(s => !s.checked);
      const parent = document.getElementById(parentId);
      parent.checked = allChecked;
      parent.indeterminate = !allChecked && !noneChecked;
    }

    // Saint parent toggle
    document.getElementById('toggle-saints').addEventListener('change', function() {
      document.querySelectorAll('.saint-sub').forEach(cb => {
        cb.checked = this.checked;
        setVisible(saintMarkersByType[cb.dataset.type], this.checked);
      });
    });

    // Saint sub-toggles
    document.querySelectorAll('.saint-sub').forEach(cb => {
      cb.addEventListener('change', function() {
        setVisible(saintMarkersByType[this.dataset.type], this.checked);
        updateParent('toggle-saints', '.saint-sub');
      });
    });

    // Miracle parent toggle
    document.getElementById('toggle-miracles').addEventListener('change', function() {
      document.querySelectorAll('.miracle-sub').forEach(cb => {
        cb.checked = this.checked;
        setVisible(miracleMarkersByCategory[cb.dataset.cat], this.checked);
      });
    });

    // Miracle sub-toggles
    document.querySelectorAll('.miracle-sub').forEach(cb => {
      cb.addEventListener('change', function() {
        setVisible(miracleMarkersByCategory[this.dataset.cat], this.checked);
        updateParent('toggle-miracles', '.miracle-sub');
      });
    });
  </script>
</Base>

<style>
  .map-wrapper {
    position: relative;
  }

  #world-map {
    height: 72vh;
    min-height: 460px;
    width: 100%;
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
  }

  .map-panel {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 1000;
    background: var(--bg-base);
    border: 1px solid var(--rule);
    padding: 0.9rem 1rem;
    min-width: 155px;
    max-height: calc(72vh - 20px);
    overflow-y: auto;
    pointer-events: auto;
  }

  .panel-section {
    margin-bottom: 1rem;
  }

  .panel-section:last-child {
    margin-bottom: 0;
  }

  .panel-parent {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    user-select: none;
    margin-bottom: 0.45rem;
  }

  .panel-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .panel-parent input[type="checkbox"],
  .panel-child input[type="checkbox"] {
    width: 13px;
    height: 13px;
    accent-color: var(--color-accent);
    cursor: pointer;
    flex-shrink: 0;
  }

  .panel-children {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-left: 0.5rem;
  }

  .panel-child {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    user-select: none;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--text-3);
  }

  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
