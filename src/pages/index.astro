---
import Base from "../layouts/Base.astro";
import { createDb } from "../db";
import { saints, miracles } from "../db/schema";
import { sql, asc, eq, ne, and, or, isNotNull } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { easterOffsetForDate } from "../lib/feasts";
import { CACHE_DAILY } from "../lib/cache";
import { siteJsonLd } from "../lib/jsonld";
import { thumbUrl } from "../lib/image";

Astro.response.headers.set("Cache-Control", CACHE_DAILY);

const db = createDb(env.DATABASE_URL);

const now = new Date();
const todayMonth = now.getUTCMonth() + 1;
const todayDay = now.getUTCDate();
const todayYear = now.getUTCFullYear();
const easterOffset = easterOffsetForDate(todayYear, todayMonth, todayDay);

const [[{ saintCount }], [{ miracleCount }], [{ apparitionCount }], featuredSaints, feastSaints] = await Promise.all([
  db.select({ saintCount: sql<number>`count(*)::int` }).from(saints).where(eq(saints.published, true)),
  db.select({ miracleCount: sql<number>`count(*)::int` }).from(miracles).where(and(eq(miracles.published, true), ne(miracles.miracle_category, "apparition"))),
  db.select({ apparitionCount: sql<number>`count(*)::int` }).from(miracles).where(and(eq(miracles.published, true), eq(miracles.miracle_category, "apparition"))),
  db.select({
    slug: saints.slug,
    name: saints.name,
    image_url: saints.image_url,
    nationality: saints.nationality,
    canonization_stage: saints.canonization_stage,
    feast_day: saints.feast_day,
  }).from(saints).where(eq(saints.published, true)).orderBy(asc(saints.name)).limit(20),
  db.select({
    slug: saints.slug,
    name: saints.name,
    saint_name: saints.saint_name,
    image_url: saints.image_url,
    feast_day: saints.feast_day,
    canonization_stage: saints.canonization_stage,
  }).from(saints).where(
    and(
      eq(saints.published, true),
      or(
        and(
          eq(saints.feast_month, todayMonth),
          eq(saints.feast_day_of_month, todayDay)
        ),
        and(
          isNotNull(saints.feast_easter_offset),
          eq(saints.feast_easter_offset, easterOffset)
        )
      )
    )
  ).orderBy(asc(saints.name)),
]);
---

<Base title="Home" description="A structured database of Catholic miracles, Marian apparitions, and extraordinary phenomena — drawn from Vatican decrees, medical board verdicts, and primary sources." jsonLd={siteJsonLd()}>

  <!-- Hero -->
  <section class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-24 lg:py-32">
      <div class="max-w-3xl">
        <p class="eyebrow mb-7">Catholic Miracles & Apparitions</p>
        <h1 style="font-family:var(--font-display);font-size:clamp(3.2rem,7vw,5.5rem);font-weight:300;line-height:1.05;color:var(--text-1);margin-bottom:1.75rem;letter-spacing:-0.01em">
          The Miracle Register
        </h1>
        <p style="font-family:var(--font-sans);font-size:0.9rem;line-height:1.8;color:var(--text-3);max-width:46ch;margin-bottom:3rem">
          Canonization miracles, Marian apparitions, and extraordinary phenomena of the Catholic faith — documented from Vatican decrees, medical board verdicts, and primary sources.
        </p>
        <div class="flex items-center gap-8">
          <a href="/saints" class="btn-primary">Browse Saints</a>
          <a href="/miracles" class="btn-ghost">View Miracles</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <section class="stats-strip">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-10 flex flex-col sm:flex-row">
      <div class="stat-item">
        <span style="font-family:var(--font-display);font-size:3rem;font-weight:300;color:var(--text-1);display:block;line-height:1;letter-spacing:-0.02em">{saintCount}</span>
        <span style="font-family:var(--font-sans);font-size:0.65rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-4);margin-top:0.4rem;display:block">Saints Documented</span>
      </div>
      <div class="stat-item">
        <span style="font-family:var(--font-display);font-size:3rem;font-weight:300;color:var(--text-1);display:block;line-height:1;letter-spacing:-0.02em">{miracleCount}</span>
        <span style="font-family:var(--font-sans);font-size:0.65rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-4);margin-top:0.4rem;display:block">Miracles Recorded</span>
      </div>
      <div class="stat-item stat-item--last">
        <span style="font-family:var(--font-display);font-size:3rem;font-weight:300;color:var(--text-1);display:block;line-height:1;letter-spacing:-0.02em">{apparitionCount}</span>
        <span style="font-family:var(--font-sans);font-size:0.65rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-4);margin-top:0.4rem;display:block">Apparitions Documented</span>
      </div>
    </div>
  </section>

  <!-- Today's Feast -->
  {feastSaints.length > 0 && (
    <section class="feast-section">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
        <h2 class="eyebrow mb-8">Today's Feast</h2>
        <div class="feast-grid">
          {feastSaints.map(s => (
            <a href={`/saints/${s.slug}`} class="feast-card no-underline group">
              <div class="feast-img-wrap">
                {s.image_url ? (
                  <img src={thumbUrl(s.image_url, 330)!} alt={s.name} class="feast-img saint-img" />
                ) : (
                  <div class="saint-placeholder w-full h-full">{s.name.charAt(0)}</div>
                )}
              </div>
              <div class="feast-info">
                <p class="feast-name group-hover:text-[--color-accent]">{s.saint_name ?? s.name}</p>
                {s.feast_day && <p class="feast-day-str">{s.feast_day}</p>}
                <span class={`stage-badge ${s.canonization_stage}`}>{s.canonization_stage}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Featured saints carousel -->
  <section class="py-14 sm:py-20" style="overflow:hidden" aria-labelledby="featured-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex items-baseline justify-between mb-10">
        <h2 class="eyebrow" id="featured-heading">Featured Saints</h2>
        <div class="flex items-baseline gap-5">
          <button type="button" id="carousel-toggle" class="carousel-toggle" aria-controls="saints-track">Pause</button>
          <a href="/saints" style="font-family:var(--font-sans);font-size:0.7rem;font-weight:500;color:var(--color-accent);text-decoration:none;letter-spacing:0.05em">View all →</a>
        </div>
      </div>
    </div>
    <div class="carousel-viewport">
      <div class="carousel-track" id="saints-track">
        {featuredSaints.map((s) => (
          <a href={`/saints/${s.slug}`} class="saint-card-link carousel-card group no-underline">
            <div class="aspect-[3/4] overflow-hidden mb-4" style="background:var(--bg-elevated)">
              {s.image_url ? (
                <img
                  src={thumbUrl(s.image_url, 500)!}
                  alt={s.name}
                  decoding="async"
                  width="300"
                  height="400"
                  class="w-full h-full object-cover object-top saint-img"
                />
              ) : (
                <div class="saint-placeholder w-full h-full" />
              )}
            </div>
            <p style="font-family:var(--font-display);font-size:1.25rem;font-weight:400;color:var(--text-1);line-height:1.25;margin-bottom:0.35rem;transition:color 0.2s" class="group-hover:text-[--color-accent]">
              {s.name}
            </p>
            <div class="flex items-center gap-2">
              <span class={`stage-badge ${s.canonization_stage}`}>{s.canonization_stage}</span>
              {s.nationality && <span style="font-family:var(--font-sans);font-size:0.68rem;color:var(--text-4)">{s.nationality}</span>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- About section -->
  <section style="border-top:1px solid var(--rule);background:var(--bg-page)">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20 lg:grid lg:grid-cols-2 lg:gap-20">
      <div>
        <h2 class="eyebrow mb-6">About this Register</h2>
        <h2 style="font-family:var(--font-display);font-size:clamp(2rem,4vw,3rem);font-weight:300;line-height:1.2;color:var(--text-1)">
          Documented, sourced,<br/>and structured for research
        </h2>
      </div>
      <div style="font-family:var(--font-sans);font-size:0.875rem;line-height:1.85;color:var(--text-3)" class="pt-2">
        <p class="mb-5">
          Each entry includes the circumstances of the event, relevant medical
          documentation where applicable, the approving authority's formal verdict,
          and a narrative synopsis drawn from primary sources.
        </p>
        <p>
          The register covers <em style="font-family:var(--font-serif);font-style:italic;color:var(--text-2)">intercessory miracles</em> formally investigated
          as part of the beatification and canonization process, Vatican-recognised
          Marian apparitions, nature miracles, and selected associated miracles for
          cases of historical significance.
        </p>
      </div>
    </div>
  </section>

</Base>

<style is:global>
  .btn-primary {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--text-1);
    color: var(--bg-page);
    padding: 0.85rem 2rem;
    text-decoration: none;
    transition: opacity 0.2s;
    display: inline-block;
  }
  .btn-primary:hover { opacity: 0.75; color: var(--bg-page); }

  .btn-ghost {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-mid);
    padding-bottom: 2px;
    transition: color 0.2s;
  }
  .btn-ghost:hover { color: var(--text-1); }

  .stats-strip {
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--rule-soft);
  }

  .stat-item {
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule-mid);
  }
  .stat-item--last {
    border-bottom: none;
  }
  @media (min-width: 640px) {
    .stat-item {
      padding: 0 3rem 0 0;
      margin-right: 3rem;
      border-bottom: none;
      border-right: 1px solid var(--rule-mid);
    }
    .stat-item--last {
      padding-right: 0;
      margin-right: 0;
      border-right: none;
    }
  }

  .feast-section {
    border-top: 1px solid var(--rule-soft);
    background: var(--bg-subtle);
  }

  .feast-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
  }

  .feast-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    text-decoration: none;
  }

  .feast-img-wrap {
    width: 72px;
    height: 96px;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--bg-elevated);
  }

  .feast-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .feast-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .feast-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--text-1);
    line-height: 1.2;
    transition: color 0.2s;
  }

  .feast-day-str {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    color: var(--text-4);
  }

  .saint-img { transition: transform 0.7s ease; }
  .saint-card-link:hover .saint-img { transform: scale(1.04); }

  .carousel-viewport {
    padding-left: calc((100vw - min(100vw - 2rem, 72rem)) / 2 + 1rem);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .carousel-viewport {
      padding-left: calc((100vw - min(100vw - 4rem, 72rem)) / 2 + 2rem);
    }
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    will-change: transform;
  }

  .carousel-toggle {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-3);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .carousel-toggle:hover { color: var(--text-1); }

  .carousel-card {
    flex: 0 0 calc(25% - 1.125rem);
    min-width: 200px;
  }

  @media (max-width: 768px) {
    .carousel-card { flex: 0 0 calc(50% - 0.75rem); }
  }
</style>

<script>
  const track = document.getElementById('saints-track') as HTMLElement;
  const viewport = track?.parentElement as HTMLElement | null;
  const toggle = document.getElementById('carousel-toggle') as HTMLButtonElement | null;
  if (track && viewport) {
    const originals = Array.from(track.children) as HTMLElement[];
    const count = originals.length;

    // Prepend AND append clones so there is always content on both sides.
    // Clones are visual only: hidden from assistive tech and out of the tab order.
    // Track layout: [pre-clones 0..N-1] [originals 0..N-1] [post-clones 0..N-1]
    function makeClone(card: HTMLElement): HTMLElement {
      const clone = card.cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('tabindex', '-1');
      return clone;
    }
    originals.forEach(card => track.appendChild(makeClone(card)));
    originals.slice().reverse().forEach(card => track.insertBefore(makeClone(card), track.firstChild));

    // Start at position N so originals are visible
    let current = count;
    track.style.transition = 'none';
    track.style.transform = `translateX(-${current * (originals[0].offsetWidth + 24)}px)`;

    // Autoplay stops for any of: the user pressing Pause, hover, or keyboard focus inside.
    // Reduced motion starts paused; the user can still press Play.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let userPaused = reduceMotion;
    let hovering = false;
    let hasFocus = false;

    function syncToggle() {
      if (toggle) toggle.textContent = userPaused ? 'Play' : 'Pause';
    }
    syncToggle();
    toggle?.addEventListener('click', () => { userPaused = !userPaused; syncToggle(); });

    function getCardWidth(): number {
      return originals[0].offsetWidth + 24;
    }

    function advance() {
      if (userPaused || hovering || hasFocus) return;
      current++;
      track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      track.style.transform = `translateX(-${current * getCardWidth()}px)`;

      // When we've consumed all post-clones, jump back to the originals silently
      if (current >= count * 2) {
        setTimeout(() => {
          track.style.transition = 'none';
          void track.offsetHeight;
          current = count;
          track.style.transform = `translateX(-${current * getCardWidth()}px)`;
        }, 650);
      }
    }

    track.addEventListener('mouseenter', () => { hovering = true; });
    track.addEventListener('mouseleave', () => { hovering = false; });

    // Keyboard focus: stop autoplay and slide the focused card into view
    track.addEventListener('focusin', (e) => {
      hasFocus = true;
      const card = (e.target as HTMLElement).closest('.carousel-card') as HTMLElement | null;
      const idx = card ? Array.from(track.children).indexOf(card) : -1;
      if (idx >= 0) {
        current = idx;
        track.style.transition = 'transform 0.3s ease';
        track.style.transform = `translateX(-${current * getCardWidth()}px)`;
      }
      viewport.scrollLeft = 0;
    });
    track.addEventListener('focusout', (e) => {
      if (!track.contains((e as FocusEvent).relatedTarget as Node | null)) hasFocus = false;
    });
    // The browser may scroll the overflow:hidden viewport to reveal a focused link; the transform handles position instead
    viewport.addEventListener('scroll', () => { viewport.scrollLeft = 0; });

    setInterval(advance, 3000);
  }
</script>
