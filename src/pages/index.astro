---
import Base from "../layouts/Base.astro";
import { createDb } from "../db";
import { saints, miracles } from "../db/schema";
import { sql, asc } from "drizzle-orm";
import { env } from "cloudflare:workers";

const db = createDb(env.DATABASE_URL);
const [[{ saintCount }], [{ miracleCount }], featuredSaints] = await Promise.all([
  db.select({ saintCount: sql<number>`count(*)::int` }).from(saints),
  db.select({ miracleCount: sql<number>`count(*)::int` }).from(miracles),
  db.select({
    slug: saints.slug,
    name: saints.name,
    image_url: saints.image_url,
    nationality: saints.nationality,
    canonization_stage: saints.canonization_stage,
    feast_day: saints.feast_day,
  }).from(saints).orderBy(asc(saints.name)).limit(4),
]);
---

<Base title="Home" description="A structured database of Vatican-recognised miracles attributed to Catholic saints.">

  <!-- Hero -->
  <section class="page-header">
    <div class="max-w-6xl mx-auto px-8 py-24 lg:py-32">
      <div class="max-w-3xl">
        <p class="eyebrow mb-7">Canonization Records</p>
        <h1 style="font-family:var(--font-display);font-size:clamp(3.2rem,7vw,5.5rem);font-weight:300;line-height:1.05;color:var(--text-1);margin-bottom:1.75rem;letter-spacing:-0.01em">
          The Register of<br/>Documented Miracles
        </h1>
        <p style="font-family:var(--font-sans);font-size:0.9rem;line-height:1.8;color:var(--text-3);max-width:46ch;margin-bottom:3rem">
          Structured records of Vatican-recognised miracles — drawn from canonization
          decrees, medical board verdicts, and primary source documentation.
        </p>
        <div class="flex items-center gap-8">
          <a href="/saints" class="btn-primary">Browse Saints</a>
          <a href="/miracles" class="btn-ghost">View Miracles</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <section class="stats-strip">
    <div class="max-w-6xl mx-auto px-8 py-10 flex flex-wrap gap-0">
      <div class="stats-item" style="border-right:1px solid var(--rule-mid);padding-right:3rem;margin-right:3rem">
        <span style="font-family:var(--font-display);font-size:3rem;font-weight:300;color:var(--text-1);display:block;line-height:1;letter-spacing:-0.02em">{saintCount}</span>
        <span style="font-family:var(--font-sans);font-size:0.65rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-4);margin-top:0.4rem;display:block">Saints Documented</span>
      </div>
      <div class="stats-item" style="border-right:1px solid var(--rule-mid);padding-right:3rem;margin-right:3rem">
        <span style="font-family:var(--font-display);font-size:3rem;font-weight:300;color:var(--text-1);display:block;line-height:1;letter-spacing:-0.02em">{miracleCount}</span>
        <span style="font-family:var(--font-sans);font-size:0.65rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-4);margin-top:0.4rem;display:block">Miracles Recorded</span>
      </div>
      <div class="stats-item">
        <span style="font-family:var(--font-display);font-size:3rem;font-weight:300;color:var(--text-1);display:block;line-height:1;letter-spacing:-0.02em">Vatican</span>
        <span style="font-family:var(--font-sans);font-size:0.65rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-4);margin-top:0.4rem;display:block">Primary Sources</span>
      </div>
    </div>
  </section>

  <!-- Featured saints -->
  <section class="max-w-6xl mx-auto px-8 py-20">
    <div class="flex items-baseline justify-between mb-10">
      <p class="eyebrow">Featured Saints</p>
      <a href="/saints" style="font-family:var(--font-sans);font-size:0.7rem;font-weight:500;color:var(--color-accent);text-decoration:none;letter-spacing:0.05em">View all →</a>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
      {featuredSaints.map((s) => (
        <a href={`/saints/${s.slug}`} class="saint-card-link group no-underline">
          <div class="aspect-[3/4] overflow-hidden mb-4" style="background:var(--bg-elevated)">
            {s.image_url ? (
              <img
                src={s.image_url}
                alt={s.name}
                class="w-full h-full object-cover object-top saint-img"
              />
            ) : (
              <div class="saint-placeholder w-full h-full" />
            )}
          </div>
          <p style="font-family:var(--font-display);font-size:1.25rem;font-weight:400;color:var(--text-1);line-height:1.25;margin-bottom:0.35rem;transition:color 0.2s" class="group-hover:text-[--color-accent]">
            {s.name}
          </p>
          <div class="flex items-center gap-2">
            <span class={`stage-badge ${s.canonization_stage}`}>{s.canonization_stage}</span>
            {s.nationality && <span style="font-family:var(--font-sans);font-size:0.68rem;color:var(--text-4)">{s.nationality}</span>}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- About section -->
  <section style="border-top:1px solid var(--rule);background:var(--bg-page)">
    <div class="max-w-6xl mx-auto px-8 py-20 lg:grid lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow mb-6">About this Register</p>
        <h2 style="font-family:var(--font-display);font-size:clamp(2rem,4vw,3rem);font-weight:300;line-height:1.2;color:var(--text-1)">
          Documented, sourced,<br/>and structured for research
        </h2>
      </div>
      <div style="font-family:var(--font-sans);font-size:0.875rem;line-height:1.85;color:var(--text-3)" class="pt-2">
        <p class="mb-5">
          Each entry covers the medical diagnosis, the circumstances of the cure,
          the Vatican medical board's formal verdict, and the pontifical decree of
          recognition — alongside a narrative synopsis drawn from primary sources.
        </p>
        <p>
          The register focuses on <em style="font-family:var(--font-serif);font-style:italic;color:var(--text-2)">intercessory miracles</em> — posthumous healings
          formally investigated as part of the beatification and canonization process —
          and selected associated miracles for cases of historical significance.
        </p>
      </div>
    </div>
  </section>

</Base>

<style is:global>
  .btn-primary {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--text-1);
    color: var(--bg-page);
    padding: 0.85rem 2rem;
    text-decoration: none;
    transition: opacity 0.2s;
    display: inline-block;
  }
  .btn-primary:hover { opacity: 0.75; color: var(--bg-page); }

  .btn-ghost {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-mid);
    padding-bottom: 2px;
    transition: color 0.2s;
  }
  .btn-ghost:hover { color: var(--text-1); }

  .stats-strip {
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--rule-soft);
  }

  .saint-img { transition: transform 0.7s ease; }
  .saint-card-link:hover .saint-img { transform: scale(1.04); }
</style>
