---
import Base from "../../layouts/Base.astro";
import { createDb } from "../../db";
import { miracles } from "../../db/schema";
import { MIRACLE_TOPICS } from "../../db/topics";
import { and, sql } from "drizzle-orm";
import { env } from "cloudflare:workers";
import { CACHE_CONTENT } from "../../lib/cache";
import { isIndexable } from "../../lib/browse";
import { fetchSaintsByMiracle, miracleFilterConditions } from "../../lib/queries/miracles";
import { humanizeSlug, humanizeSnakeCase, approvalBadge } from "../../lib/format";
import { collectionJsonLd, breadcrumbJsonLd } from "../../lib/jsonld";

const { topic } = Astro.params;
if (!topic || !(MIRACLE_TOPICS as readonly string[]).includes(topic)) return Astro.redirect("/404");

Astro.response.headers.set("Cache-Control", CACHE_CONTENT);

const db = createDb(env.DATABASE_URL);

// Same visibility rule as the /miracles list: published records only.
const topicMiracles = await db
  .select({
    id: miracles.id,
    slug: miracles.slug,
    title: miracles.title,
    type: miracles.type,
    topics: miracles.topics,
    date_of_event: miracles.date_of_event,
    country: miracles.country,
    cure_details: miracles.cure_details,
    approval_authority: miracles.approval_authority,
  })
  .from(miracles)
  .where(and(...miracleFilterConditions(db, { topic })))
  .orderBy(sql`${miracles.date_of_event} asc nulls last`);

const saintsByMiracle = await fetchSaintsByMiracle(db, topicMiracles.map((m) => m.id));
const saintNamesByMiracle = new Map<number, string[]>(
  [...saintsByMiracle].map(([id, list]) => [id, list.map((s) => s.name)])
);

const label = humanizeSlug(topic);
const total = topicMiracles.length;
const path = `/topics/${topic}`;
const description = `${total} documented ${total === 1 ? "miracle" : "miracles"} attributed to saints involving ${label.toLowerCase()}, with sources.`;
const jsonLd = [
  collectionJsonLd({ name: `Miracles: ${label}`, description, path }),
  breadcrumbJsonLd([
    { name: "Home", path: "/" },
    { name: "Topics", path: "/topics" },
    { name: label, path },
  ]),
];
---

<Base title={`${label} Miracles`} description={description} jsonLd={jsonLd} noindex={!isIndexable(total)}>

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
      <p class="eyebrow mb-4"><a href="/topics" style="color:inherit;text-decoration:none">Topics</a></p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,5vw,4rem);font-weight:300;color:var(--text-1);line-height:1.05;letter-spacing:-0.01em">{label}</h1>
      <p style="font-family:var(--font-sans);font-size:0.8rem;color:var(--text-4);margin-top:0.6rem;letter-spacing:0.02em">{total} {total === 1 ? "miracle" : "miracles"} recorded</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <div class="space-y-2">
      {total === 0 ? (
        <p class="empty-state">No published miracles for this topic yet.</p>
      ) : topicMiracles.map((m) => (
        <a href={`/miracles/${m.slug}`} class="block no-underline group">
          <div class="card px-6 py-5">
            <div class="flex items-start justify-between gap-6">
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2">
                  <span style="font-family:var(--font-sans);font-size:0.68rem;font-weight:600;color:var(--color-accent)">{(saintNamesByMiracle.get(m.id) ?? []).join(", ")}</span>
                  <span style="color:var(--rule-mid)">·</span>
                  <span style="font-family:var(--font-sans);font-size:0.68rem;color:var(--text-4)">{humanizeSnakeCase(m.type)}</span>
                  {m.date_of_event && <><span style="color:var(--rule-mid)">·</span><span style="font-family:var(--font-sans);font-size:0.68rem;color:var(--text-4)">{m.date_of_event}</span></>}
                  {m.country && <><span style="color:var(--rule-mid)">·</span><span style="font-family:var(--font-sans);font-size:0.68rem;color:var(--text-4)">{m.country}</span></>}
                </div>
                <h2 style="font-family:var(--font-display);font-size:1.25rem;font-weight:400;color:var(--text-1);line-height:1.3;margin-bottom:0.5rem;transition:color 0.2s" class="group-hover:text-[--color-accent]">{m.title}</h2>
                {m.cure_details && (
                  <p style="font-family:var(--font-sans);font-size:0.78rem;color:var(--text-3);line-height:1.65">
                    {m.cure_details.length > 140 ? m.cure_details.slice(0, 140) + "…" : m.cure_details}
                  </p>
                )}
              </div>
              <div class="shrink-0 flex flex-col gap-1 items-end">
                {(() => { const b = approvalBadge(m.approval_authority); return b ? <span class={`approval-badge ${b.cls}`}>{b.label}</span> : null; })()}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>

</Base>
