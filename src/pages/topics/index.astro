---
import Base from "../../layouts/Base.astro";
import { createDb } from "../../db";
import { env } from "cloudflare:workers";
import { CACHE_CONTENT } from "../../lib/cache";
import { getTopicCounts } from "../../lib/browse";
import { humanizeSlug } from "../../lib/format";
import { collectionJsonLd, breadcrumbJsonLd } from "../../lib/jsonld";

Astro.response.headers.set("Cache-Control", CACHE_CONTENT);

const db = createDb(env.DATABASE_URL);
// Empty topics have no page worth visiting, so they are not listed.
const topics = (await getTopicCounts(db)).filter((t) => t.count > 0);

const description = "Browse documented miracles attributed to saints by the people and circumstances involved: children, mothers, veterans, religious life and more.";
const jsonLd = [
  collectionJsonLd({ name: "Miracles by topic", description, path: "/topics" }),
  breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Topics", path: "/topics" }]),
];
---

<Base title="Miracles by Topic" description={description} jsonLd={jsonLd}>

  <div class="page-header">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
      <p class="eyebrow mb-4">Browse</p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2.5rem,5vw,4rem);font-weight:300;color:var(--text-1);line-height:1.05;letter-spacing:-0.01em">Miracles by Topic</h1>
      <p style="font-family:var(--font-sans);font-size:0.8rem;color:var(--text-4);margin-top:0.6rem;letter-spacing:0.02em">{description}</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {topics.map((t) => (
        <a href={`/topics/${t.value}`} class="block no-underline group">
          <div class="card px-6 py-5">
            <h2 style="font-family:var(--font-display);font-size:1.25rem;font-weight:400;color:var(--text-1);line-height:1.3;margin-bottom:0.35rem" class="group-hover:text-[--color-accent]">{humanizeSlug(t.value)}</h2>
            <p style="font-family:var(--font-sans);font-size:0.75rem;color:var(--text-4)">{t.count} {t.count === 1 ? "miracle" : "miracles"}</p>
          </div>
        </a>
      ))}
    </div>
  </div>

</Base>
